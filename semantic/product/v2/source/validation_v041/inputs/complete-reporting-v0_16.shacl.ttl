<urn:product-ontology:assessment-profile:0.4:shape:VersionContext> <http://www.w3.org/ns/shacl#message> "Claimed version and context version must agree when both are recorded." .
<urn:product-ontology:assessment-profile:0.4:shape:VersionContext> <http://www.w3.org/ns/shacl#select> "PREFIX prod: <urn:productium:specification-profile:>\nPREFIX assess: <urn:product-ontology:assessment-profile:0.4:>\nSELECT $this WHERE {\n $this assess:claimVersion ?v ; assess:claimContext/assess:contextVersion ?ctxVersion . FILTER(?v != ?ctxVersion)\n}" .
