<urn:product-ontology:relation-shapes:0.7:version_acyclic> <http://www.w3.org/ns/shacl#message> "Recorded version succession must be acyclic." .
<urn:product-ontology:relation-shapes:0.7:version_acyclic> <http://www.w3.org/ns/shacl#select> "PREFIX p: <urn:productium:specification-profile:> SELECT $this WHERE { $this p:r8_supersedes+ $this . }" .
<urn:product-ontology:relation-shapes:0.7:version_same_product> <http://www.w3.org/ns/shacl#message> "Successor and predecessor must belong to the same recorded product lineage." .
<urn:product-ontology:relation-shapes:0.7:version_same_product> <http://www.w3.org/ns/shacl#select> "PREFIX p: <urn:productium:specification-profile:> SELECT $this WHERE { $this p:r8_supersedes ?older . FILTER NOT EXISTS { ?product a p:Product ; p:hasVersion $this, ?older . } }" .
