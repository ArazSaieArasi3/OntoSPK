<urn:product-ontology:delivery-profile:0.5:shape:authority_changed> <http://www.w3.org/ns/shacl#message> "A changed-identifier finding needs an explicit different observed identifier. It does not overwrite the original binding." .
<urn:product-ontology:delivery-profile:0.5:shape:authority_changed> <http://www.w3.org/ns/shacl#select> "PREFIX p: <urn:productium:specification-profile:>\nPREFIX a: <urn:product-ontology:assessment-profile:0.4:>\nPREFIX e: <urn:product-ontology:delivery-profile:0.5:>\nSELECT $this WHERE { $this e:reviewReason \"authority_changed\" . ?ref e:referenceReviewFinding $this ; p:canonicalOwner ?old . FILTER NOT EXISTS {$this e:observedAuthority ?new . FILTER(STR(?new) != STR(?old))} }" .
