<urn:product-ontology:trace-profile:0.6:shape:OrderCycle> <http://www.w3.org/ns/shacl#select> "PREFIX p: <urn:productium:specification-profile:>\nPREFIX a: <urn:product-ontology:assessment-profile:0.4:>\nPREFIX e: <urn:product-ontology:trace-profile:0.6:>\nSELECT $this WHERE {$this e:stepPrecedes+ $this}" .
<urn:product-ontology:trace-profile:0.6:shape:OrderFlow> <http://www.w3.org/ns/shacl#message> "Ordered steps must have the same owning flow." .
<urn:product-ontology:trace-profile:0.6:shape:OrderFlow> <http://www.w3.org/ns/shacl#select> "PREFIX p: <urn:productium:specification-profile:>\nPREFIX a: <urn:product-ontology:assessment-profile:0.4:>\nPREFIX e: <urn:product-ontology:trace-profile:0.6:>\nSELECT $this WHERE {$this e:stepPrecedes ?later . FILTER NOT EXISTS {?flow p:r56_specifiesStep $this,?later}}" .
<urn:product-ontology:trace-profile:0.6:shape:ProposalRecordedSubject> <http://www.w3.org/ns/shacl#message> "A proposal-to-change link must preserve the explicitly recorded subject. It does not establish approval or application." .
<urn:product-ontology:trace-profile:0.6:shape:ProposalRecordedSubject> <http://www.w3.org/ns/shacl#select> "PREFIX p: <urn:productium:specification-profile:>\nPREFIX a: <urn:product-ontology:assessment-profile:0.4:>\nPREFIX e: <urn:product-ontology:trace-profile:0.6:>\nSELECT $this WHERE {\n $this p:r79_proposesRecordedChange ?change .\n { $this e:proposalScope ?subject . FILTER NOT EXISTS {?change e:changeScope ?subject} }\n UNION { $this e:proposalFeature ?subject . FILTER NOT EXISTS {?change e:changeFeature ?subject} }\n}" .
<urn:product-ontology:trace-profile:0.6:shape:SelectedConsidered> <http://www.w3.org/ns/shacl#message> "Explicitly report every selected alternative as considered." .
<urn:product-ontology:trace-profile:0.6:shape:SelectedConsidered> <http://www.w3.org/ns/shacl#select> "PREFIX p: <urn:productium:specification-profile:>\nPREFIX a: <urn:product-ontology:assessment-profile:0.4:>\nPREFIX e: <urn:product-ontology:trace-profile:0.6:>\nSELECT $this WHERE {$this e:decisionSelectsSolution ?s . FILTER NOT EXISTS {$this e:decisionConsidersSolution ?s}}" .
<urn:product-ontology:trace-profile:0.6:shape:SelectionCriterion> <http://www.w3.org/ns/shacl#message> "A recorded selection requires at least one recorded appraisal criterion." .
<urn:product-ontology:trace-profile:0.6:shape:SelectionCriterion> <http://www.w3.org/ns/shacl#select> "PREFIX p: <urn:productium:specification-profile:>\nPREFIX a: <urn:product-ontology:assessment-profile:0.4:>\nPREFIX e: <urn:product-ontology:trace-profile:0.6:>\nSELECT $this WHERE {$this e:decisionSelectsSolution ?s . FILTER NOT EXISTS {$this p:recordsCriterion ?c}}" .
<urn:product-ontology:trace-profile:0.6:shape:UsabilityConstitutiveAnchor> <http://www.w3.org/ns/shacl#message> "Retain an explicit flow or screen subject; additional experience subjects do not change the existing kind definition." .
<urn:product-ontology:trace-profile:0.6:shape:UsabilityConstitutiveAnchor> <http://www.w3.org/ns/shacl#select> "PREFIX p: <urn:productium:specification-profile:>\nPREFIX a: <urn:product-ontology:assessment-profile:0.4:>\nPREFIX e: <urn:product-ontology:trace-profile:0.6:>\nSELECT $this WHERE {FILTER NOT EXISTS {$this p:r60_reportsOnFlow|p:r61_reportsOnScreen ?anchor}}" .
