<urn:product-ontology:relation-shapes:0.7:suite_case_trace> <http://www.w3.org/ns/shacl#message> "An indexed execution must execute a case explicitly included in the suite." .
<urn:product-ontology:relation-shapes:0.7:suite_case_trace> <http://www.w3.org/ns/shacl#select> "PREFIX p: <urn:productium:specification-profile:> SELECT $this WHERE { $this p:r147_hasRecordedExecution ?run . FILTER NOT EXISTS { $this p:containsCase ?case . ?run p:executes ?case . } }" .
