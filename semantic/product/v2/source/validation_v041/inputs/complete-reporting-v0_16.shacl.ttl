<urn:product-ontology:assessment-profile:0.4:shape:ScopeContent> <http://www.w3.org/ns/shacl#message> "A recorded scope needs at least one included, excluded or deferred statement; missing values are not empty sets." .
<urn:product-ontology:assessment-profile:0.4:shape:ScopeContent> <http://www.w3.org/ns/shacl#select> "PREFIX prod: <urn:productium:specification-profile:>\nPREFIX assess: <urn:product-ontology:assessment-profile:0.4:>\nSELECT $this WHERE {\n FILTER NOT EXISTS { $this assess:includedStatement|assess:excludedStatement|assess:deferredStatement ?content }\n}" .
<urn:product-ontology:assessment-profile:0.4:shape:ScopeCycle> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/ns/shacl#SPARQLConstraint> .
<urn:product-ontology:assessment-profile:0.4:shape:ScopeCycle> <http://www.w3.org/ns/shacl#message> "Scope revision must be acyclic, including no self-revision." .
<urn:product-ontology:assessment-profile:0.4:shape:ScopeCycle> <http://www.w3.org/ns/shacl#select> "PREFIX prod: <urn:productium:specification-profile:>\nPREFIX assess: <urn:product-ontology:assessment-profile:0.4:>\nSELECT $this WHERE { $this assess:scopeSupersedes+ $this }" .
