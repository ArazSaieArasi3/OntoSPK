<urn:product-ontology:assessment-profile:0.4:shape:CapabilityBinding> <http://www.w3.org/ns/shacl#message> "Capability claim needs paired capability bindings, the actual bearer and a matching version/specification context. This constraint does not assert satisfaction." .
<urn:product-ontology:assessment-profile:0.4:shape:CapabilityBinding> <http://www.w3.org/ns/shacl#select> "PREFIX prod: <urn:productium:specification-profile:>\nPREFIX assess: <urn:product-ontology:assessment-profile:0.4:>\nSELECT DISTINCT $this WHERE {\n { $this assess:claimActualCapability ?mentioned } UNION { $this assess:claimIntendedCapability ?mentioned }\n FILTER NOT EXISTS {\n   $this assess:claimRealization ?realization ; assess:claimActualCapability ?actual ; assess:claimIntendedCapability ?intended ; assess:claimContext ?context .\n   ?context assess:contextVersion ?version .\n   ?realization prod:bearsCapability ?actual ; prod:realizesVersion ?version .\n   ?version prod:specifiesCapability ?intended .\n   ?actual prod:evaluatedAgainst ?intended .\n }\n}" .
