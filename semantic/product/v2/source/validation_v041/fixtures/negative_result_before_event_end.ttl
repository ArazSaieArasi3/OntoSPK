@prefix ns1: <urn:product-ontology:delivery-profile:0.5:> .
@prefix ns2: <urn:productium:specification-profile:> .
@prefix ns3: <urn:product-ontology:assessment-profile:0.4:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:product-ontology:event-instance:product1> a ns2:Product ;
    ns2:hasVersion <urn:product-ontology:event-instance:v1> .

<urn:product-ontology:event-instance:result1> a ns2:TestResult ;
    ns1:resultOutcome "inconclusive" ;
    ns1:resultRecordedAt "2026-10-14T04:29:00Z"^^xsd:dateTime ;
    ns1:resultSource "urn:synthetic:v035:result-source"^^xsd:anyURI ;
    ns2:recordsExecution <urn:product-ontology:event-instance:e1> .

<urn:product-ontology:event-instance:suite1> a ns2:TestSuiteSpecification ;
    ns2:containsCase <urn:product-ontology:event-instance:case1> ;
    ns2:r147_hasRecordedExecution <urn:product-ontology:event-instance:e1> .

<urn:product-ontology:event-instance:actual1> a ns2:ProductCapability ;
    ns2:evaluatedAgainst <urn:product-ontology:event-instance:cap1> .

<urn:product-ontology:event-instance:ctx1> a ns3:AssessmentContextSpecification ;
    ns3:contextDescription "Synthetic completed-event and identity integration context" ;
    ns3:contextSource "urn:synthetic:v035:context-source"^^xsd:anyURI ;
    ns3:contextVersion <urn:product-ontology:event-instance:v1> .

<urn:product-ontology:event-instance:feature1> a ns2:FeatureSpecification .

<urn:product-ontology:event-instance:real1> a ns2:ProductRealization ;
    ns2:bearsCapability <urn:product-ontology:event-instance:actual1> ;
    ns2:realizesVersion <urn:product-ontology:event-instance:v1> .

<urn:product-ontology:event-instance:scenario1> a ns2:TestScenario ;
    ns2:r84_covers <urn:product-ontology:event-instance:feature1> ;
    ns2:specifiesExpectedCondition <urn:product-ontology:event-instance:condition1> .

<urn:product-ontology:event-instance:case1> a ns2:TestCase ;
    ns2:r87_refinesTestScenario <urn:product-ontology:event-instance:scenario1> ;
    ns2:specifiesExpectedCondition <urn:product-ontology:event-instance:condition1> .

<urn:product-ontology:event-instance:e1> a ns2:TestExecution ;
    ns1:executionContext <urn:product-ontology:event-instance:ctx1> ;
    ns1:executionCriterion <urn:product-ontology:event-instance:condition1> ;
    ns1:executionEndedAt "2026-10-14T04:30:00Z"^^xsd:dateTime ;
    ns2:assessesSpecification <urn:product-ontology:event-instance:cap1> ;
    ns2:executes <urn:product-ontology:event-instance:case1> ;
    ns2:testsRealization <urn:product-ontology:event-instance:real1> .

<urn:product-ontology:event-instance:cap1> a ns2:CapabilitySpecification .

<urn:product-ontology:event-instance:condition1> a ns2:ConditionSpecification .

<urn:product-ontology:event-instance:v1> a ns2:ProductVersion ;
    ns2:specifiesCapability <urn:product-ontology:event-instance:cap1> .

