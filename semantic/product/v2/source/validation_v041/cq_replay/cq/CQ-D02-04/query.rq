PREFIX p: <urn:productium:specification-profile:>
PREFIX a: <urn:product-ontology:assessment-profile:0.4:>
PREFIX d: <urn:product-ontology:delivery-profile:0.5:>
PREFIX e: <urn:product-ontology:trace-profile:0.6:>
PREFIX t: <urn:orsd:v06:synthetic:>
SELECT DISTINCT ?decision ?selected ?criterion ?evidence ?claim ?carrier ?stance WHERE { 
 ?decision a p:DecisionRecord ; e:decisionSelectsSolution ?selected . OPTIONAL {?decision p:recordsCriterion ?criterion}
 OPTIONAL {?decision e:decisionEvidence ?evidence . ?evidence p:recordsClaim ?claim ; p:recordsCarrier ?carrier ; a:attributionStance ?stance}
  }
