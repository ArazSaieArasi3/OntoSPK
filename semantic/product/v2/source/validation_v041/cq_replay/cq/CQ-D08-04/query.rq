PREFIX p: <urn:productium:specification-profile:>
PREFIX e: <urn:orsd:v03:synthetic:>
SELECT DISTINCT ?case ?reference ?target ?origin WHERE {
VALUES ?case { e:caseA } ?case p:r89_referencesTestData ?reference . ?reference p:referenceTarget ?target . OPTIONAL { ?reference p:referenceProvenance ?origin }
}
