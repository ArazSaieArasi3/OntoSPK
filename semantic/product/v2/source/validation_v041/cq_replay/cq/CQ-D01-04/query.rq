PREFIX p: <urn:productium:specification-profile:>
PREFIX a: <urn:product-ontology:assessment-profile:0.4:>
PREFIX d: <urn:product-ontology:delivery-profile:0.5:>
PREFIX e: <urn:product-ontology:trace-profile:0.6:>
PREFIX t: <urn:orsd:v06:synthetic:>
SELECT DISTINCT ?product ?dependency ?targetKind ?target ?externalIdentifier WHERE { 
 ?product p:hasDependencySpecification ?dependency . ?dependency a p:DependencySpecification .
 VALUES (?link ?targetKind) {(e:dependencyProductTarget "product") (e:dependencyActualCapabilityTarget "actual_capability") (e:dependencyCapabilitySpecificationTarget "intended_capability") (e:dependencyExternalTarget "external_reference")}
 ?dependency ?link ?target . OPTIONAL {?target p:referenceTarget ?externalIdentifier}
  }
