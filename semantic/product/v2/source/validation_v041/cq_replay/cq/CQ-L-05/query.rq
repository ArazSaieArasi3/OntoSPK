PREFIX p: <urn:productium:specification-profile:>
PREFIX a: <urn:product-ontology:assessment-profile:0.4:>
PREFIX e: <urn:product-ontology:delivery-profile:0.5:>
PREFIX t: <urn:orsd:v05:synthetic:>
SELECT DISTINCT ?reference ?target ?authority ?finding ?reason ?observedTarget ?observedAuthority WHERE { 
 ?reference p:referenceTarget ?target ; p:canonicalOwner ?authority ; e:referenceReviewFinding ?finding . ?finding e:reviewReason ?reason . OPTIONAL {?finding e:observedTarget ?observedTarget} OPTIONAL {?finding e:observedAuthority ?observedAuthority}
  }
