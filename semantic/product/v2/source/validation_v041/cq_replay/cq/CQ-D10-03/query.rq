PREFIX prod: <urn:productium:specification-profile:>
PREFIX assess: <urn:product-ontology:assessment-profile:0.4:>
PREFIX t: <urn:orsd:v04:synthetic:>
SELECT DISTINCT ?claim ?finding ?statement ?record ?stance WHERE { ?record prod:recordsClaim ?claim ; prod:recordsCarrier ?finding ; assess:attributionStance ?stance . ?finding assess:findingStatement ?statement . FILTER(?stance IN ("challenges", "limits")) }
