PREFIX p: <urn:productium:specification-profile:>
PREFIX a: <urn:product-ontology:assessment-profile:0.4:>
PREFIX d: <urn:product-ontology:delivery-profile:0.5:>
PREFIX e: <urn:product-ontology:trace-profile:0.6:>
PREFIX t: <urn:orsd:v06:synthetic:>
SELECT DISTINCT ?flow ?step ?later ?orderState WHERE { 
 ?flow a p:UserFlowSpecification ; p:r56_specifiesStep ?step . ?step a p:InteractionStepSpecification .
 OPTIONAL {?step e:stepPrecedes+ ?later . ?flow p:r56_specifiesStep ?later}
 BIND(IF(BOUND(?later),"documented_precedence","no_recorded_successor") AS ?orderState)
  }
