PREFIX p: <urn:productium:specification-profile:>
PREFIX a: <urn:product-ontology:assessment-profile:0.4:>
PREFIX d: <urn:product-ontology:delivery-profile:0.5:>
PREFIX e: <urn:product-ontology:trace-profile:0.6:>
PREFIX t: <urn:orsd:v06:synthetic:>
SELECT DISTINCT ?artifact ?finding ?recommendation WHERE { 
 ?finding a p:UsabilityFindingRecord .
 VALUES ?link {p:r60_reportsOnFlow p:r61_reportsOnScreen e:usabilityPersona e:usabilityUserRole e:usabilityJourney e:usabilityJourneyStage e:usabilityTouchpoint e:usabilityStep e:usabilityInformationArchitecture e:usabilityUIState}
 ?finding ?link ?artifact . OPTIONAL {?finding e:usabilityRecommendation ?recommendation}
  }
