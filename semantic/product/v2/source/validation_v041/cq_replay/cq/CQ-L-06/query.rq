PREFIX p: <urn:productium:specification-profile:>
PREFIX a: <urn:product-ontology:assessment-profile:0.4:>
PREFIX d: <urn:product-ontology:delivery-profile:0.5:>
PREFIX e: <urn:product-ontology:trace-profile:0.6:>
PREFIX t: <urn:orsd:v06:synthetic:>
SELECT DISTINCT ?change ?feature ?artifact ?path ?impactState WHERE { 
 ?change a p:ChangeRecord ; e:changeFeature ?feature . ?feature a p:FeatureSpecification .
 { ?feature p:specifiedByRequirement ?artifact . BIND("requirement" AS ?path) }
 UNION { ?artifact p:r66_plansFeatureDelivery ?feature . BIND("roadmapEntry" AS ?path) }
 UNION { ?artifact p:r75_plansDeliveryItem/p:r80_plansFeature ?feature . BIND("release" AS ?path) }
 UNION { ?artifact p:r87_refinesTestScenario/p:r84_covers ?feature . BIND("testCase" AS ?path) }
 BIND("impact_candidate" AS ?impactState)
  }
