    rdfs:range xsd:string .

<urn:product-ontology:trace-profile:0.6:decisionSelectsSolution> a owl:ObjectProperty ;
    rdfs:comment "Explicitly selected alternatives; multiple selections or no selection are permitted. Every selected solution is considered." ;
    rdfs:domain <urn:productium:specification-profile:DecisionRecord> ;
    rdfs:range <urn:productium:specification-profile:SolutionSpecification> ;
    rdfs:subPropertyOf <urn:product-ontology:trace-profile:0.6:decisionConsidersSolution> .

<urn:product-ontology:trace-profile:0.6:decisionSource> a owl:DatatypeProperty ;
    rdfs:comment "Recorded provenance of this decision record." ;
    rdfs:domain <urn:productium:specification-profile:DecisionRecord> ;
    rdfs:range xsd:anyURI .

