@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:product-ontology:assessment-profile:0.4:attributionAgent> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Recorded assessor identifier. An identifier is operational metadata, not a new Agent concept or a verified identity." ;
    rdfs:domain <urn:productium:specification-profile:EvidenceAttributionRecord> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:assessment-profile:0.4:attributionSource> a owl:DatatypeProperty ;
    rdfs:comment "Recorded source URI; kept separate from the assessor identifier and from evidence ownership." ;
    rdfs:domain <urn:productium:specification-profile:EvidenceAttributionRecord> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:assessment-profile:0.4:attributionStance> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "One of supports, challenges, limits, unassessed. Stance belongs to the record, never globally to its carrier." ;
    rdfs:domain <urn:productium:specification-profile:EvidenceAttributionRecord> ;
    rdfs:range xsd:string .

<urn:product-ontology:assessment-profile:0.4:attributionTimestamp> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Time of the recorded attribution. Does not establish when the evidence carrier was generated." ;
    rdfs:domain <urn:productium:specification-profile:EvidenceAttributionRecord> ;
    rdfs:range xsd:dateTime .

<urn:product-ontology:assessment-profile:0.4:claimActualCapability> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The actual capability under assessment. Paired with claimIntendedCapability; not a satisfaction assertion." ;
    rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
    rdfs:range <urn:productium:specification-profile:ProductCapability> .

<urn:product-ontology:assessment-profile:0.4:claimIntendedCapability> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The intended ability compared in this claim. No intended-to-actual entailment is introduced." ;
    rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
    rdfs:range <urn:productium:specification-profile:CapabilitySpecification> .

<urn:product-ontology:assessment-profile:0.4:claimProduct> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "A product-lineage subject. Exactly one subject is selected across the four subject relations." ;
    rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
    rdfs:range <urn:productium:specification-profile:Product> ;
    rdfs:subPropertyOf <urn:product-ontology:assessment-profile:0.4:claimSubject> .

<urn:product-ontology:assessment-profile:0.4:claimRealization> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "A concrete realization subject; capability assessments use this subject relation." ;
    rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
    rdfs:range <urn:productium:specification-profile:ProductRealization> ;
    rdfs:subPropertyOf <urn:product-ontology:assessment-profile:0.4:claimSubject> .

<urn:product-ontology:assessment-profile:0.4:claimRequirement> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "An authored requirement subject, not the stakeholder intention." ;
    rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
    rdfs:range <urn:productium:specification-profile:RequirementSpecification> ;
    rdfs:subPropertyOf <urn:product-ontology:assessment-profile:0.4:claimSubject> .

<urn:product-ontology:assessment-profile:0.4:claimStatement> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "The proposition asserted by this authored claim; no truth assertion is inferred." ;
    rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
    rdfs:range xsd:string .

<urn:product-ontology:assessment-profile:0.4:claimVersion> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "A specification-baseline subject; not an implemented system." ;
    rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
    rdfs:range <urn:productium:specification-profile:ProductVersion> ;
    rdfs:subPropertyOf <urn:product-ontology:assessment-profile:0.4:claimSubject> .

<urn:product-ontology:assessment-profile:0.4:contextDescription> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Explicit bounded applicability description; not a full structured context ontology." ;
    rdfs:domain <urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> ;
    rdfs:range xsd:string .

<urn:product-ontology:assessment-profile:0.4:contextScenario> a owl:ObjectProperty ;
    rdfs:comment "Optional reuse of authored scenario details without equating context and scenario identity." ;
    rdfs:domain <urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> ;
    rdfs:range <urn:productium:specification-profile:ScenarioSpecification> .

<urn:product-ontology:assessment-profile:0.4:contextSource> a owl:DatatypeProperty ;
    rdfs:comment "URI identifying recorded authoring/source provenance, not proof of authority." ;
    rdfs:domain <urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:assessment-profile:0.4:contextVersion> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Optional baseline qualifier of the context, mandatory for a capability assessment in the reporting profile." ;
    rdfs:domain <urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> ;
    rdfs:range <urn:productium:specification-profile:ProductVersion> .

<urn:product-ontology:assessment-profile:0.4:deferredStatement> a owl:DatatypeProperty ;
    rdfs:comment "Authored deferred content; distinct from exclusion." ;
    rdfs:domain <urn:productium:specification-profile:ScopeSpecification> ;
    rdfs:range xsd:string .

<urn:product-ontology:assessment-profile:0.4:excludedStatement> a owl:DatatypeProperty ;
    rdfs:comment "Authored excluded content; not a closed-world complement of the included content." ;
    rdfs:domain <urn:productium:specification-profile:ScopeSpecification> ;
    rdfs:range xsd:string .

<urn:product-ontology:assessment-profile:0.4:findingSource> a owl:DatatypeProperty ;
    rdfs:comment "Recorded observation provenance URI." ;
    rdfs:domain <urn:productium:specification-profile:FindingRecord> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:assessment-profile:0.4:findingStatement> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Observation or issue content, distinct from its contextual evidential stance." ;
    rdfs:domain <urn:productium:specification-profile:FindingRecord> ;
    rdfs:range xsd:string .

<urn:product-ontology:assessment-profile:0.4:includedStatement> a owl:DatatypeProperty ;
    rdfs:comment "Authored included content. Absence is not an assertion that the included set is empty." ;
    rdfs:domain <urn:productium:specification-profile:ScopeSpecification> ;
    rdfs:range xsd:string .

<urn:product-ontology:assessment-profile:0.4:scopeChangeRecord> a owl:ObjectProperty ;
    rdfs:comment "A recorded change description for this scope baseline. It does not establish an applied implementation change." ;
    rdfs:domain <urn:productium:specification-profile:ScopeSpecification> ;
    rdfs:range <urn:productium:specification-profile:ChangeRecord> .

<urn:product-ontology:assessment-profile:0.4:scopeSource> a owl:DatatypeProperty ;
    rdfs:comment "Recorded source of the authored scope baseline." ;
    rdfs:domain <urn:productium:specification-profile:ScopeSpecification> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:assessment-profile:0.4:scopeSupersedes> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:comment "Recorded directed scope-baseline revision; branching and merging permitted, cycles forbidden." ;
    rdfs:domain <urn:productium:specification-profile:ScopeSpecification> ;
    rdfs:range <urn:productium:specification-profile:ScopeSpecification> .

<urn:product-ontology:assessment-profile:0.4:versionScope> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "At most one consolidated authored scope baseline per product version. Unrecorded scope is allowed; partial documents must be consolidated or this contract revised." ;
    rdfs:domain <urn:productium:specification-profile:ProductVersion> ;
    rdfs:range <urn:productium:specification-profile:ScopeSpecification> .

<urn:product-ontology:delivery-profile:0.5:executionEndedAt> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "End of a concluded run, including an aborted run. Ongoing runs are outside this completed-event profile." ;
    rdfs:domain <urn:productium:specification-profile:TestExecution> ;
    rdfs:range xsd:dateTime .

<urn:product-ontology:delivery-profile:0.5:itemStatusChange> a owl:ObjectProperty ;
    rdfs:comment "Explicit change records cited by this work-item assertion; no applied-change entailment." ;
    rdfs:domain <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
    rdfs:range <urn:productium:specification-profile:ChangeRecord> .

<urn:product-ontology:delivery-profile:0.5:itemStatusCode> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Recorded code under the named workflow scheme; it is not proof of delivery." ;
    rdfs:domain <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
    rdfs:range xsd:string .

<urn:product-ontology:delivery-profile:0.5:itemStatusReportedAt> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Time of this immutable report, not automatically the time of delivery." ;
    rdfs:domain <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
    rdfs:range xsd:dateTime .

<urn:product-ontology:delivery-profile:0.5:itemStatusScheme> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Identifier of the interpretation scheme; this ontology does not impose a universal delivery lifecycle." ;
    rdfs:domain <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:delivery-profile:0.5:itemStatusSource> a owl:DatatypeProperty ;
    rdfs:comment "Recorded report provenance, distinct from a workflow code." ;
    rdfs:domain <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:delivery-profile:0.5:itemStatusVersion> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Optional exact baseline qualifier of this work-item assertion; changing a qualifier creates another record." ;
    rdfs:domain <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
    rdfs:range <urn:productium:specification-profile:ProductVersion> .

<urn:product-ontology:delivery-profile:0.5:observedAuthority> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Observed authority identifier; required and different from the old authority for authority_changed findings." ;
    rdfs:domain <urn:productium:specification-profile:FindingRecord> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:delivery-profile:0.5:observedTarget> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Observed target identifier; required and different from the old target for target_changed findings." ;
    rdfs:domain <urn:productium:specification-profile:FindingRecord> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:delivery-profile:0.5:referenceRecordedAt> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Recorded creation time of this fixed reference binding." ;
    rdfs:domain <urn:productium:specification-profile:ExternalReferenceRecord> ;
    rdfs:range xsd:dateTime .

<urn:product-ontology:delivery-profile:0.5:referenceReviewFinding> a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "A recorded review finding concerns at most one reference under this reporting profile. Several findings can concern one reference; ordinary findings need not concern any reference." ;
    rdfs:domain <urn:productium:specification-profile:ExternalReferenceRecord> ;
    rdfs:range <urn:productium:specification-profile:FindingRecord> .

<urn:product-ontology:delivery-profile:0.5:referenceRevisionLabel> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Optional authored revision label. A label alone does not establish freshness or a successor." ;
    rdfs:domain <urn:productium:specification-profile:ExternalReferenceRecord> ;
    rdfs:range xsd:string .

<urn:product-ontology:delivery-profile:0.5:referenceSupersedes> a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:comment "An explicit successor reference record replaces an earlier recorded binding for its stated purpose. Branching is permitted; cycles are forbidden. No mutation or automatic identity merge." ;
    rdfs:domain <urn:productium:specification-profile:ExternalReferenceRecord> ;
    rdfs:range <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:product-ontology:delivery-profile:0.5:releaseStatusChange> a owl:ObjectProperty ;
    rdfs:comment "Explicit change records cited by this release-status assertion. This link does not mean an implementation change occurred." ;
    rdfs:domain <urn:productium:specification-profile:DeliveryStatusRecord> ;
    rdfs:range <urn:productium:specification-profile:ChangeRecord> .

<urn:product-ontology:delivery-profile:0.5:releaseStatusCode> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Recorded code under the named workflow scheme; it is not proof of delivery." ;
    rdfs:domain <urn:productium:specification-profile:DeliveryStatusRecord> ;
    rdfs:range xsd:string .

<urn:product-ontology:delivery-profile:0.5:releaseStatusReportedAt> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Time of this immutable report, not automatically the time of delivery." ;
    rdfs:domain <urn:productium:specification-profile:DeliveryStatusRecord> ;
    rdfs:range xsd:dateTime .

<urn:product-ontology:delivery-profile:0.5:releaseStatusScheme> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Identifier of the interpretation scheme; this ontology does not impose a universal delivery lifecycle." ;
    rdfs:domain <urn:productium:specification-profile:DeliveryStatusRecord> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:delivery-profile:0.5:releaseStatusSource> a owl:DatatypeProperty ;
    rdfs:comment "Recorded report provenance, distinct from a workflow code." ;
    rdfs:domain <urn:productium:specification-profile:DeliveryStatusRecord> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:delivery-profile:0.5:releaseStatusVersion> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Optional exact baseline qualifier of this immutable release-status assertion. Unqualified records are not copied to versions." ;
    rdfs:domain <urn:productium:specification-profile:DeliveryStatusRecord> ;
    rdfs:range <urn:productium:specification-profile:ProductVersion> .

<urn:product-ontology:delivery-profile:0.5:resultOutcome> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Local reporting code: passed, failed, aborted, inconclusive or unknown. A recorded pass does not entail claim truth or acceptance." ;
    rdfs:domain <urn:productium:specification-profile:TestResult> ;
    rdfs:range xsd:string .

<urn:product-ontology:delivery-profile:0.5:resultRecordedAt> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Report time at or after the recorded execution end." ;
    rdfs:domain <urn:productium:specification-profile:TestResult> ;
    rdfs:range xsd:dateTime .

<urn:product-ontology:delivery-profile:0.5:resultSource> a owl:DatatypeProperty ;
    rdfs:comment "Source identifier of the recorded execution result." ;
    rdfs:domain <urn:productium:specification-profile:TestResult> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:delivery-profile:0.5:reviewReason> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "For reference-review findings only: target_changed, authority_changed, target_unreachable or scheduled_review." ;
    rdfs:domain <urn:productium:specification-profile:FindingRecord> ;
    rdfs:range xsd:string .

<urn:product-ontology:delivery-profile:0.5:reviewRecordedAt> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Required for a reference-review finding; observations must not predate the referenced binding." ;
    rdfs:domain <urn:productium:specification-profile:FindingRecord> ;
    rdfs:range xsd:dateTime .

<urn:product-ontology:relation-profile:0.7:architecture_intendedRealizedByComponent> a owl:ObjectProperty ;
    rdfs:label "intendedRealizedByComponent" ;
    rdfs:comment "The feature specification explicitly names an external component as a proposed realization target." ;
    rdfs:domain <urn:productium:specification-profile:FeatureSpecification> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Architecture%3AComponent> .

<urn:product-ontology:relation-profile:0.7:architecture_intendedRealizedByService> a owl:ObjectProperty ;
    rdfs:label "intendedRealizedByService" ;
    rdfs:comment "The feature specification names an external service as a proposed realization target." ;
    rdfs:domain <urn:productium:specification-profile:FeatureSpecification> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Architecture%3AService> .

<urn:product-ontology:relation-profile:0.7:architecture_intendedSatisfiedByArchitectureElement> a owl:ObjectProperty ;
    rdfs:label "intendedSatisfiedByArchitectureElement" ;
    rdfs:comment "The requirement specification records an intended architectural satisfaction allocation." ;
    rdfs:domain <urn:productium:specification-profile:RequirementSpecification> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Architecture%3AArchitectureElement> .

<urn:product-ontology:relation-profile:0.7:architecture_intendedSatisfiedByInterface> a owl:ObjectProperty ;
    rdfs:label "intendedSatisfiedByInterface" ;
    rdfs:comment "The requirement specification records an intended satisfaction allocation to an external interface." ;
    rdfs:domain <urn:productium:specification-profile:RequirementSpecification> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Architecture%3AInterface> .

<urn:product-ontology:relation-profile:0.7:architecture_intendedSupportedByArchitectureElement> a owl:ObjectProperty ;
    rdfs:label "intendedSupportedByArchitectureElement" ;
    rdfs:comment "The intended capability specification identifies an architectural element proposed to support it." ;
    rdfs:domain <urn:productium:specification-profile:CapabilitySpecification> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Architecture%3AArchitectureElement> .

<urn:product-ontology:relation-profile:0.7:r107_intendedToSupport> a owl:ObjectProperty ;
    rdfs:label "intendedToSupport" ;
    rdfs:comment "The capability specification records an intention to support an externally governed business capability." ;
    rdfs:domain <urn:productium:specification-profile:CapabilitySpecification> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Business%3ABusinessCapability> .

<urn:product-ontology:relation-profile:0.7:r116_references> a owl:ObjectProperty ;
    rdfs:label "references" ;
    rdfs:comment "The positioning statement explicitly cites an externally governed value proposition." ;
    rdfs:domain <urn:productium:specification-profile:PositioningStatement> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Business%3AValueProposition> .

<urn:product-ontology:relation-profile:0.7:r157_evidencedBy> a owl:ObjectProperty ;
    rdfs:label "evidencedBy" ;
    rdfs:comment "The problem statement explicitly cites external evidence offered for its formulation, without asserting that its claim is true." ;
    rdfs:domain <urn:productium:specification-profile:ProblemStatement> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:EvidenceLayer%3AEvidence> .

<urn:product-ontology:relation-profile:0.7:r162_evidencedBy> a owl:ObjectProperty ;
    rdfs:label "evidencedBy" ;
    rdfs:comment "The product-market-fit assessment cites external evidence informing its recorded assessment." ;
    rdfs:domain <urn:productium:specification-profile:ProductMarketFitAssessment> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:EvidenceLayer%3AEvidence> .

<urn:product-ontology:relation-profile:0.7:r167_supports> a owl:ObjectProperty ;
    rdfs:label "supports" ;
    rdfs:comment "The quality requirement records an intended contribution to an external business goal." ;
    rdfs:domain <urn:productium:specification-profile:QualityRequirementSpecification> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Business%3ABusinessGoal> .

<urn:product-ontology:relation-profile:0.7:r185_referencesValueProposition> a owl:ObjectProperty ;
    rdfs:label "referencesValueProposition" ;
    rdfs:comment "The product has an explicit knowledge link to an externally governed value proposition." ;
    rdfs:domain <urn:productium:specification-profile:Product> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Business%3AValueProposition> .

<urn:product-ontology:relation-profile:0.7:r186_targets> a owl:ObjectProperty ;
    rdfs:label "targets" ;
    rdfs:comment "The offering specification identifies an external segment in its intended audience." ;
    rdfs:domain <urn:productium:specification-profile:OfferingSpecification> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Market%3ACustomerSegment> .

<urn:product-ontology:relation-profile:0.7:r187_includesService> a owl:ObjectProperty ;
    rdfs:label "includesService" ;
    rdfs:comment "The offering specification describes an external service as included in the intended offer; it does not assert an executed service event." ;
    rdfs:domain <urn:productium:specification-profile:OfferingSpecification> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Business%3AService> .

<urn:product-ontology:relation-profile:0.7:r188_referencesVariantConfiguration> a owl:ObjectProperty ;
    rdfs:label "referencesVariantConfiguration" ;
    rdfs:comment "The local variant reference records an external configuration relevant to its fixed variant referent; the reference record itself is not configured by that target." ;
    rdfs:domain <urn:productium:specification-profile:ProductVariantReference> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:ProductLine%3AProductConfiguration> .

<urn:product-ontology:relation-profile:0.7:r189_targets> a owl:ObjectProperty ;
    rdfs:label "targets" ;
    rdfs:comment "The vision statement identifies an external segment within its intended audience." ;
    rdfs:domain <urn:productium:specification-profile:VisionStatement> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Market%3ACustomerSegment> .

<urn:product-ontology:relation-profile:0.7:r190_referencesValueProposition> a owl:ObjectProperty ;
    rdfs:label "referencesValueProposition" ;
    rdfs:comment "The vision statement explicitly cites an external value proposition." ;
    rdfs:domain <urn:productium:specification-profile:VisionStatement> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:Business%3AValueProposition> .

<urn:product-ontology:relation-profile:0.7:r192_references> a owl:ObjectProperty ;
    rdfs:label "references" ;
    rdfs:comment "The problem-solution-fit assessment cites external evidence considered in its recorded appraisal." ;
    rdfs:domain <urn:productium:specification-profile:ProblemSolutionFitAssessment> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3AEvidence> .

<urn:product-ontology:relation-profile:0.7:r194_referencesMentalModel> a owl:ObjectProperty ;
    rdfs:label "referencesMentalModel" ;
    rdfs:comment "The information-architecture specification cites an externally governed user mental model as a design input." ;
    rdfs:domain <urn:productium:specification-profile:InformationArchitectureSpecification> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:UXResearch%3AUser_Mental_Model> .

<urn:product-ontology:relation-profile:0.7:r195_usesScript> a owl:ObjectProperty ;
    rdfs:label "usesScript" ;
    rdfs:comment "The test-case specification references an external test script prescribed for its procedure; this is not evidence of execution." ;
    rdfs:domain <urn:productium:specification-profile:TestCase> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3ATest_Script> .

<urn:product-ontology:relation-profile:0.7:r196_reportedUnderTestPlan> a owl:ObjectProperty ;
    rdfs:label "reportedUnderTestPlan" ;
    rdfs:comment "The test-result record is explicitly reported under an externally governed test plan; this is not a part-whole assertion." ;
    rdfs:domain <urn:productium:specification-profile:TestResult> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3ATest_Plan> .

<urn:product-ontology:relation-profile:0.7:r197_citesExecutionScript> a owl:ObjectProperty ;
    rdfs:label "citesExecutionScript" ;
    rdfs:comment "The test-result record cites an external script reported as relevant to its recorded execution; the record itself does not execute the script." ;
    rdfs:domain <urn:productium:specification-profile:TestResult> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3ATest_Script> .

<urn:product-ontology:relation-profile:0.7:r198_citesSupportingEvidence> a owl:ObjectProperty ;
    rdfs:label "citesSupportingEvidence" ;
    rdfs:comment "The validation attribution record explicitly cites an additional external evidence item as support for its recorded attribution." ;
    rdfs:domain <urn:productium:specification-profile:ValidationEvidenceRecord> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3AEvidence> .

<urn:product-ontology:relation-profile:0.7:r199_referencesDatasetConfiguration> a owl:ObjectProperty ;
    rdfs:label "referencesDatasetConfiguration" ;
    rdfs:comment "The test-data reference records an external configuration of or relevant to its fixed dataset referent." ;
    rdfs:domain <urn:productium:specification-profile:TestDataReference> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3AConfiguration> .

