    rdfs:domain <urn:productium:specification-profile:CompetitiveNarrative> ;
    rdfs:range <urn:productium:specification-profile:MarketingInsightReference> .

<urn:product-ontology:trace-profile:0.6:proposalFeature> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Intended feature subject. Supports a proposal even when no ChangeRecord exists." ;
    rdfs:domain <urn:productium:specification-profile:ChangeProposalSpecification> ;
    rdfs:range <urn:productium:specification-profile:FeatureSpecification> .

<urn:product-ontology:trace-profile:0.6:proposalScope> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Intended scope subject; exclusive with proposalFeature. A proposal does not create a change occurrence." ;
