    rdfs:domain <urn:productium:specification-profile:ChangeRecord> ;
    rdfs:range <urn:productium:specification-profile:TaskReference> .

<urn:product-ontology:trace-profile:0.6:decisionEvidence> a owl:ObjectProperty ;
