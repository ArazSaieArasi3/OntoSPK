<urn:product-ontology:assessment-profile:0.4:claimContext> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "One fixed applicability context; sharing a context does not imply sharing a claim." ;
    rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
    rdfs:range <urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> .

<urn:product-ontology:assessment-profile:0.4:claimCriterion> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "One atomic assessment criterion. Compound criteria must have an explicit condition specification." ;
    rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
    rdfs:range <urn:productium:specification-profile:ConditionSpecification> .

<urn:product-ontology:delivery-profile:0.5:executionContext> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "One fixed assessment applicability context for a concluded test occurrence. Repeated or differently contextualized runs are separate events." ;
    rdfs:domain <urn:productium:specification-profile:TestExecution> ;
    rdfs:range <urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> .

<urn:product-ontology:delivery-profile:0.5:executionCriterion> a owl:ObjectProperty ;
    rdfs:comment "Explicit assessment criteria evaluated during the run. Case membership and shared labels do not establish criterion coverage." ;
    rdfs:domain <urn:productium:specification-profile:TestExecution> ;
    rdfs:range <urn:productium:specification-profile:ConditionSpecification> .

<urn:product-ontology:delivery-profile:0.5:itemStatus> a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "One item owns each status assertion; an item may have no record or many historical records. Release membership never propagates status." ;
    rdfs:domain <urn:productium:specification-profile:DeliveryWorkItem> ;
    rdfs:range <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> .

