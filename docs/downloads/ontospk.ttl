<urn:productium:specification-profile:> a owl:Ontology ;
    owl:versionInfo "IC-0.7 authored specification identity candidate" .

<urn:productium:specification-profile:FunctionalRequirementSpecification> a owl:Class ;
    rdfs:label "FunctionalRequirementSpecification" ;
    rdfs:comment "A requirement specification with an essential normative commitment about intended behavior or functionality." ;
    rdfs:subClassOf <urn:productium:specification-profile:RequirementSpecification> .

<urn:productium:specification-profile:assessesProblem> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:ProblemSolutionFitAssessment> ;
    rdfs:range <urn:productium:specification-profile:ProblemStatement> .

<urn:productium:specification-profile:assessesProduct> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:ProductMarketFitAssessment> ;
    rdfs:range <urn:productium:specification-profile:Product> .

<urn:productium:specification-profile:assessesSolution> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:ProblemSolutionFitAssessment> ;
    rdfs:range <urn:productium:specification-profile:SolutionSpecification> .

<urn:productium:specification-profile:concernsRequirement> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:ValidationFindingRecord> ;
    rdfs:range <urn:productium:specification-profile:RequirementSpecification> .

<urn:productium:specification-profile:constrainsRequirement> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:ConstraintSpecification> ;
    rdfs:range <urn:productium:specification-profile:RequirementSpecification> .

<urn:productium:specification-profile:containsCase> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:TestSuiteSpecification> ;
    rdfs:range <urn:productium:specification-profile:TestCase> .

<urn:productium:specification-profile:containsProduct> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:ProductPortfolio> ;
    rdfs:range <urn:productium:specification-profile:Product> .

<urn:productium:specification-profile:containsStage> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:JourneySpecification> ;
    rdfs:range <urn:productium:specification-profile:JourneyStageSpecification> .

<urn:productium:specification-profile:definesLifecycleStage> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:LifecycleSpecification> ;
    rdfs:range <urn:productium:specification-profile:LifecycleStageSpecification> .

<urn:productium:specification-profile:dependsOnEnablerSpecification> a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "dependsOnFeatureSpecification" ;
    rdfs:domain <urn:productium:specification-profile:FeatureSpecification> ;
    rdfs:range <urn:productium:specification-profile:FeatureSpecification> .

<urn:productium:specification-profile:exemplifiedByScenario> a owl:ObjectProperty ;
