        owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:productium:specification-profile:scenarioActions> a owl:DatatypeProperty ;
    rdfs:domain <urn:productium:specification-profile:ScenarioSpecification> ;
    rdfs:range xsd:string .

<urn:productium:specification-profile:scenarioContext> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:ScenarioSpecification> .

<urn:productium:specification-profile:scenarioPrecondition> a owl:DatatypeProperty ;
    rdfs:domain <urn:productium:specification-profile:ScenarioSpecification> ;
    rdfs:range xsd:string .

<urn:productium:specification-profile:specifiesExpectedCondition> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:ScenarioSpecification> ;
    rdfs:range <urn:productium:specification-profile:ConditionSpecification> .

<urn:product-ontology:external-boundary:0.7:Architecture%3AArchitectureElement> a owl:Class ;
    rdfs:label "ArchitectureElement" ;
    rdfs:comment "Boundary placeholder for a separately governed target type. UFO stereotype and authoritative alignment are unresolved; no local ownership or owl:equivalentClass claim." .

<urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3ATest_Script> a owl:Class ;
    rdfs:label "Test Script" ;
    rdfs:comment "Boundary placeholder for a separately governed target type. UFO stereotype and authoritative alignment are unresolved; no local ownership or owl:equivalentClass claim." .

<urn:product-ontology:relation-profile:0.7:r160_evidencedBy> a owl:ObjectProperty ;
    rdfs:label "evidencedBy" ;
    rdfs:comment "The hypothesis specification explicitly cites external evidence offered in assessing its proposition." ;
    rdfs:domain <urn:productium:specification-profile:HypothesisSpecification> ;
    rdfs:range <urn:product-ontology:external-boundary:0.7:EvidenceLayer%3AEvidence> .

<urn:productium:specification-profile:BundleSpecification> a owl:Class ;
    rdfs:label "BundleSpecification" ;
    rdfs:comment "A governed composition specification referencing offerings intended to be presented together." .

<urn:productium:specification-profile:CommitmentLevelDefinition> a owl:Class ;
    rdfs:label "CommitmentLevelDefinition" ;
    rdfs:comment "A governed term definition for a planning-commitment label within a named scheme." .

<urn:productium:specification-profile:EnablerSpecification> a owl:Class ;
    rdfs:label "EnablerSpecification" ;
    rdfs:comment "An authored supporting-work specification intended to enable a feature or capability specification." .

<urn:productium:specification-profile:FeatureFlagSpecification> a owl:Class ;
    rdfs:label "FeatureFlagSpecification" ;
    rdfs:comment "A specification of a named feature-activation control and its intended scoping policy." .

<urn:productium:specification-profile:LifecycleStageSpecification> a owl:Class ;
    rdfs:label "LifecycleStageSpecification" ;
    rdfs:comment "A scoped definition of a lifecycle stage within one lifecycle specification." .

<urn:productium:specification-profile:ProductLineReference> a owl:Class ;
    rdfs:label "ProductLineReference" ;
    rdfs:comment "A local reference artifact identifying an externally governed product line. Its product-line purpose is constitutive to the authored reference record, not a temporary role of the target." ;
    rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:productium:specification-profile:ProductStatusRecord> a owl:Class ;
    rdfs:label "ProductStatusRecord" ;
    rdfs:comment "A dated contextual assertion assigning a status value to one product." .

<urn:productium:specification-profile:ProductVariantReference> a owl:Class ;
    rdfs:label "ProductVariantReference" ;
    rdfs:comment "A local reference artifact identifying an externally governed product variant. Its product-variant purpose is constitutive to the authored reference record, not a temporary role of the target." ;
    rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:productium:specification-profile:RequirementRationaleStatement> a owl:Class ;
    rdfs:label "RequirementRationaleStatement" ;
    rdfs:comment "An authored justification statement explaining why a requirement specification is needed." .

<urn:productium:specification-profile:TaskReference> a owl:Class ;
    rdfs:label "TaskReference" ;
    rdfs:comment "A local reference artifact identifying an externally governed implementation task. Its implementation-task purpose is constitutive to the authored reference record, not a temporary role of the target." ;
    rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:productium:specification-profile:TestDataReference> a owl:Class ;
    rdfs:label "TestDataReference" ;
    rdfs:comment "A local reference artifact identifying a versioned dataset used in test design or execution. Its test-data purpose is constitutive to the authored reference record, not a temporary role of the target." ;
    rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:productium:specification-profile:ValidationEvidenceRecord> a owl:Class ;
    rdfs:label "ValidationEvidenceRecord" ;
    rdfs:comment "An evidence-attribution record whose constitutive assessment purpose is validation." ;
    rdfs:subClassOf <urn:productium:specification-profile:EvidenceAttributionRecord> .

<urn:productium:specification-profile:ValidationFindingRecord> a owl:Class ;
    rdfs:label "ValidationFindingRecord" ;
    rdfs:comment "A FindingRecord whose constitutive subject matter includes a requirement specification." ;
    rdfs:subClassOf <urn:productium:specification-profile:FindingRecord> .

<urn:productium:specification-profile:assessesSpecification> a owl:ObjectProperty ;
    rdfs:comment "At least one intended ability contract for the same tested version." ;
    rdfs:domain <urn:productium:specification-profile:TestExecution> ;
    rdfs:range <urn:productium:specification-profile:CapabilitySpecification> .

<urn:productium:specification-profile:bearsCapability> a owl:ObjectProperty ;
    rdfs:comment "Each actual disposition has exactly one realization bearer throughout its existence. The 1..* capability bound is a local profile restriction to capability-bearing configured systems, not a universal claim about every broken installation." ;
    rdfs:domain <urn:productium:specification-profile:ProductRealization> ;
    rdfs:range <urn:productium:specification-profile:ProductCapability> .

<urn:productium:specification-profile:evaluatedAgainst> a owl:ObjectProperty ;
    rdfs:comment "Assessment reference does not assert conformance or success." ;
    rdfs:domain <urn:productium:specification-profile:ProductCapability> ;
    rdfs:range <urn:productium:specification-profile:CapabilitySpecification> .

<urn:productium:specification-profile:executes> a owl:ObjectProperty ;
    rdfs:comment "Exactly one test specification per completed execution in this profile." ;
    rdfs:domain <urn:productium:specification-profile:TestExecution> ;
    rdfs:range <urn:productium:specification-profile:TestCase> .

<urn:productium:specification-profile:hasVersion> a owl:ObjectProperty ;
    rdfs:comment "Versions may be absent for an early product; each version belongs to one product." ;
    rdfs:domain <urn:productium:specification-profile:Product> ;
    rdfs:range <urn:productium:specification-profile:ProductVersion> .

<urn:productium:specification-profile:realizesVersion> a owl:ObjectProperty ;
    rdfs:comment "A configured deployment artifact enacts one fixed version baseline in this bounded profile; this trace does not certify full conformance. A constitutive version change creates a successor realization." ;
    rdfs:domain <urn:productium:specification-profile:ProductRealization> ;
    rdfs:range <urn:productium:specification-profile:ProductVersion> .

<urn:productium:specification-profile:recordsCarrier> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:EvidenceAttributionRecord> ;
    rdfs:range <urn:productium:specification-profile:EvidenceArtifact> .

<urn:productium:specification-profile:recordsClaim> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:EvidenceAttributionRecord> ;
    rdfs:range <urn:productium:specification-profile:AssessmentClaim> .

<urn:productium:specification-profile:recordsExecution> a owl:ObjectProperty ;
    rdfs:comment "A consolidated result documents one concluded attempt; inverse of the native hasResult association, not a report-creation relation." ;
    rdfs:domain <urn:productium:specification-profile:TestResult> ;
    rdfs:range <urn:productium:specification-profile:TestExecution> .

<urn:productium:specification-profile:specifiesCapability> a owl:ObjectProperty ;
    rdfs:comment "Specification is version-scoped; reuse across versions uses distinct scoped specifications." ;
    rdfs:domain <urn:productium:specification-profile:ProductVersion> ;
    rdfs:range <urn:productium:specification-profile:CapabilitySpecification> .

<urn:productium:specification-profile:testsRealization> a owl:ObjectProperty ;
    rdfs:comment "Exactly one concrete test subject; a plan is not a test subject." ;
    rdfs:domain <urn:productium:specification-profile:TestExecution> ;
    rdfs:range <urn:productium:specification-profile:ProductRealization> .

<urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3AEvidence> a owl:Class ;
    rdfs:label "Evidence" ;
    rdfs:comment "Boundary placeholder for a separately governed target type. UFO stereotype and authoritative alignment are unresolved; no local ownership or owl:equivalentClass claim." .

<urn:productium:specification-profile:ConfidenceAssessment> a owl:Class ;
    rdfs:label "ConfidenceAssessment" ;
    rdfs:comment "A dated assessment of planning confidence with explicit subject, assessor, evidence context and scale." .

<urn:productium:specification-profile:DecisionCriterionSpecification> a owl:Class ;
    rdfs:label "DecisionCriterionSpecification" ;
    rdfs:comment "An authored rule or criterion specification used to appraise product alternatives." .

<urn:productium:specification-profile:LifecycleSpecification> a owl:Class ;
    rdfs:label "LifecycleSpecification" ;
    rdfs:comment "An authored scheme describing lifecycle-stage meanings applicable to products." .

<urn:productium:specification-profile:MarketingGoalSpecification> a owl:Class ;
    rdfs:label "MarketingGoalSpecification" ;
    rdfs:comment "A goal specification whose constitutive desired result concerns product marketing or market introduction." ;
    rdfs:subClassOf <urn:productium:specification-profile:GoalSpecification> .

<urn:productium:specification-profile:PortfolioEntry> a owl:Class ;
    rdfs:label "PortfolioEntry" ;
    rdfs:comment "A governed entry in one portfolio, optionally referencing a product while a broader target binding is being specified." .

<urn:productium:specification-profile:PriorityAssessment> a owl:Class ;
    rdfs:label "PriorityAssessment" ;
    rdfs:comment "A dated contextual ranking assessment recording a rank for a roadmap entry within a named comparison set and scale." .

<urn:productium:specification-profile:ReleaseEvidenceRecord> a owl:Class ;
    rdfs:label "ReleaseEvidenceRecord" ;
    rdfs:comment "An evidence-attribution record whose constitutive assessment purpose is release." ;
    rdfs:subClassOf <urn:productium:specification-profile:EvidenceAttributionRecord> .

<urn:productium:specification-profile:Roadmap> a owl:Class ;
    rdfs:label "Roadmap" ;
    rdfs:comment "A governed planning-projection artifact referencing canonical product knowledge." .

<urn:productium:specification-profile:TargetWindowAssignment> a owl:Class ;
    rdfs:label "TargetWindowAssignment" ;
    rdfs:comment "A planning record assigning a bounded target interval to one roadmap entry." .

<urn:productium:specification-profile:TestSuiteSpecification> a owl:Class ;
    rdfs:label "TestSuiteSpecification" ;
    rdfs:comment "A governed test-organization specification containing references to test cases." .

<urn:productium:specification-profile:UIStateSpecification> a owl:Class ;
    rdfs:label "UIStateSpecification" ;
    rdfs:comment "A scoped specification of a screen condition and its expected presentation or interaction." .

<urn:productium:specification-profile:UserRoleSpecification> a owl:Class ;
    rdfs:label "UserRoleSpecification" ;
    rdfs:comment "A designed specification of a user participation context, responsibilities and permissions." .

<urn:productium:specification-profile:VerticalSliceSpecification> a owl:Class ;
    rdfs:label "VerticalSliceSpecification" ;
    rdfs:comment "An authored end-to-end increment specification connecting intended value to coherent behavior and acceptance conditions." .

<urn:productium:specification-profile:hypothesizesAboutProblem> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:HypothesisSpecification> ;
    rdfs:range <urn:productium:specification-profile:ProblemStatement> .

<urn:productium:specification-profile:isCarrierInRecord> a owl:ObjectProperty ;
    owl:inverseOf <urn:productium:specification-profile:recordsCarrier> .

<urn:productium:specification-profile:specificationProvenance> a owl:ObjectProperty .

<urn:product-ontology:external-boundary:0.7:Business%3AValueProposition> a owl:Class ;
    rdfs:label "ValueProposition" ;
    rdfs:comment "Boundary placeholder for a separately governed target type. UFO stereotype and authoritative alignment are unresolved; no local ownership or owl:equivalentClass claim." .

<urn:productium:specification-profile:InformationArchitectureSpecification> a owl:Class ;
    rdfs:label "InformationArchitectureSpecification" ;
    rdfs:comment "An authored model of information organization, hierarchy and navigation." .

<urn:productium:specification-profile:MilestoneSpecification> a owl:Class ;
    rdfs:label "MilestoneSpecification" ;
    rdfs:comment "An authored target-condition specification marking intended planning progress." .

<urn:productium:specification-profile:PlanningHorizonDefinition> a owl:Class ;
    rdfs:label "PlanningHorizonDefinition" ;
    rdfs:comment "A governed term definition specifying the meaning of a planning-horizon label in a named scheme." .

<urn:productium:specification-profile:ProblemSolutionFitAssessment> a owl:Class ;
    rdfs:label "ProblemSolutionFitAssessment" ;
    rdfs:comment "A dated assessment record about the proposed fit of a problem statement and a solution specification." .

<urn:productium:specification-profile:SolutionHypothesisSpecification> a owl:Class ;
    rdfs:label "SolutionHypothesisSpecification" ;
    rdfs:comment "A hypothesis specification whose constitutive claim concerns a proposed solution addressing a problem." ;
    rdfs:subClassOf <urn:productium:specification-profile:HypothesisSpecification> .

<urn:productium:specification-profile:TestScenario> a owl:Class ;
    rdfs:label "TestScenario" ;
    rdfs:comment "A ScenarioSpecification describing a situation to verify specified behavior or conditions. It can be detailed enough to also be a TestCase; its described situation is not a completed TestExecution." ;
    rdfs:subClassOf <urn:productium:specification-profile:ScenarioSpecification> .

<urn:product-ontology:assessment-profile:0.4:claimSubject> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <urn:productium:specification-profile:Product> <urn:productium:specification-profile:ProductVersion> <urn:productium:specification-profile:ProductRealization> <urn:productium:specification-profile:RequirementSpecification> ) ] .

<urn:product-ontology:external-boundary:0.7:Market%3ACustomerSegment> a owl:Class ;
    rdfs:label "CustomerSegment" ;
    rdfs:comment "Boundary placeholder for a separately governed target type. UFO stereotype and authoritative alignment are unresolved; no local ownership or owl:equivalentClass claim." .

<urn:product-ontology:external-boundary:0.7:Market%3ANeed> a owl:Class ;
    rdfs:label "Need" ;
    rdfs:comment "Boundary placeholder for a separately governed target type. UFO stereotype and authoritative alignment are unresolved; no local ownership or owl:equivalentClass claim." .

<urn:productium:specification-profile:AcceptanceCriterionSpecification> a owl:Class ;
    rdfs:label "AcceptanceCriterionSpecification" ;
    rdfs:comment "An authored ConditionSpecification whose constitutive content includes condition used in the authored acceptance contract. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence." ;
    rdfs:subClassOf <urn:productium:specification-profile:ConditionSpecification> .

<urn:productium:specification-profile:ProductMarketFitAssessment> a owl:Class ;
    rdfs:label "ProductMarketFitAssessment" ;
    rdfs:comment "A dated assessment record about a product in an explicitly identified market context." .

<urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> a owl:Class ;
    rdfs:label "Assessment Context Specification" ;
    rdfs:comment "An authored specification fixing the applicability boundary of an assessment, including its stated population, environment and temporal conditions, with optional version and scenario bindings." ;
    owl:disjointWith <urn:productium:specification-profile:AssessmentClaim>,
        <urn:productium:specification-profile:ConditionSpecification>,
        <urn:productium:specification-profile:EvidenceArtifact>,
        <urn:productium:specification-profile:EvidenceAttributionRecord>,
        <urn:productium:specification-profile:ProductCapability>,
        <urn:productium:specification-profile:ProductRealization>,
        <urn:productium:specification-profile:ProductVersion>,
        <urn:productium:specification-profile:ScenarioSpecification>,
        <urn:productium:specification-profile:ScopeSpecification> .

<urn:productium:specification-profile:AcquisitionHypothesisSpecification> a owl:Class ;
    rdfs:label "AcquisitionHypothesisSpecification" ;
    rdfs:comment "A hypothesis specification whose constitutive claim concerns acquiring intended users or customers." ;
    rdfs:subClassOf <urn:productium:specification-profile:HypothesisSpecification> .

<urn:productium:specification-profile:ChangeProposalSpecification> a owl:Class ;
    rdfs:label "ChangeProposalSpecification" ;
    rdfs:comment "An authored proposal specifying a desired change and its intended target." .

<urn:productium:specification-profile:InteractionStepSpecification> a owl:Class ;
    rdfs:label "InteractionStepSpecification" ;
    rdfs:comment "A scoped action or decision-step specification in one user-flow design." .

<urn:productium:specification-profile:MarketingInsightReference> a owl:Class ;
    rdfs:label "MarketingInsightReference" ;
    rdfs:comment "A governed local reference artifact with one canonical target and an explicitly supplied owner identifier. Its marketing-insight purpose is constitutive to the authored reference record, not a temporary role of the target." ;
    rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:productium:specification-profile:TestCase> a owl:Class ;
    rdfs:label "TestCase" ;
    rdfs:comment "A ScenarioSpecification that includes an operational test procedure and expected conditions. Repeated executions reuse the specification and remain distinct events." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:executes> ] ],
        <urn:productium:specification-profile:ScenarioSpecification> .

<urn:productium:specification-profile:TouchpointSpecification> a owl:Class ;
    rdfs:label "TouchpointSpecification" ;
    rdfs:comment "A design artifact specifying a point of contact, its channel, purpose and interaction context." .

<urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> a owl:Class ;
    rdfs:label "Delivery Work Item Status Record" ;
    rdfs:comment "An immutable dated information record assigning a status code under a stated scheme to one delivery work item, optionally qualified by one product version." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf <urn:product-ontology:delivery-profile:0.5:itemStatus> ] ] ;
    owl:disjointWith <urn:productium:specification-profile:DeliveryStatusRecord>,
        <urn:productium:specification-profile:DeliveryWorkItem>,
        <urn:productium:specification-profile:ProductCapability>,
        <urn:productium:specification-profile:ProductRealization>,
        <urn:productium:specification-profile:ProductVersion>,
        <urn:productium:specification-profile:ReleaseSpecification>,
        <urn:productium:specification-profile:TestExecution>,
        <urn:productium:specification-profile:TestResult> .

<urn:productium:specification-profile:AdoptionHypothesisSpecification> a owl:Class ;
    rdfs:label "AdoptionHypothesisSpecification" ;
    rdfs:comment "A hypothesis specification whose constitutive claim concerns adoption barriers or adoption behavior." ;
    rdfs:subClassOf <urn:productium:specification-profile:HypothesisSpecification> .

<urn:productium:specification-profile:DeliveryWorkItem> a owl:Class ;
    rdfs:label "DeliveryWorkItem" ;
    rdfs:comment "A governed work-item artifact about intended delivery scope and its referenced functional specifications." .

<urn:productium:specification-profile:EvidenceArtifact> a owl:Class ;
    rdfs:label "EvidenceArtifact" ;
    rdfs:comment "An abstract category of information artifacts eligible to carry evidence in this bounded profile." ;
    owl:disjointWith <urn:productium:specification-profile:AssessmentClaim> .

<urn:productium:specification-profile:GoalSpecification> a owl:Class ;
    rdfs:label "GoalSpecification" ;
    rdfs:comment "An authored ConditionSpecification whose constitutive content includes desired product condition. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence." ;
    rdfs:subClassOf <urn:productium:specification-profile:ConditionSpecification> .

<urn:productium:specification-profile:LaunchSpecification> a owl:Class ;
    rdfs:label "LaunchSpecification" ;
    rdfs:comment "A plan specification for introducing a product or change to an intended audience." .

<urn:productium:specification-profile:MessagingSpecification> a owl:Class ;
    rdfs:label "MessagingSpecification" ;
    rdfs:comment "An authored specification of audience-directed messages and supporting claims." .

<urn:productium:specification-profile:OfferingSpecification> a owl:Class ;
    rdfs:label "OfferingSpecification" ;
    rdfs:comment "A catalog specification of how one product is intended to be offered to an audience under stated terms." .

<urn:productium:specification-profile:OpportunityStatement> a owl:Class ;
    rdfs:label "OpportunityStatement" ;
    rdfs:comment "A governed statement artifact identifying a possible value improvement in context." .

<urn:productium:specification-profile:OutcomeSpecification> a owl:Class ;
    rdfs:label "OutcomeSpecification" ;
    rdfs:comment "An authored ConditionSpecification whose constitutive content includes expected measurable product condition. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence." ;
    rdfs:subClassOf <urn:productium:specification-profile:ConditionSpecification> .

<urn:productium:specification-profile:ProductCapability> a owl:Class ;
    rdfs:label "ProductCapability" ;
    rdfs:comment "An actual intrinsic disposition of one concrete ProductRealization as a configured functional whole. Intended behavior, successful execution, a specification and a machine label are not the disposition." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:evaluatedAgainst> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:bearsCapability> ] ] .

<urn:productium:specification-profile:UserFlowSpecification> a owl:Class ;
    rdfs:label "UserFlowSpecification" ;
    rdfs:comment "An authored sequence model of user actions, decisions and transitions." .

<urn:product-ontology:external-boundary:0.7:EvidenceLayer%3AEvidence> a owl:Class ;
    rdfs:label "Evidence" ;
    rdfs:comment "Boundary placeholder for a separately governed target type. UFO stereotype and authoritative alignment are unresolved; no local ownership or owl:equivalentClass claim." .

<urn:product-ontology:external-boundary:0.7:Market%3APain> a owl:Class ;
    rdfs:label "Pain" ;
    rdfs:comment "Boundary placeholder for a separately governed target type. UFO stereotype and authoritative alignment are unresolved; no local ownership or owl:equivalentClass claim." .

<urn:productium:specification-profile:CompetitiveNarrative> a owl:Class ;
    rdfs:label "CompetitiveNarrative" ;
    rdfs:comment "An authored narrative presenting scoped differentiation claims and their evidential references." .

<urn:productium:specification-profile:DependencySpecification> a owl:Class ;
    rdfs:label "DependencySpecification" ;
    rdfs:comment "An authored claim that one product depends on an identified product, capability or resource under a stated dependency condition." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:product-ontology:trace-profile:0.6:dependencyCondition> ] .

<urn:productium:specification-profile:ProductPortfolio> a owl:Class ;
    rdfs:label "ProductPortfolio" ;
    rdfs:comment "A governed strategic arrangement organizing products, entries and planning references under a continuing portfolio mandate." .

<urn:productium:specification-profile:ScreenSpecification> a owl:Class ;
    rdfs:label "ScreenSpecification" ;
    rdfs:comment "An authored view specification with layout, interaction and state commitments." .

<urn:productium:specification-profile:UserStorySpecification> a owl:Class ;
    rdfs:label "UserStorySpecification" ;
    rdfs:comment "An authored user-centered narrative specifying a desired interaction goal and expected value." .

<urn:productium:specification-profile:VisionStatement> a owl:Class ;
    rdfs:label "VisionStatement" ;
    rdfs:comment "An authored statement articulating intended product direction, experience and value." .

<urn:productium:specification-profile:DecisionRecord> a owl:Class ;
    rdfs:label "DecisionRecord" ;
    rdfs:comment "An immutable record of a product decision, its considered alternatives, rationale and provenance." .

<urn:productium:specification-profile:DeliveryStatusRecord> a owl:Class ;
    rdfs:label "DeliveryStatusRecord" ;
    rdfs:comment "An immutable dated report assigning a delivery-status value to one Release." .

<urn:productium:specification-profile:HypothesisSpecification> a owl:Class ;
    rdfs:label "HypothesisSpecification" ;
    rdfs:comment "An authored testable-claim artifact fixing its claim, intended scope and refutation or support conditions." .

<urn:productium:specification-profile:InitiativeSpecification> a owl:Class ;
    rdfs:label "InitiativeSpecification" ;
    rdfs:comment "An authored plan coordinating goals, scope and expected product outcomes." .

<urn:productium:specification-profile:JourneySpecification> a owl:Class ;
    rdfs:label "JourneySpecification" ;
    rdfs:comment "An authored structured experience model containing scoped stage specifications." .

<urn:productium:specification-profile:JourneyStageSpecification> a owl:Class ;
    rdfs:label "JourneyStageSpecification" ;
    rdfs:comment "An authored constituent stage specification owned by exactly one JourneySpecification." .

<urn:productium:specification-profile:ProductRealization> a owl:Class ;
    rdfs:label "ProductRealization" ;
    rdfs:comment "A concrete, causally integrated computing-system artifact configured to enact one fixed product-version baseline. It is the deployed functional whole, not its record, hosting machine, execution event or deployment interval." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:testsRealization> ] ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:bearsCapability> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:realizesVersion> ] .

<urn:productium:specification-profile:SolutionSpecification> a owl:Class ;
    rdfs:label "SolutionSpecification" ;
    rdfs:comment "An authored product-level solution proposal describing how problems or opportunities are intended to be addressed." .

<urn:productium:specification-profile:FindingRecord> a owl:Class ;
    rdfs:label "FindingRecord" ;
    rdfs:comment "An authored observation or issue record with a fixed finding statement, subject bindings and provenance." ;
    rdfs:subClassOf <urn:productium:specification-profile:EvidenceArtifact> .

<urn:productium:specification-profile:ScenarioSpecification> a owl:Class ;
    rdfs:label "ScenarioSpecification" ;
    rdfs:comment "An authored structured situation description fixing context, preconditions, ordered stimulus/action description and expected condition units; distinct from each actual occurrence." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <urn:productium:specification-profile:specifiesExpectedCondition> ;
            owl:someValuesFrom <urn:productium:specification-profile:ConditionSpecification> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:scenarioActions> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:specificationProvenance> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:scenarioContext> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:scenarioPrecondition> ] .

<urn:productium:specification-profile:TestExecution> a owl:Class ;
    rdfs:label "TestExecution" ;
    rdfs:comment "A concluded attempt concerning one declared TestCase and ProductRealization. A setup-only abort does not establish actual target participation. One consolidated result documents the attempt." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:product-ontology:delivery-profile:0.5:executionCriterion> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:assessesSpecification> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:recordsExecution> ] ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:executes> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:product-ontology:delivery-profile:0.5:executionContext> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:testsRealization> ] .

<urn:productium:specification-profile:TestResult> a owl:Class ;
    rdfs:label "TestResult" ;
    rdfs:comment "The consolidated evidence record documenting one completed TestExecution." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:recordsExecution> ],
        <urn:productium:specification-profile:EvidenceArtifact> .

<urn:productium:specification-profile:PersonaSpecification> a owl:Class ;
    rdfs:label "PersonaSpecification" ;
    rdfs:comment "An authored model of a user archetype, fixing a behavioral profile, population/use context and research provenance; not a person, group of actual users or their temporary role." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:personaContext> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:personaDescription> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:specificationProvenance> ] .

<urn:productium:specification-profile:UsabilityFindingRecord> a owl:Class ;
    rdfs:label "UsabilityFindingRecord" ;
    rdfs:comment "A FindingRecord whose constitutive subject matter includes a user-flow or screen specification." ;
    rdfs:subClassOf <urn:productium:specification-profile:FindingRecord> .

<urn:productium:specification-profile:GoToMarketSpecification> a owl:Class ;
    rdfs:label "GoToMarketSpecification" ;
    rdfs:comment "A governed strategy specification linking positioning, audiences and intended market-entry activity." .

<urn:productium:specification-profile:ProductMetricReference> a owl:Class ;
    rdfs:label "ProductMetricReference" ;
    rdfs:comment "A local reference artifact binding a product measurement context to an externally governed metric. Its product-metric purpose is constitutive to the authored reference record, not a temporary role of the target." ;
    rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:productium:specification-profile:ReleaseSpecification> a owl:Class ;
    rdfs:label "ReleaseSpecification" ;
    rdfs:comment "A governed specification of a planned delivery increment and its intended contents." .

<urn:productium:specification-profile:ProblemStatement> a owl:Class ;
    rdfs:label "ProblemStatement" ;
    rdfs:comment "A governed statement artifact describing a candidate or evidenced problem." .

<urn:productium:specification-profile:RoadmapEntry> a owl:Class ;
    rdfs:label "RoadmapEntry" ;
    rdfs:comment "A scoped entry in one roadmap referencing intended initiatives, features or delivery targets." .

<urn:productium:specification-profile:ScopeSpecification> a owl:Class ;
    rdfs:label "ScopeSpecification" ;
    rdfs:comment "An authored specification of included, excluded and deferred product scope." .

<urn:productium:specification-profile:CapabilitySpecification> a owl:Class ;
    rdfs:label "CapabilitySpecification" ;
    rdfs:comment "A version-scoped specification of an intended ability, irrespective of its implementation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:evaluatedAgainst> ] ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:assessesSpecification> ] ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:specifiesCapability> ] ] .

<urn:productium:specification-profile:ConditionSpecification> a owl:Class ;
    rdfs:label "ConditionSpecification" ;
    rdfs:comment "An authored semantic condition unit with a fixed proposition, applicability context and authoring provenance; distinct from a stakeholder intention, observed result or containing scenario." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:specificationProvenance> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:conditionStatement> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:conditionContext> ] .

<urn:productium:specification-profile:PositioningStatement> a owl:Class ;
    rdfs:label "PositioningStatement" ;
    rdfs:comment "An authored statement specifying intended product perception for a target audience relative to alternatives." .

<urn:productium:specification-profile:ChangeRecord> a owl:Class ;
    rdfs:label "ChangeRecord" ;
    rdfs:comment "A dated record describing an asserted modification to an identified product artifact or state." ;
    rdfs:subClassOf <urn:productium:specification-profile:EvidenceArtifact> .

<urn:productium:specification-profile:EvidenceAttributionRecord> a owl:Class ;
    rdfs:label "EvidenceAttributionRecord" ;
    rdfs:comment "An information record documenting an assessor's attribution of one carrier to one assessment claim." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <urn:productium:specification-profile:AssessmentClaim> ;
            owl:onProperty <urn:productium:specification-profile:recordsClaim> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <urn:productium:specification-profile:EvidenceArtifact> ;
            owl:onProperty <urn:productium:specification-profile:recordsCarrier> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

<urn:productium:specification-profile:ProductVersion> a owl:Class ;
    rdfs:label "ProductVersion" ;
    rdfs:comment "An immutable approved specification baseline for one Product." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:realizesVersion> ] ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:specifiesCapability> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:hasVersion> ] ] .

<urn:productium:specification-profile:AssessmentClaim> a owl:Class ;
    rdfs:label "AssessmentClaim" ;
    rdfs:comment "An authored assessment-claim artifact fixing subject, criterion, scope and the proposition under consideration." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:product-ontology:assessment-profile:0.4:claimSubject> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:product-ontology:assessment-profile:0.4:claimContext> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:product-ontology:assessment-profile:0.4:claimCriterion> ] .

<urn:productium:specification-profile:RequirementSpecification> a owl:Class ;
    rdfs:label "RequirementSpecification" ;
    rdfs:comment "An authored ConditionSpecification whose constitutive content includes required product condition. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence." ;
    rdfs:subClassOf <urn:productium:specification-profile:ConditionSpecification> .

<urn:productium:specification-profile:ExternalReferenceRecord> a owl:Class ;
    rdfs:label "ExternalReferenceRecord" ;
    rdfs:comment "A local information record of a fixed binding to a separately governed referent, with recorded authority, provenance and constitutive purpose set." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:canonicalOwner> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:referenceTarget> ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:referenceProvenance> ] .

<urn:productium:specification-profile:Product> a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A governed intentional product artifact with continuing constitutive purpose and stewardship lineage; not a deployment or a database row." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <urn:productium:specification-profile:hasVersion> ] .

<urn:productium:specification-profile:FeatureSpecification> a owl:Class ;
    rdfs:label "FeatureSpecification" ;
    rdfs:comment "An authored functional-unit specification linking intended behavior, user value and acceptance criteria." .

[] a owl:AllDisjointClasses ;
    owl:members ( <urn:productium:specification-profile:ProductPortfolio> <urn:productium:specification-profile:Product> <urn:productium:specification-profile:OfferingSpecification> <urn:productium:specification-profile:BundleSpecification> <urn:productium:specification-profile:ProductVersion> <urn:productium:specification-profile:LifecycleSpecification> <urn:productium:specification-profile:LifecycleStageSpecification> <urn:productium:specification-profile:ProductStatusRecord> <urn:productium:specification-profile:DependencySpecification> <urn:productium:specification-profile:PortfolioEntry> <urn:productium:specification-profile:VisionStatement> <urn:productium:specification-profile:InitiativeSpecification> <urn:productium:specification-profile:ProblemStatement> <urn:productium:specification-profile:OpportunityStatement> <urn:productium:specification-profile:HypothesisSpecification> <urn:productium:specification-profile:DecisionRecord> <urn:productium:specification-profile:DecisionCriterionSpecification> <urn:productium:specification-profile:ProblemSolutionFitAssessment> <urn:productium:specification-profile:ProductMarketFitAssessment> <urn:productium:specification-profile:ScopeSpecification> <urn:productium:specification-profile:CapabilitySpecification> <urn:productium:specification-profile:SolutionSpecification> <urn:productium:specification-profile:FeatureSpecification> <urn:productium:specification-profile:VerticalSliceSpecification> <urn:productium:specification-profile:EnablerSpecification> <urn:productium:specification-profile:UserStorySpecification> <urn:productium:specification-profile:RequirementRationaleStatement> <urn:productium:specification-profile:PersonaSpecification> <urn:productium:specification-profile:UserRoleSpecification> <urn:productium:specification-profile:JourneySpecification> <urn:productium:specification-profile:JourneyStageSpecification> <urn:productium:specification-profile:TouchpointSpecification> <urn:productium:specification-profile:UserFlowSpecification> <urn:productium:specification-profile:InteractionStepSpecification> <urn:productium:specification-profile:InformationArchitectureSpecification> <urn:productium:specification-profile:ScreenSpecification> <urn:productium:specification-profile:UIStateSpecification> <urn:productium:specification-profile:Roadmap> <urn:productium:specification-profile:RoadmapEntry> <urn:productium:specification-profile:MilestoneSpecification> <urn:productium:specification-profile:PriorityAssessment> <urn:productium:specification-profile:PlanningHorizonDefinition> <urn:productium:specification-profile:TargetWindowAssignment> <urn:productium:specification-profile:ConfidenceAssessment> <urn:productium:specification-profile:CommitmentLevelDefinition> <urn:productium:specification-profile:ReleaseSpecification> <urn:productium:specification-profile:DeliveryWorkItem> <urn:productium:specification-profile:ChangeRecord> <urn:productium:specification-profile:ChangeProposalSpecification> <urn:productium:specification-profile:FeatureFlagSpecification> <urn:productium:specification-profile:DeliveryStatusRecord> <urn:productium:specification-profile:TestExecution> <urn:productium:specification-profile:TestResult> <urn:productium:specification-profile:TestSuiteSpecification> <urn:productium:specification-profile:PositioningStatement> <urn:productium:specification-profile:MessagingSpecification> <urn:productium:specification-profile:GoToMarketSpecification> <urn:productium:specification-profile:LaunchSpecification> <urn:productium:specification-profile:CompetitiveNarrative> <urn:productium:specification-profile:ProductRealization> <urn:productium:specification-profile:ProductCapability> <urn:productium:specification-profile:AssessmentClaim> <urn:productium:specification-profile:EvidenceAttributionRecord> <urn:productium:specification-profile:FindingRecord> <urn:productium:specification-profile:ExternalReferenceRecord> <urn:productium:specification-profile:ConditionSpecification> <urn:productium:specification-profile:ScenarioSpecification> ) .

