    rdfs:domain <urn:productium:specification-profile:ConditionSpecification> .

<urn:productium:specification-profile:conditionStatement> a owl:DatatypeProperty ;
    rdfs:domain <urn:productium:specification-profile:ConditionSpecification> ;
