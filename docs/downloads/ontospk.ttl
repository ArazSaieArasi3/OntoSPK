<urn:product-ontology:trace-profile:0.6:decisionConsidersSolution> a owl:ObjectProperty ;
    rdfs:comment "Explicit alternatives considered in this decision; consideration is not selection." ;
    rdfs:domain <urn:productium:specification-profile:DecisionRecord> ;
    rdfs:range <urn:productium:specification-profile:SolutionSpecification> .

<urn:product-ontology:trace-profile:0.6:dependencyCondition> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "One authored condition baseline for an atomic dependency specification. Compound conditions can be represented by one authored condition specification." ;
    rdfs:domain <urn:productium:specification-profile:DependencySpecification> ;
    rdfs:range <urn:productium:specification-profile:ConditionSpecification> .

<urn:productium:specification-profile:BusinessRuleReference> a owl:Class ;
    rdfs:label "BusinessRuleReference" ;
    rdfs:comment "A local reference artifact to an externally governed business rule. Its business-rule purpose is constitutive to the authored reference record, not a temporary role of the target." ;
    rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:productium:specification-profile:ConstraintSpecification> a owl:Class ;
    rdfs:label "ConstraintSpecification" ;
    rdfs:comment "An authored ConditionSpecification whose constitutive content includes restriction constitutive to the authored specification. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence." ;
    rdfs:subClassOf <urn:productium:specification-profile:ConditionSpecification> .

<urn:productium:specification-profile:PrioritizationCriterionSpecification> a owl:Class ;
    rdfs:label "PrioritizationCriterionSpecification" ;
    rdfs:comment "A decision-criterion specification whose constitutive purpose is to justify or compute a planning rank." ;
    rdfs:subClassOf <urn:productium:specification-profile:DecisionCriterionSpecification> .

<urn:productium:specification-profile:ProductFamilyReference> a owl:Class ;
    rdfs:label "ProductFamilyReference" ;
    rdfs:comment "A local reference artifact identifying a product-family target governed by an external owner. Its product-family purpose is constitutive to the authored reference record, not a temporary role of the target." ;
    rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:productium:specification-profile:QualityRequirementSpecification> a owl:Class ;
    rdfs:label "QualityRequirementSpecification" ;
    rdfs:comment "A requirement specification with an essential normative commitment about a measurable quality under defined conditions." ;
    rdfs:subClassOf <urn:productium:specification-profile:RequirementSpecification> .

<urn:productium:specification-profile:RequirementScenarioSpecification> a owl:Class ;
    rdfs:label "RequirementScenarioSpecification" ;
    rdfs:comment "An authored ScenarioSpecification whose constitutive content includes requirement/acceptance illustration. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence." ;
    rdfs:subClassOf <urn:productium:specification-profile:ScenarioSpecification> .

<urn:productium:specification-profile:RequirementSourceReference> a owl:Class ;
    rdfs:label "RequirementSourceReference" ;
    rdfs:comment "A local provenance reference artifact identifying an origin used in deriving a requirement specification. Its requirement-source purpose is constitutive to the authored reference record, not a temporary role of the target." ;
    rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:productium:specification-profile:TargetMarketReference> a owl:Class ;
    rdfs:label "TargetMarketReference" ;
    rdfs:comment "A local reference artifact to an externally governed target market. Its target-market purpose is constitutive to the authored reference record, not a temporary role of the target." ;
    rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:productium:specification-profile:TargetSegmentReference> a owl:Class ;
    rdfs:label "TargetSegmentReference" ;
    rdfs:comment "A local reference artifact to an externally governed segment in an identified segmentation context. Its target-segment purpose is constitutive to the authored reference record, not a temporary role of the target." ;
    rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> .

<urn:productium:specification-profile:VerificationEvidenceRecord> a owl:Class ;
    rdfs:label "VerificationEvidenceRecord" ;
    rdfs:comment "An evidence-attribution record whose constitutive assessment purpose is verification." ;
    rdfs:subClassOf <urn:productium:specification-profile:EvidenceAttributionRecord> .

<urn:productium:specification-profile:canonicalOwner> a owl:ObjectProperty ;
    rdfs:domain <urn:productium:specification-profile:ExternalReferenceRecord> .

