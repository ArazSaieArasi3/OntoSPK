    rdfs:range <urn:productium:specification-profile:DecisionRecord> .

<urn:product-ontology:trace-profile:0.6:changeFeature> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Recorded feature subject of an asserted modification; exclusive with changeScope. No actual implementation change is inferred." ;
    rdfs:domain <urn:productium:specification-profile:ChangeRecord> ;
    rdfs:range <urn:productium:specification-profile:FeatureSpecification> .

<urn:product-ontology:trace-profile:0.6:changeOccurrenceReference> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Recorded identifier for the asserted modification occurrence; not a fabricated event individual." ;
    rdfs:domain <urn:productium:specification-profile:ChangeRecord> ;
    rdfs:range xsd:anyURI .

<urn:product-ontology:trace-profile:0.6:changeRecordedAt> a owl:DatatypeProperty,
