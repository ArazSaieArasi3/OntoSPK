    rdfs:range xsd:dateTime .

<urn:product-ontology:trace-profile:0.6:changeScope> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Recorded scope subject of an asserted modification; exclusive with changeFeature in this bounded reporting profile." ;
    rdfs:domain <urn:productium:specification-profile:ChangeRecord> ;
    rdfs:range <urn:productium:specification-profile:ScopeSpecification> .

<urn:product-ontology:trace-profile:0.6:changeSource> a owl:DatatypeProperty ;
    rdfs:comment "Source provenance of the change assertion." ;
