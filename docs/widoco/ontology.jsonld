  {
    "@id": "urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An authored specification fixing the applicability boundary of an assessment, including its stated population, environment and temporal conditions, with optional version and scenario bindings."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Assessment Context Specification"
      }
    ],
