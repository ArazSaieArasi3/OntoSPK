    "@value" : "A recorded change description for this scope baseline. It does not establish an applied implementation change."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:ScopeSpecification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "urn:productium:specification-profile:ChangeRecord"
  } ]
}, {
  "@id" : "urn:product-ontology:assessment-profile:0.4:scopeSource",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Recorded source of the authored scope baseline."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:ScopeSpecification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#anyURI"
  } ]
}, {
  "@id" : "urn:product-ontology:assessment-profile:0.4:scopeSupersedes",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#AsymmetricProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Recorded directed scope-baseline revision; branching and merging permitted, cycles forbidden."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:ScopeSpecification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "urn:productium:specification-profile:ScopeSpecification"
  } ]
}, {
  "@id" : "urn:product-ontology:assessment-profile:0.4:versionScope",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "At most one consolidated authored scope baseline per product version. Unrecorded scope is allowed; partial documents must be consolidated or this contract revised."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:ProductVersion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "urn:productium:specification-profile:ScopeSpecification"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An immutable dated information record assigning a status code under a stated scheme to one delivery work item, optionally qualified by one product version."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Delivery Work Item Status Record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid8"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "urn:productium:specification-profile:DeliveryStatusRecord"
  }, {
    "@id" : "urn:productium:specification-profile:DeliveryWorkItem"
  }, {
    "@id" : "urn:productium:specification-profile:ProductCapability"
  }, {
    "@id" : "urn:productium:specification-profile:ProductRealization"
  }, {
    "@id" : "urn:productium:specification-profile:ProductVersion"
  }, {
    "@id" : "urn:productium:specification-profile:ReleaseSpecification"
  }, {
    "@id" : "urn:productium:specification-profile:TestExecution"
  }, {
    "@id" : "urn:productium:specification-profile:TestResult"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:executionContext",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "One fixed assessment applicability context for a concluded test occurrence. Repeated or differently contextualized runs are separate events."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:TestExecution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:executionCriterion",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Explicit assessment criteria evaluated during the run. Case membership and shared labels do not establish criterion coverage."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:TestExecution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "urn:productium:specification-profile:ConditionSpecification"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:executionEndedAt",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "End of a concluded run, including an aborted run. Ongoing runs are outside this completed-event profile."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:TestExecution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:itemStatus",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#InverseFunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "One item owns each status assertion; an item may have no record or many historical records. Release membership never propagates status."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:DeliveryWorkItem"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:itemStatusChange",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Explicit change records cited by this work-item assertion; no applied-change entailment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "urn:productium:specification-profile:ChangeRecord"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:itemStatusCode",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Recorded code under the named workflow scheme; it is not proof of delivery."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:itemStatusReportedAt",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Time of this immutable report, not automatically the time of delivery."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:itemStatusScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Identifier of the interpretation scheme; this ontology does not impose a universal delivery lifecycle."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#anyURI"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:itemStatusSource",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Recorded report provenance, distinct from a workflow code."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#anyURI"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:itemStatusVersion",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Optional exact baseline qualifier of this work-item assertion; changing a qualifier creates another record."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "urn:productium:specification-profile:ProductVersion"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:observedAuthority",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Observed authority identifier; required and different from the old authority for authority_changed findings."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:FindingRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#anyURI"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:observedTarget",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Observed target identifier; required and different from the old target for target_changed findings."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:FindingRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#anyURI"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:referenceRecordedAt",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Recorded creation time of this fixed reference binding."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:ExternalReferenceRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:referenceReviewFinding",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#InverseFunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A recorded review finding concerns at most one reference under this reporting profile. Several findings can concern one reference; ordinary findings need not concern any reference."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:ExternalReferenceRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "urn:productium:specification-profile:FindingRecord"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:referenceRevisionLabel",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Optional authored revision label. A label alone does not establish freshness or a successor."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:ExternalReferenceRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:referenceSupersedes",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#AsymmetricProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An explicit successor reference record replaces an earlier recorded binding for its stated purpose. Branching is permitted; cycles are forbidden. No mutation or automatic identity merge."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:ExternalReferenceRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "urn:productium:specification-profile:ExternalReferenceRecord"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:releaseStatusChange",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Explicit change records cited by this release-status assertion. This link does not mean an implementation change occurred."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:DeliveryStatusRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "urn:productium:specification-profile:ChangeRecord"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:releaseStatusCode",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Recorded code under the named workflow scheme; it is not proof of delivery."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:DeliveryStatusRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:releaseStatusReportedAt",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Time of this immutable report, not automatically the time of delivery."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:DeliveryStatusRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:releaseStatusScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Identifier of the interpretation scheme; this ontology does not impose a universal delivery lifecycle."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:DeliveryStatusRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#anyURI"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:releaseStatusSource",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Recorded report provenance, distinct from a workflow code."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:DeliveryStatusRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#anyURI"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:releaseStatusVersion",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Optional exact baseline qualifier of this immutable release-status assertion. Unqualified records are not copied to versions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:DeliveryStatusRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "urn:productium:specification-profile:ProductVersion"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:resultOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Local reporting code: passed, failed, aborted, inconclusive or unknown. A recorded pass does not entail claim truth or acceptance."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:TestResult"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:resultRecordedAt",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Report time at or after the recorded execution end."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:TestResult"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:resultSource",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Source identifier of the recorded execution result."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:TestResult"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#anyURI"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:reviewReason",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "For reference-review findings only: target_changed, authority_changed, target_unreachable or scheduled_review."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:FindingRecord"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "urn:product-ontology:delivery-profile:0.5:reviewRecordedAt",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Required for a reference-review finding; observations must not predate the referenced binding."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "urn:productium:specification-profile:FindingRecord"
