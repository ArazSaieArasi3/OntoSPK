      },
      {
        "@id": "urn:productium:specification-profile:ScenarioSpecification"
      },
      {
        "@id": "urn:productium:specification-profile:ScopeSpecification"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:assessment-profile:0.4:attributionAgent",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Recorded assessor identifier. An identifier is operational metadata, not a new Agent concept or a verified identity."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:EvidenceAttributionRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:assessment-profile:0.4:attributionSource",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Recorded source URI; kept separate from the assessor identifier and from evidence ownership."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:EvidenceAttributionRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:assessment-profile:0.4:attributionStance",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One of supports, challenges, limits, unassessed. Stance belongs to the record, never globally to its carrier."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:EvidenceAttributionRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:assessment-profile:0.4:attributionTimestamp",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Time of the recorded attribution. Does not establish when the evidence carrier was generated."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:EvidenceAttributionRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:assessment-profile:0.4:claimActualCapability",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The actual capability under assessment. Paired with claimIntendedCapability; not a satisfaction assertion."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:AssessmentClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "urn:productium:specification-profile:ProductCapability"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:assessment-profile:0.4:claimContext",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One fixed applicability context; sharing a context does not imply sharing a claim."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:AssessmentClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:assessment-profile:0.4:claimCriterion",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One atomic assessment criterion. Compound criteria must have an explicit condition specification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:AssessmentClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "urn:productium:specification-profile:ConditionSpecification"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:assessment-profile:0.4:claimIntendedCapability",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The intended ability compared in this claim. No intended-to-actual entailment is introduced."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:AssessmentClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "urn:productium:specification-profile:CapabilitySpecification"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:assessment-profile:0.4:claimProduct",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A product-lineage subject. Exactly one subject is selected across the four subject relations."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:AssessmentClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "urn:productium:specification-profile:Product"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "urn:product-ontology:assessment-profile:0.4:claimSubject"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:assessment-profile:0.4:claimRealization",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A concrete realization subject; capability assessments use this subject relation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
