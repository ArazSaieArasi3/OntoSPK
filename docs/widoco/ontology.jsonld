      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:delivery-profile:0.5:referenceRecordedAt",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Recorded creation time of this fixed reference binding."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:ExternalReferenceRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:delivery-profile:0.5:referenceReviewFinding",
    "@type": [
      "http://www.w3.org/2002/07/owl#InverseFunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A recorded review finding concerns at most one reference under this reporting profile. Several findings can concern one reference; ordinary findings need not concern any reference."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:ExternalReferenceRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "urn:productium:specification-profile:FindingRecord"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:delivery-profile:0.5:referenceRevisionLabel",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Optional authored revision label. A label alone does not establish freshness or a successor."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:ExternalReferenceRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:delivery-profile:0.5:referenceSupersedes",
    "@type": [
      "http://www.w3.org/2002/07/owl#AsymmetricProperty",
      "http://www.w3.org/2002/07/owl#IrreflexiveProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "An explicit successor reference record replaces an earlier recorded binding for its stated purpose. Branching is permitted; cycles are forbidden. No mutation or automatic identity merge."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "urn:productium:specification-profile:ExternalReferenceRecord"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "urn:productium:specification-profile:ExternalReferenceRecord"
      }
    ]
  },
  {
    "@id": "urn:product-ontology:delivery-profile:0.5:releaseStatusChange",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Explicit change records cited by this release-status assertion. This link does not mean an implementation change occurred."
      }
