@prefix : <urn:productium:specification-profile:#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <urn:productium:specification-profile:#> .

<urn:productium:specification-profile:> rdf:type owl:Ontology ;
                                         owl:versionInfo "IC-0.7 authored specification identity candidate" .

#################################################################
#    Object Properties
#################################################################

###  urn:product-ontology:assessment-profile:0.4:claimActualCapability
<urn:product-ontology:assessment-profile:0.4:claimActualCapability> rdf:type owl:ObjectProperty ,
                                                                             owl:FunctionalProperty ;
                                                                    rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
                                                                    rdfs:range <urn:productium:specification-profile:ProductCapability> ;
                                                                    rdfs:comment "The actual capability under assessment. Paired with claimIntendedCapability; not a satisfaction assertion." .


###  urn:product-ontology:assessment-profile:0.4:claimContext
<urn:product-ontology:assessment-profile:0.4:claimContext> rdf:type owl:ObjectProperty ,
                                                                    owl:FunctionalProperty ;
                                                           rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
                                                           rdfs:range <urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> ;
                                                           rdfs:comment "One fixed applicability context; sharing a context does not imply sharing a claim." .


###  urn:product-ontology:assessment-profile:0.4:claimCriterion
<urn:product-ontology:assessment-profile:0.4:claimCriterion> rdf:type owl:ObjectProperty ,
                                                                      owl:FunctionalProperty ;
                                                             rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
                                                             rdfs:range <urn:productium:specification-profile:ConditionSpecification> ;
                                                             rdfs:comment "One atomic assessment criterion. Compound criteria must have an explicit condition specification." .


###  urn:product-ontology:assessment-profile:0.4:claimIntendedCapability
<urn:product-ontology:assessment-profile:0.4:claimIntendedCapability> rdf:type owl:ObjectProperty ,
                                                                               owl:FunctionalProperty ;
                                                                      rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
                                                                      rdfs:range <urn:productium:specification-profile:CapabilitySpecification> ;
                                                                      rdfs:comment "The intended ability compared in this claim. No intended-to-actual entailment is introduced." .


###  urn:product-ontology:assessment-profile:0.4:claimProduct
<urn:product-ontology:assessment-profile:0.4:claimProduct> rdf:type owl:ObjectProperty ;
                                                           rdfs:subPropertyOf <urn:product-ontology:assessment-profile:0.4:claimSubject> ;
                                                           rdf:type owl:FunctionalProperty ;
                                                           rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
                                                           rdfs:range <urn:productium:specification-profile:Product> ;
                                                           rdfs:comment "A product-lineage subject. Exactly one subject is selected across the four subject relations." .


###  urn:product-ontology:assessment-profile:0.4:claimRealization
<urn:product-ontology:assessment-profile:0.4:claimRealization> rdf:type owl:ObjectProperty ;
                                                               rdfs:subPropertyOf <urn:product-ontology:assessment-profile:0.4:claimSubject> ;
                                                               rdf:type owl:FunctionalProperty ;
                                                               rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
                                                               rdfs:range <urn:productium:specification-profile:ProductRealization> ;
                                                               rdfs:comment "A concrete realization subject; capability assessments use this subject relation." .


###  urn:product-ontology:assessment-profile:0.4:claimRequirement
<urn:product-ontology:assessment-profile:0.4:claimRequirement> rdf:type owl:ObjectProperty ;
                                                               rdfs:subPropertyOf <urn:product-ontology:assessment-profile:0.4:claimSubject> ;
                                                               rdf:type owl:FunctionalProperty ;
                                                               rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
                                                               rdfs:range <urn:productium:specification-profile:RequirementSpecification> ;
                                                               rdfs:comment "An authored requirement subject, not the stakeholder intention." .


###  urn:product-ontology:assessment-profile:0.4:claimSubject
<urn:product-ontology:assessment-profile:0.4:claimSubject> rdf:type owl:ObjectProperty ,
                                                                    owl:FunctionalProperty ;
                                                           rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
                                                           rdfs:range [ rdf:type owl:Class ;
                                                                        owl:unionOf ( <urn:productium:specification-profile:Product>
                                                                                      <urn:productium:specification-profile:ProductRealization>
                                                                                      <urn:productium:specification-profile:ProductVersion>
                                                                                      <urn:productium:specification-profile:RequirementSpecification>
                                                                                    )
                                                                      ] .


###  urn:product-ontology:assessment-profile:0.4:claimVersion
<urn:product-ontology:assessment-profile:0.4:claimVersion> rdf:type owl:ObjectProperty ;
                                                           rdfs:subPropertyOf <urn:product-ontology:assessment-profile:0.4:claimSubject> ;
                                                           rdf:type owl:FunctionalProperty ;
                                                           rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
                                                           rdfs:range <urn:productium:specification-profile:ProductVersion> ;
                                                           rdfs:comment "A specification-baseline subject; not an implemented system." .


###  urn:product-ontology:assessment-profile:0.4:contextScenario
<urn:product-ontology:assessment-profile:0.4:contextScenario> rdf:type owl:ObjectProperty ;
                                                              rdfs:domain <urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> ;
                                                              rdfs:range <urn:productium:specification-profile:ScenarioSpecification> ;
                                                              rdfs:comment "Optional reuse of authored scenario details without equating context and scenario identity." .


###  urn:product-ontology:assessment-profile:0.4:contextVersion
<urn:product-ontology:assessment-profile:0.4:contextVersion> rdf:type owl:ObjectProperty ,
                                                                      owl:FunctionalProperty ;
                                                             rdfs:domain <urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> ;
                                                             rdfs:range <urn:productium:specification-profile:ProductVersion> ;
                                                             rdfs:comment "Optional baseline qualifier of the context, mandatory for a capability assessment in the reporting profile." .


###  urn:product-ontology:assessment-profile:0.4:scopeChangeRecord
<urn:product-ontology:assessment-profile:0.4:scopeChangeRecord> rdf:type owl:ObjectProperty ;
                                                                rdfs:domain <urn:productium:specification-profile:ScopeSpecification> ;
                                                                rdfs:range <urn:productium:specification-profile:ChangeRecord> ;
                                                                rdfs:comment "A recorded change description for this scope baseline. It does not establish an applied implementation change." .


###  urn:product-ontology:assessment-profile:0.4:scopeSupersedes
<urn:product-ontology:assessment-profile:0.4:scopeSupersedes> rdf:type owl:ObjectProperty ,
                                                                       owl:AsymmetricProperty ,
                                                                       owl:IrreflexiveProperty ;
                                                              rdfs:domain <urn:productium:specification-profile:ScopeSpecification> ;
                                                              rdfs:range <urn:productium:specification-profile:ScopeSpecification> ;
                                                              rdfs:comment "Recorded directed scope-baseline revision; branching and merging permitted, cycles forbidden." .


###  urn:product-ontology:assessment-profile:0.4:versionScope
<urn:product-ontology:assessment-profile:0.4:versionScope> rdf:type owl:ObjectProperty ,
                                                                    owl:FunctionalProperty ;
                                                           rdfs:domain <urn:productium:specification-profile:ProductVersion> ;
                                                           rdfs:range <urn:productium:specification-profile:ScopeSpecification> ;
                                                           rdfs:comment "At most one consolidated authored scope baseline per product version. Unrecorded scope is allowed; partial documents must be consolidated or this contract revised." .


###  urn:product-ontology:delivery-profile:0.5:executionContext
<urn:product-ontology:delivery-profile:0.5:executionContext> rdf:type owl:ObjectProperty ,
                                                                      owl:FunctionalProperty ;
                                                             rdfs:domain <urn:productium:specification-profile:TestExecution> ;
                                                             rdfs:range <urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> ;
                                                             rdfs:comment "One fixed assessment applicability context for a concluded test occurrence. Repeated or differently contextualized runs are separate events." .


###  urn:product-ontology:delivery-profile:0.5:executionCriterion
<urn:product-ontology:delivery-profile:0.5:executionCriterion> rdf:type owl:ObjectProperty ;
                                                               rdfs:domain <urn:productium:specification-profile:TestExecution> ;
                                                               rdfs:range <urn:productium:specification-profile:ConditionSpecification> ;
                                                               rdfs:comment "Explicit assessment criteria evaluated during the run. Case membership and shared labels do not establish criterion coverage." .


###  urn:product-ontology:delivery-profile:0.5:itemStatus
<urn:product-ontology:delivery-profile:0.5:itemStatus> rdf:type owl:ObjectProperty ,
                                                                owl:InverseFunctionalProperty ;
                                                       rdfs:domain <urn:productium:specification-profile:DeliveryWorkItem> ;
                                                       rdfs:range <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
                                                       rdfs:comment "One item owns each status assertion; an item may have no record or many historical records. Release membership never propagates status." .


###  urn:product-ontology:delivery-profile:0.5:itemStatusChange
<urn:product-ontology:delivery-profile:0.5:itemStatusChange> rdf:type owl:ObjectProperty ;
                                                             rdfs:domain <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
                                                             rdfs:range <urn:productium:specification-profile:ChangeRecord> ;
                                                             rdfs:comment "Explicit change records cited by this work-item assertion; no applied-change entailment." .


###  urn:product-ontology:delivery-profile:0.5:itemStatusVersion
<urn:product-ontology:delivery-profile:0.5:itemStatusVersion> rdf:type owl:ObjectProperty ,
                                                                       owl:FunctionalProperty ;
                                                              rdfs:domain <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
                                                              rdfs:range <urn:productium:specification-profile:ProductVersion> ;
                                                              rdfs:comment "Optional exact baseline qualifier of this work-item assertion; changing a qualifier creates another record." .


###  urn:product-ontology:delivery-profile:0.5:referenceReviewFinding
<urn:product-ontology:delivery-profile:0.5:referenceReviewFinding> rdf:type owl:ObjectProperty ,
                                                                            owl:InverseFunctionalProperty ;
                                                                   rdfs:domain <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                                   rdfs:range <urn:productium:specification-profile:FindingRecord> ;
                                                                   rdfs:comment "A recorded review finding concerns at most one reference under this reporting profile. Several findings can concern one reference; ordinary findings need not concern any reference." .


###  urn:product-ontology:delivery-profile:0.5:referenceSupersedes
<urn:product-ontology:delivery-profile:0.5:referenceSupersedes> rdf:type owl:ObjectProperty ,
                                                                         owl:AsymmetricProperty ,
                                                                         owl:IrreflexiveProperty ;
                                                                rdfs:domain <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                                rdfs:range <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                                rdfs:comment "An explicit successor reference record replaces an earlier recorded binding for its stated purpose. Branching is permitted; cycles are forbidden. No mutation or automatic identity merge." .


###  urn:product-ontology:delivery-profile:0.5:releaseStatusChange
<urn:product-ontology:delivery-profile:0.5:releaseStatusChange> rdf:type owl:ObjectProperty ;
                                                                rdfs:domain <urn:productium:specification-profile:DeliveryStatusRecord> ;
                                                                rdfs:range <urn:productium:specification-profile:ChangeRecord> ;
                                                                rdfs:comment "Explicit change records cited by this release-status assertion. This link does not mean an implementation change occurred." .


###  urn:product-ontology:delivery-profile:0.5:releaseStatusVersion
<urn:product-ontology:delivery-profile:0.5:releaseStatusVersion> rdf:type owl:ObjectProperty ,
                                                                          owl:FunctionalProperty ;
                                                                 rdfs:domain <urn:productium:specification-profile:DeliveryStatusRecord> ;
                                                                 rdfs:range <urn:productium:specification-profile:ProductVersion> ;
                                                                 rdfs:comment "Optional exact baseline qualifier of this immutable release-status assertion. Unqualified records are not copied to versions." .


###  urn:product-ontology:relation-profile:0.7:architecture_intendedRealizedByComponent
<urn:product-ontology:relation-profile:0.7:architecture_intendedRealizedByComponent> rdf:type owl:ObjectProperty ;
                                                                                     rdfs:domain <urn:productium:specification-profile:FeatureSpecification> ;
                                                                                     rdfs:range <urn:product-ontology:external-boundary:0.7:Architecture%3AComponent> ;
                                                                                     rdfs:comment "The feature specification explicitly names an external component as a proposed realization target." ;
                                                                                     rdfs:label "intendedRealizedByComponent" .


###  urn:product-ontology:relation-profile:0.7:architecture_intendedRealizedByService
<urn:product-ontology:relation-profile:0.7:architecture_intendedRealizedByService> rdf:type owl:ObjectProperty ;
                                                                                   rdfs:domain <urn:productium:specification-profile:FeatureSpecification> ;
                                                                                   rdfs:range <urn:product-ontology:external-boundary:0.7:Architecture%3AService> ;
                                                                                   rdfs:comment "The feature specification names an external service as a proposed realization target." ;
                                                                                   rdfs:label "intendedRealizedByService" .


###  urn:product-ontology:relation-profile:0.7:architecture_intendedSatisfiedByArchitectureElement
<urn:product-ontology:relation-profile:0.7:architecture_intendedSatisfiedByArchitectureElement> rdf:type owl:ObjectProperty ;
                                                                                                rdfs:domain <urn:productium:specification-profile:RequirementSpecification> ;
                                                                                                rdfs:range <urn:product-ontology:external-boundary:0.7:Architecture%3AArchitectureElement> ;
                                                                                                rdfs:comment "The requirement specification records an intended architectural satisfaction allocation." ;
                                                                                                rdfs:label "intendedSatisfiedByArchitectureElement" .


###  urn:product-ontology:relation-profile:0.7:architecture_intendedSatisfiedByInterface
<urn:product-ontology:relation-profile:0.7:architecture_intendedSatisfiedByInterface> rdf:type owl:ObjectProperty ;
                                                                                      rdfs:domain <urn:productium:specification-profile:RequirementSpecification> ;
                                                                                      rdfs:range <urn:product-ontology:external-boundary:0.7:Architecture%3AInterface> ;
                                                                                      rdfs:comment "The requirement specification records an intended satisfaction allocation to an external interface." ;
                                                                                      rdfs:label "intendedSatisfiedByInterface" .


###  urn:product-ontology:relation-profile:0.7:architecture_intendedSupportedByArchitectureElement
<urn:product-ontology:relation-profile:0.7:architecture_intendedSupportedByArchitectureElement> rdf:type owl:ObjectProperty ;
                                                                                                rdfs:domain <urn:productium:specification-profile:CapabilitySpecification> ;
                                                                                                rdfs:range <urn:product-ontology:external-boundary:0.7:Architecture%3AArchitectureElement> ;
                                                                                                rdfs:comment "The intended capability specification identifies an architectural element proposed to support it." ;
                                                                                                rdfs:label "intendedSupportedByArchitectureElement" .


###  urn:product-ontology:relation-profile:0.7:r107_intendedToSupport
<urn:product-ontology:relation-profile:0.7:r107_intendedToSupport> rdf:type owl:ObjectProperty ;
                                                                   rdfs:domain <urn:productium:specification-profile:CapabilitySpecification> ;
                                                                   rdfs:range <urn:product-ontology:external-boundary:0.7:Business%3ABusinessCapability> ;
                                                                   rdfs:comment "The capability specification records an intention to support an externally governed business capability." ;
                                                                   rdfs:label "intendedToSupport" .


###  urn:product-ontology:relation-profile:0.7:r116_references
<urn:product-ontology:relation-profile:0.7:r116_references> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <urn:productium:specification-profile:PositioningStatement> ;
                                                            rdfs:range <urn:product-ontology:external-boundary:0.7:Business%3AValueProposition> ;
                                                            rdfs:comment "The positioning statement explicitly cites an externally governed value proposition." ;
                                                            rdfs:label "references" .


###  urn:product-ontology:relation-profile:0.7:r157_evidencedBy
<urn:product-ontology:relation-profile:0.7:r157_evidencedBy> rdf:type owl:ObjectProperty ;
                                                             rdfs:domain <urn:productium:specification-profile:ProblemStatement> ;
                                                             rdfs:range <urn:product-ontology:external-boundary:0.7:EvidenceLayer%3AEvidence> ;
                                                             rdfs:comment "The problem statement explicitly cites external evidence offered for its formulation, without asserting that its claim is true." ;
                                                             rdfs:label "evidencedBy" .


###  urn:product-ontology:relation-profile:0.7:r160_evidencedBy
<urn:product-ontology:relation-profile:0.7:r160_evidencedBy> rdf:type owl:ObjectProperty ;
                                                             rdfs:domain <urn:productium:specification-profile:HypothesisSpecification> ;
                                                             rdfs:range <urn:product-ontology:external-boundary:0.7:EvidenceLayer%3AEvidence> ;
                                                             rdfs:comment "The hypothesis specification explicitly cites external evidence offered in assessing its proposition." ;
                                                             rdfs:label "evidencedBy" .


###  urn:product-ontology:relation-profile:0.7:r162_evidencedBy
<urn:product-ontology:relation-profile:0.7:r162_evidencedBy> rdf:type owl:ObjectProperty ;
                                                             rdfs:domain <urn:productium:specification-profile:ProductMarketFitAssessment> ;
                                                             rdfs:range <urn:product-ontology:external-boundary:0.7:EvidenceLayer%3AEvidence> ;
                                                             rdfs:comment "The product-market-fit assessment cites external evidence informing its recorded assessment." ;
                                                             rdfs:label "evidencedBy" .


###  urn:product-ontology:relation-profile:0.7:r167_supports
<urn:product-ontology:relation-profile:0.7:r167_supports> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <urn:productium:specification-profile:QualityRequirementSpecification> ;
                                                          rdfs:range <urn:product-ontology:external-boundary:0.7:Business%3ABusinessGoal> ;
                                                          rdfs:comment "The quality requirement records an intended contribution to an external business goal." ;
                                                          rdfs:label "supports" .


###  urn:product-ontology:relation-profile:0.7:r185_referencesValueProposition
<urn:product-ontology:relation-profile:0.7:r185_referencesValueProposition> rdf:type owl:ObjectProperty ;
                                                                            rdfs:domain <urn:productium:specification-profile:Product> ;
                                                                            rdfs:range <urn:product-ontology:external-boundary:0.7:Business%3AValueProposition> ;
                                                                            rdfs:comment "The product has an explicit knowledge link to an externally governed value proposition." ;
                                                                            rdfs:label "referencesValueProposition" .


###  urn:product-ontology:relation-profile:0.7:r186_targets
<urn:product-ontology:relation-profile:0.7:r186_targets> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <urn:productium:specification-profile:OfferingSpecification> ;
                                                         rdfs:range <urn:product-ontology:external-boundary:0.7:Market%3ACustomerSegment> ;
                                                         rdfs:comment "The offering specification identifies an external segment in its intended audience." ;
                                                         rdfs:label "targets" .


###  urn:product-ontology:relation-profile:0.7:r187_includesService
<urn:product-ontology:relation-profile:0.7:r187_includesService> rdf:type owl:ObjectProperty ;
                                                                 rdfs:domain <urn:productium:specification-profile:OfferingSpecification> ;
                                                                 rdfs:range <urn:product-ontology:external-boundary:0.7:Business%3AService> ;
                                                                 rdfs:comment "The offering specification describes an external service as included in the intended offer; it does not assert an executed service event." ;
                                                                 rdfs:label "includesService" .


###  urn:product-ontology:relation-profile:0.7:r188_referencesVariantConfiguration
<urn:product-ontology:relation-profile:0.7:r188_referencesVariantConfiguration> rdf:type owl:ObjectProperty ;
                                                                                rdfs:domain <urn:productium:specification-profile:ProductVariantReference> ;
                                                                                rdfs:range <urn:product-ontology:external-boundary:0.7:ProductLine%3AProductConfiguration> ;
                                                                                rdfs:comment "The local variant reference records an external configuration relevant to its fixed variant referent; the reference record itself is not configured by that target." ;
                                                                                rdfs:label "referencesVariantConfiguration" .


###  urn:product-ontology:relation-profile:0.7:r189_targets
<urn:product-ontology:relation-profile:0.7:r189_targets> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <urn:productium:specification-profile:VisionStatement> ;
                                                         rdfs:range <urn:product-ontology:external-boundary:0.7:Market%3ACustomerSegment> ;
                                                         rdfs:comment "The vision statement identifies an external segment within its intended audience." ;
                                                         rdfs:label "targets" .


###  urn:product-ontology:relation-profile:0.7:r190_referencesValueProposition
<urn:product-ontology:relation-profile:0.7:r190_referencesValueProposition> rdf:type owl:ObjectProperty ;
                                                                            rdfs:domain <urn:productium:specification-profile:VisionStatement> ;
                                                                            rdfs:range <urn:product-ontology:external-boundary:0.7:Business%3AValueProposition> ;
                                                                            rdfs:comment "The vision statement explicitly cites an external value proposition." ;
                                                                            rdfs:label "referencesValueProposition" .


###  urn:product-ontology:relation-profile:0.7:r192_references
<urn:product-ontology:relation-profile:0.7:r192_references> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <urn:productium:specification-profile:ProblemSolutionFitAssessment> ;
                                                            rdfs:range <urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3AEvidence> ;
                                                            rdfs:comment "The problem-solution-fit assessment cites external evidence considered in its recorded appraisal." ;
                                                            rdfs:label "references" .


###  urn:product-ontology:relation-profile:0.7:r194_referencesMentalModel
<urn:product-ontology:relation-profile:0.7:r194_referencesMentalModel> rdf:type owl:ObjectProperty ;
                                                                       rdfs:domain <urn:productium:specification-profile:InformationArchitectureSpecification> ;
                                                                       rdfs:range <urn:product-ontology:external-boundary:0.7:UXResearch%3AUser_Mental_Model> ;
                                                                       rdfs:comment "The information-architecture specification cites an externally governed user mental model as a design input." ;
                                                                       rdfs:label "referencesMentalModel" .


###  urn:product-ontology:relation-profile:0.7:r195_usesScript
<urn:product-ontology:relation-profile:0.7:r195_usesScript> rdf:type owl:ObjectProperty ;
                                                            rdfs:domain <urn:productium:specification-profile:TestCase> ;
                                                            rdfs:range <urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3ATest_Script> ;
                                                            rdfs:comment "The test-case specification references an external test script prescribed for its procedure; this is not evidence of execution." ;
                                                            rdfs:label "usesScript" .


###  urn:product-ontology:relation-profile:0.7:r196_reportedUnderTestPlan
<urn:product-ontology:relation-profile:0.7:r196_reportedUnderTestPlan> rdf:type owl:ObjectProperty ;
                                                                       rdfs:domain <urn:productium:specification-profile:TestResult> ;
                                                                       rdfs:range <urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3ATest_Plan> ;
                                                                       rdfs:comment "The test-result record is explicitly reported under an externally governed test plan; this is not a part-whole assertion." ;
                                                                       rdfs:label "reportedUnderTestPlan" .


###  urn:product-ontology:relation-profile:0.7:r197_citesExecutionScript
<urn:product-ontology:relation-profile:0.7:r197_citesExecutionScript> rdf:type owl:ObjectProperty ;
                                                                      rdfs:domain <urn:productium:specification-profile:TestResult> ;
                                                                      rdfs:range <urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3ATest_Script> ;
                                                                      rdfs:comment "The test-result record cites an external script reported as relevant to its recorded execution; the record itself does not execute the script." ;
                                                                      rdfs:label "citesExecutionScript" .


###  urn:product-ontology:relation-profile:0.7:r198_citesSupportingEvidence
<urn:product-ontology:relation-profile:0.7:r198_citesSupportingEvidence> rdf:type owl:ObjectProperty ;
                                                                         rdfs:domain <urn:productium:specification-profile:ValidationEvidenceRecord> ;
                                                                         rdfs:range <urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3AEvidence> ;
                                                                         rdfs:comment "The validation attribution record explicitly cites an additional external evidence item as support for its recorded attribution." ;
                                                                         rdfs:label "citesSupportingEvidence" .


###  urn:product-ontology:relation-profile:0.7:r199_referencesDatasetConfiguration
<urn:product-ontology:relation-profile:0.7:r199_referencesDatasetConfiguration> rdf:type owl:ObjectProperty ;
                                                                                rdfs:domain <urn:productium:specification-profile:TestDataReference> ;
                                                                                rdfs:range <urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3AConfiguration> ;
                                                                                rdfs:comment "The test-data reference records an external configuration of or relevant to its fixed dataset referent." ;
                                                                                rdfs:label "referencesDatasetConfiguration" .


###  urn:product-ontology:relation-profile:0.7:r200_targets
<urn:product-ontology:relation-profile:0.7:r200_targets> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <urn:productium:specification-profile:GoToMarketSpecification> ;
                                                         rdfs:range <urn:product-ontology:external-boundary:0.7:Market%3ACustomerSegment> ;
                                                         rdfs:comment "The go-to-market specification records an externally governed customer segment as an intended audience." ;
                                                         rdfs:label "targets" .


###  urn:product-ontology:relation-profile:0.7:r201_targets
<urn:product-ontology:relation-profile:0.7:r201_targets> rdf:type owl:ObjectProperty ;
                                                         rdfs:domain <urn:productium:specification-profile:GoToMarketSpecification> ;
                                                         rdfs:range <urn:product-ontology:external-boundary:0.7:Market%3AMarket> ;
                                                         rdfs:comment "The go-to-market specification records an externally governed market as intended scope." ;
