###  urn:productium:specification-profile:AcceptanceCriterionSpecification
<urn:productium:specification-profile:AcceptanceCriterionSpecification> rdf:type owl:Class ;
                                                                        rdfs:subClassOf <urn:productium:specification-profile:ConditionSpecification> ;
                                                                        rdfs:comment "An authored ConditionSpecification whose constitutive content includes condition used in the authored acceptance contract. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence." ;
                                                                        rdfs:label "AcceptanceCriterionSpecification" .


###  urn:productium:specification-profile:AcquisitionHypothesisSpecification
<urn:productium:specification-profile:AcquisitionHypothesisSpecification> rdf:type owl:Class ;
                                                                          rdfs:subClassOf <urn:productium:specification-profile:HypothesisSpecification> ;
                                                                          rdfs:comment "A hypothesis specification whose constitutive claim concerns acquiring intended users or customers." ;
                                                                          rdfs:label "AcquisitionHypothesisSpecification" .


###  urn:productium:specification-profile:AdoptionHypothesisSpecification
<urn:productium:specification-profile:AdoptionHypothesisSpecification> rdf:type owl:Class ;
                                                                       rdfs:subClassOf <urn:productium:specification-profile:HypothesisSpecification> ;
                                                                       rdfs:comment "A hypothesis specification whose constitutive claim concerns adoption barriers or adoption behavior." ;
                                                                       rdfs:label "AdoptionHypothesisSpecification" .


###  urn:productium:specification-profile:AssessmentClaim
<urn:productium:specification-profile:AssessmentClaim> rdf:type owl:Class ;
                                                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <urn:product-ontology:assessment-profile:0.4:claimContext> ;
                                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <urn:product-ontology:assessment-profile:0.4:claimCriterion> ;
                                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <urn:product-ontology:assessment-profile:0.4:claimSubject> ;
                                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                       ] ;
                                                       owl:disjointWith <urn:productium:specification-profile:EvidenceArtifact> ;
                                                       rdfs:comment "An authored assessment-claim artifact fixing subject, criterion, scope and the proposition under consideration." ;
                                                       rdfs:label "AssessmentClaim" .


###  urn:productium:specification-profile:BundleSpecification
<urn:productium:specification-profile:BundleSpecification> rdf:type owl:Class ;
                                                           rdfs:comment "A governed composition specification referencing offerings intended to be presented together." ;
                                                           rdfs:label "BundleSpecification" .


###  urn:productium:specification-profile:BusinessRuleReference
<urn:productium:specification-profile:BusinessRuleReference> rdf:type owl:Class ;
                                                             rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                             rdfs:comment "A local reference artifact to an externally governed business rule. Its business-rule purpose is constitutive to the authored reference record, not a temporary role of the target." ;
                                                             rdfs:label "BusinessRuleReference" .


###  urn:productium:specification-profile:CapabilitySpecification
<urn:productium:specification-profile:CapabilitySpecification> rdf:type owl:Class ;
                                                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:assessesSpecification>
                                                                                                ] ;
                                                                                 owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:evaluatedAgainst>
                                                                                                ] ;
                                                                                 owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:specifiesCapability>
                                                                                                ] ;
                                                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                               ] ;
                                                               rdfs:comment "A version-scoped specification of an intended ability, irrespective of its implementation." ;
                                                               rdfs:label "CapabilitySpecification" .


###  urn:productium:specification-profile:ChangeProposalSpecification
<urn:productium:specification-profile:ChangeProposalSpecification> rdf:type owl:Class ;
                                                                   rdfs:comment "An authored proposal specifying a desired change and its intended target." ;
                                                                   rdfs:label "ChangeProposalSpecification" .


###  urn:productium:specification-profile:ChangeRecord
<urn:productium:specification-profile:ChangeRecord> rdf:type owl:Class ;
                                                    rdfs:subClassOf <urn:productium:specification-profile:EvidenceArtifact> ;
                                                    rdfs:comment "A dated record describing an asserted modification to an identified product artifact or state." ;
                                                    rdfs:label "ChangeRecord" .


###  urn:productium:specification-profile:CommitmentLevelDefinition
<urn:productium:specification-profile:CommitmentLevelDefinition> rdf:type owl:Class ;
                                                                 rdfs:comment "A governed term definition for a planning-commitment label within a named scheme." ;
                                                                 rdfs:label "CommitmentLevelDefinition" .


###  urn:productium:specification-profile:CompetitiveNarrative
<urn:productium:specification-profile:CompetitiveNarrative> rdf:type owl:Class ;
                                                            rdfs:comment "An authored narrative presenting scoped differentiation claims and their evidential references." ;
                                                            rdfs:label "CompetitiveNarrative" .


###  urn:productium:specification-profile:ConditionSpecification
<urn:productium:specification-profile:ConditionSpecification> rdf:type owl:Class ;
                                                              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <urn:productium:specification-profile:conditionContext> ;
                                                                                owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <urn:productium:specification-profile:specificationProvenance> ;
                                                                                owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <urn:productium:specification-profile:conditionStatement> ;
                                                                                owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                              ] ;
                                                              rdfs:comment "An authored semantic condition unit with a fixed proposition, applicability context and authoring provenance; distinct from a stakeholder intention, observed result or containing scenario." ;
                                                              rdfs:label "ConditionSpecification" .


###  urn:productium:specification-profile:ConfidenceAssessment
<urn:productium:specification-profile:ConfidenceAssessment> rdf:type owl:Class ;
                                                            rdfs:comment "A dated assessment of planning confidence with explicit subject, assessor, evidence context and scale." ;
                                                            rdfs:label "ConfidenceAssessment" .


###  urn:productium:specification-profile:ConstraintSpecification
<urn:productium:specification-profile:ConstraintSpecification> rdf:type owl:Class ;
                                                               rdfs:subClassOf <urn:productium:specification-profile:ConditionSpecification> ;
                                                               rdfs:comment "An authored ConditionSpecification whose constitutive content includes restriction constitutive to the authored specification. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence." ;
                                                               rdfs:label "ConstraintSpecification" .


###  urn:productium:specification-profile:DecisionCriterionSpecification
<urn:productium:specification-profile:DecisionCriterionSpecification> rdf:type owl:Class ;
                                                                      rdfs:comment "An authored rule or criterion specification used to appraise product alternatives." ;
                                                                      rdfs:label "DecisionCriterionSpecification" .


###  urn:productium:specification-profile:DecisionRecord
<urn:productium:specification-profile:DecisionRecord> rdf:type owl:Class ;
                                                      rdfs:comment "An immutable record of a product decision, its considered alternatives, rationale and provenance." ;
                                                      rdfs:label "DecisionRecord" .


###  urn:productium:specification-profile:DeliveryStatusRecord
<urn:productium:specification-profile:DeliveryStatusRecord> rdf:type owl:Class ;
                                                            rdfs:comment "An immutable dated report assigning a delivery-status value to one Release." ;
                                                            rdfs:label "DeliveryStatusRecord" .


###  urn:productium:specification-profile:DeliveryWorkItem
<urn:productium:specification-profile:DeliveryWorkItem> rdf:type owl:Class ;
                                                        rdfs:comment "A governed work-item artifact about intended delivery scope and its referenced functional specifications." ;
                                                        rdfs:label "DeliveryWorkItem" .


###  urn:productium:specification-profile:DependencySpecification
<urn:productium:specification-profile:DependencySpecification> rdf:type owl:Class ;
                                                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <urn:product-ontology:trace-profile:0.6:dependencyCondition> ;
                                                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                               ] ;
                                                               rdfs:comment "An authored claim that one product depends on an identified product, capability or resource under a stated dependency condition." ;
                                                               rdfs:label "DependencySpecification" .


###  urn:productium:specification-profile:EnablerSpecification
<urn:productium:specification-profile:EnablerSpecification> rdf:type owl:Class ;
                                                            rdfs:comment "An authored supporting-work specification intended to enable a feature or capability specification." ;
                                                            rdfs:label "EnablerSpecification" .


###  urn:productium:specification-profile:EvidenceArtifact
<urn:productium:specification-profile:EvidenceArtifact> rdf:type owl:Class ;
                                                        rdfs:comment "An abstract category of information artifacts eligible to carry evidence in this bounded profile." ;
                                                        rdfs:label "EvidenceArtifact" .


###  urn:productium:specification-profile:EvidenceAttributionRecord
<urn:productium:specification-profile:EvidenceAttributionRecord> rdf:type owl:Class ;
                                                                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty <urn:productium:specification-profile:recordsCarrier> ;
                                                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                   owl:onClass <urn:productium:specification-profile:EvidenceArtifact>
                                                                                 ] ,
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty <urn:productium:specification-profile:recordsClaim> ;
                                                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                   owl:onClass <urn:productium:specification-profile:AssessmentClaim>
                                                                                 ] ;
                                                                 rdfs:comment "An information record documenting an assessor's attribution of one carrier to one assessment claim." ;
                                                                 rdfs:label "EvidenceAttributionRecord" .


###  urn:productium:specification-profile:ExternalReferenceRecord
<urn:productium:specification-profile:ExternalReferenceRecord> rdf:type owl:Class ;
                                                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <urn:productium:specification-profile:canonicalOwner> ;
                                                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <urn:productium:specification-profile:referenceProvenance> ;
                                                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <urn:productium:specification-profile:referenceTarget> ;
                                                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                               ] ;
                                                               rdfs:comment "A local information record of a fixed binding to a separately governed referent, with recorded authority, provenance and constitutive purpose set." ;
                                                               rdfs:label "ExternalReferenceRecord" .


###  urn:productium:specification-profile:FeatureFlagSpecification
<urn:productium:specification-profile:FeatureFlagSpecification> rdf:type owl:Class ;
                                                                rdfs:comment "A specification of a named feature-activation control and its intended scoping policy." ;
                                                                rdfs:label "FeatureFlagSpecification" .


###  urn:productium:specification-profile:FeatureSpecification
<urn:productium:specification-profile:FeatureSpecification> rdf:type owl:Class ;
                                                            rdfs:comment "An authored functional-unit specification linking intended behavior, user value and acceptance criteria." ;
                                                            rdfs:label "FeatureSpecification" .


###  urn:productium:specification-profile:FindingRecord
<urn:productium:specification-profile:FindingRecord> rdf:type owl:Class ;
                                                     rdfs:subClassOf <urn:productium:specification-profile:EvidenceArtifact> ;
                                                     rdfs:comment "An authored observation or issue record with a fixed finding statement, subject bindings and provenance." ;
                                                     rdfs:label "FindingRecord" .


###  urn:productium:specification-profile:FunctionalRequirementSpecification
<urn:productium:specification-profile:FunctionalRequirementSpecification> rdf:type owl:Class ;
                                                                          rdfs:subClassOf <urn:productium:specification-profile:RequirementSpecification> ;
                                                                          rdfs:comment "A requirement specification with an essential normative commitment about intended behavior or functionality." ;
                                                                          rdfs:label "FunctionalRequirementSpecification" .


###  urn:productium:specification-profile:GoToMarketSpecification
<urn:productium:specification-profile:GoToMarketSpecification> rdf:type owl:Class ;
                                                               rdfs:comment "A governed strategy specification linking positioning, audiences and intended market-entry activity." ;
                                                               rdfs:label "GoToMarketSpecification" .


###  urn:productium:specification-profile:GoalSpecification
<urn:productium:specification-profile:GoalSpecification> rdf:type owl:Class ;
                                                         rdfs:subClassOf <urn:productium:specification-profile:ConditionSpecification> ;
                                                         rdfs:comment "An authored ConditionSpecification whose constitutive content includes desired product condition. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence." ;
                                                         rdfs:label "GoalSpecification" .


###  urn:productium:specification-profile:HypothesisSpecification
<urn:productium:specification-profile:HypothesisSpecification> rdf:type owl:Class ;
                                                               rdfs:comment "An authored testable-claim artifact fixing its claim, intended scope and refutation or support conditions." ;
                                                               rdfs:label "HypothesisSpecification" .


###  urn:productium:specification-profile:InformationArchitectureSpecification
<urn:productium:specification-profile:InformationArchitectureSpecification> rdf:type owl:Class ;
                                                                            rdfs:comment "An authored model of information organization, hierarchy and navigation." ;
                                                                            rdfs:label "InformationArchitectureSpecification" .


###  urn:productium:specification-profile:InitiativeSpecification
<urn:productium:specification-profile:InitiativeSpecification> rdf:type owl:Class ;
                                                               rdfs:comment "An authored plan coordinating goals, scope and expected product outcomes." ;
                                                               rdfs:label "InitiativeSpecification" .


###  urn:productium:specification-profile:InteractionStepSpecification
<urn:productium:specification-profile:InteractionStepSpecification> rdf:type owl:Class ;
                                                                    rdfs:comment "A scoped action or decision-step specification in one user-flow design." ;
                                                                    rdfs:label "InteractionStepSpecification" .


###  urn:productium:specification-profile:JourneySpecification
<urn:productium:specification-profile:JourneySpecification> rdf:type owl:Class ;
                                                            rdfs:comment "An authored structured experience model containing scoped stage specifications." ;
                                                            rdfs:label "JourneySpecification" .


###  urn:productium:specification-profile:JourneyStageSpecification
<urn:productium:specification-profile:JourneyStageSpecification> rdf:type owl:Class ;
                                                                 rdfs:comment "An authored constituent stage specification owned by exactly one JourneySpecification." ;
                                                                 rdfs:label "JourneyStageSpecification" .


###  urn:productium:specification-profile:LaunchSpecification
<urn:productium:specification-profile:LaunchSpecification> rdf:type owl:Class ;
                                                           rdfs:comment "A plan specification for introducing a product or change to an intended audience." ;
                                                           rdfs:label "LaunchSpecification" .


###  urn:productium:specification-profile:LifecycleSpecification
<urn:productium:specification-profile:LifecycleSpecification> rdf:type owl:Class ;
                                                              rdfs:comment "An authored scheme describing lifecycle-stage meanings applicable to products." ;
                                                              rdfs:label "LifecycleSpecification" .


###  urn:productium:specification-profile:LifecycleStageSpecification
<urn:productium:specification-profile:LifecycleStageSpecification> rdf:type owl:Class ;
                                                                   rdfs:comment "A scoped definition of a lifecycle stage within one lifecycle specification." ;
                                                                   rdfs:label "LifecycleStageSpecification" .


###  urn:productium:specification-profile:MarketingGoalSpecification
<urn:productium:specification-profile:MarketingGoalSpecification> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <urn:productium:specification-profile:GoalSpecification> ;
                                                                  rdfs:comment "A goal specification whose constitutive desired result concerns product marketing or market introduction." ;
                                                                  rdfs:label "MarketingGoalSpecification" .


###  urn:productium:specification-profile:MarketingInsightReference
<urn:productium:specification-profile:MarketingInsightReference> rdf:type owl:Class ;
                                                                 rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                                 rdfs:comment "A governed local reference artifact with one canonical target and an explicitly supplied owner identifier. Its marketing-insight purpose is constitutive to the authored reference record, not a temporary role of the target." ;
                                                                 rdfs:label "MarketingInsightReference" .


###  urn:productium:specification-profile:MessagingSpecification
<urn:productium:specification-profile:MessagingSpecification> rdf:type owl:Class ;
                                                              rdfs:comment "An authored specification of audience-directed messages and supporting claims." ;
                                                              rdfs:label "MessagingSpecification" .


###  urn:productium:specification-profile:MilestoneSpecification
<urn:productium:specification-profile:MilestoneSpecification> rdf:type owl:Class ;
                                                              rdfs:comment "An authored target-condition specification marking intended planning progress." ;
                                                              rdfs:label "MilestoneSpecification" .


###  urn:productium:specification-profile:OfferingSpecification
<urn:productium:specification-profile:OfferingSpecification> rdf:type owl:Class ;
                                                             rdfs:comment "A catalog specification of how one product is intended to be offered to an audience under stated terms." ;
                                                             rdfs:label "OfferingSpecification" .


###  urn:productium:specification-profile:OpportunityStatement
<urn:productium:specification-profile:OpportunityStatement> rdf:type owl:Class ;
                                                            rdfs:comment "A governed statement artifact identifying a possible value improvement in context." ;
                                                            rdfs:label "OpportunityStatement" .


###  urn:productium:specification-profile:OutcomeSpecification
<urn:productium:specification-profile:OutcomeSpecification> rdf:type owl:Class ;
                                                            rdfs:subClassOf <urn:productium:specification-profile:ConditionSpecification> ;
                                                            rdfs:comment "An authored ConditionSpecification whose constitutive content includes expected measurable product condition. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence." ;
                                                            rdfs:label "OutcomeSpecification" .


###  urn:productium:specification-profile:PersonaSpecification
<urn:productium:specification-profile:PersonaSpecification> rdf:type owl:Class ;
                                                            rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <urn:productium:specification-profile:personaContext> ;
                                                                              owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <urn:productium:specification-profile:specificationProvenance> ;
                                                                              owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <urn:productium:specification-profile:personaDescription> ;
                                                                              owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                            ] ;
                                                            rdfs:comment "An authored model of a user archetype, fixing a behavioral profile, population/use context and research provenance; not a person, group of actual users or their temporary role." ;
                                                            rdfs:label "PersonaSpecification" .


###  urn:productium:specification-profile:PlanningHorizonDefinition
<urn:productium:specification-profile:PlanningHorizonDefinition> rdf:type owl:Class ;
                                                                 rdfs:comment "A governed term definition specifying the meaning of a planning-horizon label in a named scheme." ;
                                                                 rdfs:label "PlanningHorizonDefinition" .


###  urn:productium:specification-profile:PortfolioEntry
<urn:productium:specification-profile:PortfolioEntry> rdf:type owl:Class ;
                                                      rdfs:comment "A governed entry in one portfolio, optionally referencing a product while a broader target binding is being specified." ;
                                                      rdfs:label "PortfolioEntry" .


###  urn:productium:specification-profile:PositioningStatement
<urn:productium:specification-profile:PositioningStatement> rdf:type owl:Class ;
                                                            rdfs:comment "An authored statement specifying intended product perception for a target audience relative to alternatives." ;
                                                            rdfs:label "PositioningStatement" .


###  urn:productium:specification-profile:PrioritizationCriterionSpecification
<urn:productium:specification-profile:PrioritizationCriterionSpecification> rdf:type owl:Class ;
                                                                            rdfs:subClassOf <urn:productium:specification-profile:DecisionCriterionSpecification> ;
                                                                            rdfs:comment "A decision-criterion specification whose constitutive purpose is to justify or compute a planning rank." ;
                                                                            rdfs:label "PrioritizationCriterionSpecification" .


###  urn:productium:specification-profile:PriorityAssessment
<urn:productium:specification-profile:PriorityAssessment> rdf:type owl:Class ;
                                                          rdfs:comment "A dated contextual ranking assessment recording a rank for a roadmap entry within a named comparison set and scale." ;
                                                          rdfs:label "PriorityAssessment" .


###  urn:productium:specification-profile:ProblemSolutionFitAssessment
<urn:productium:specification-profile:ProblemSolutionFitAssessment> rdf:type owl:Class ;
                                                                    rdfs:comment "A dated assessment record about the proposed fit of a problem statement and a solution specification." ;
                                                                    rdfs:label "ProblemSolutionFitAssessment" .


###  urn:productium:specification-profile:ProblemStatement
<urn:productium:specification-profile:ProblemStatement> rdf:type owl:Class ;
                                                        rdfs:comment "A governed statement artifact describing a candidate or evidenced problem." ;
                                                        rdfs:label "ProblemStatement" .


###  urn:productium:specification-profile:Product
<urn:productium:specification-profile:Product> rdf:type owl:Class ;
                                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <urn:productium:specification-profile:hasVersion> ;
                                                                 owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                               ] ;
                                               rdfs:comment "A governed intentional product artifact with continuing constitutive purpose and stewardship lineage; not a deployment or a database row." ;
                                               rdfs:label "Product" .


###  urn:productium:specification-profile:ProductCapability
<urn:productium:specification-profile:ProductCapability> rdf:type owl:Class ;
                                                         rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <urn:productium:specification-profile:evaluatedAgainst> ;
                                                                           owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:bearsCapability>
                                                                                          ] ;
                                                                           owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ;
                                                         rdfs:comment "An actual intrinsic disposition of one concrete ProductRealization as a configured functional whole. Intended behavior, successful execution, a specification and a machine label are not the disposition." ;
                                                         rdfs:label "ProductCapability" .


###  urn:productium:specification-profile:ProductFamilyReference
<urn:productium:specification-profile:ProductFamilyReference> rdf:type owl:Class ;
                                                              rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                              rdfs:comment "A local reference artifact identifying a product-family target governed by an external owner. Its product-family purpose is constitutive to the authored reference record, not a temporary role of the target." ;
                                                              rdfs:label "ProductFamilyReference" .


###  urn:productium:specification-profile:ProductLineReference
<urn:productium:specification-profile:ProductLineReference> rdf:type owl:Class ;
                                                            rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                            rdfs:comment "A local reference artifact identifying an externally governed product line. Its product-line purpose is constitutive to the authored reference record, not a temporary role of the target." ;
                                                            rdfs:label "ProductLineReference" .


###  urn:productium:specification-profile:ProductMarketFitAssessment
<urn:productium:specification-profile:ProductMarketFitAssessment> rdf:type owl:Class ;
                                                                  rdfs:comment "A dated assessment record about a product in an explicitly identified market context." ;
                                                                  rdfs:label "ProductMarketFitAssessment" .


###  urn:productium:specification-profile:ProductMetricReference
<urn:productium:specification-profile:ProductMetricReference> rdf:type owl:Class ;
                                                              rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                              rdfs:comment "A local reference artifact binding a product measurement context to an externally governed metric. Its product-metric purpose is constitutive to the authored reference record, not a temporary role of the target." ;
                                                              rdfs:label "ProductMetricReference" .


###  urn:productium:specification-profile:ProductPortfolio
<urn:productium:specification-profile:ProductPortfolio> rdf:type owl:Class ;
                                                        rdfs:comment "A governed strategic arrangement organizing products, entries and planning references under a continuing portfolio mandate." ;
                                                        rdfs:label "ProductPortfolio" .


###  urn:productium:specification-profile:ProductRealization
<urn:productium:specification-profile:ProductRealization> rdf:type owl:Class ;
                                                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <urn:productium:specification-profile:bearsCapability> ;
                                                                            owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:testsRealization>
                                                                                           ] ;
                                                                            owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                          ] ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <urn:productium:specification-profile:realizesVersion> ;
                                                                            owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                          ] ;
                                                          rdfs:comment "A concrete, causally integrated computing-system artifact configured to enact one fixed product-version baseline. It is the deployed functional whole, not its record, hosting machine, execution event or deployment interval." ;
                                                          rdfs:label "ProductRealization" .


###  urn:productium:specification-profile:ProductStatusRecord
<urn:productium:specification-profile:ProductStatusRecord> rdf:type owl:Class ;
                                                           rdfs:comment "A dated contextual assertion assigning a status value to one product." ;
                                                           rdfs:label "ProductStatusRecord" .


###  urn:productium:specification-profile:ProductVariantReference
<urn:productium:specification-profile:ProductVariantReference> rdf:type owl:Class ;
                                                               rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                               rdfs:comment "A local reference artifact identifying an externally governed product variant. Its product-variant purpose is constitutive to the authored reference record, not a temporary role of the target." ;
                                                               rdfs:label "ProductVariantReference" .


###  urn:productium:specification-profile:ProductVersion
<urn:productium:specification-profile:ProductVersion> rdf:type owl:Class ;
                                                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <urn:productium:specification-profile:specifiesCapability> ;
                                                                        owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:realizesVersion>
                                                                                       ] ;
                                                                        owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:hasVersion>
                                                                                       ] ;
                                                                        owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                      ] ;
                                                      rdfs:comment "An immutable approved specification baseline for one Product." ;
                                                      rdfs:label "ProductVersion" .


###  urn:productium:specification-profile:QualityRequirementSpecification
<urn:productium:specification-profile:QualityRequirementSpecification> rdf:type owl:Class ;
                                                                       rdfs:subClassOf <urn:productium:specification-profile:RequirementSpecification> ;
                                                                       rdfs:comment "A requirement specification with an essential normative commitment about a measurable quality under defined conditions." ;
                                                                       rdfs:label "QualityRequirementSpecification" .


###  urn:productium:specification-profile:ReleaseEvidenceRecord
<urn:productium:specification-profile:ReleaseEvidenceRecord> rdf:type owl:Class ;
                                                             rdfs:subClassOf <urn:productium:specification-profile:EvidenceAttributionRecord> ;
                                                             rdfs:comment "An evidence-attribution record whose constitutive assessment purpose is release." ;
                                                             rdfs:label "ReleaseEvidenceRecord" .


###  urn:productium:specification-profile:ReleaseSpecification
<urn:productium:specification-profile:ReleaseSpecification> rdf:type owl:Class ;
                                                            rdfs:comment "A governed specification of a planned delivery increment and its intended contents." ;
                                                            rdfs:label "ReleaseSpecification" .


###  urn:productium:specification-profile:RequirementRationaleStatement
<urn:productium:specification-profile:RequirementRationaleStatement> rdf:type owl:Class ;
                                                                     rdfs:comment "An authored justification statement explaining why a requirement specification is needed." ;
                                                                     rdfs:label "RequirementRationaleStatement" .


###  urn:productium:specification-profile:RequirementScenarioSpecification
<urn:productium:specification-profile:RequirementScenarioSpecification> rdf:type owl:Class ;
                                                                        rdfs:subClassOf <urn:productium:specification-profile:ScenarioSpecification> ;
                                                                        rdfs:comment "An authored ScenarioSpecification whose constitutive content includes requirement/acceptance illustration. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence." ;
                                                                        rdfs:label "RequirementScenarioSpecification" .


###  urn:productium:specification-profile:RequirementSourceReference
<urn:productium:specification-profile:RequirementSourceReference> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                                  rdfs:comment "A local provenance reference artifact identifying an origin used in deriving a requirement specification. Its requirement-source purpose is constitutive to the authored reference record, not a temporary role of the target." ;
                                                                  rdfs:label "RequirementSourceReference" .


###  urn:productium:specification-profile:RequirementSpecification
<urn:productium:specification-profile:RequirementSpecification> rdf:type owl:Class ;
                                                                rdfs:subClassOf <urn:productium:specification-profile:ConditionSpecification> ;
                                                                rdfs:comment "An authored ConditionSpecification whose constitutive content includes required product condition. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence." ;
                                                                rdfs:label "RequirementSpecification" .


###  urn:productium:specification-profile:Roadmap
<urn:productium:specification-profile:Roadmap> rdf:type owl:Class ;
                                               rdfs:comment "A governed planning-projection artifact referencing canonical product knowledge." ;
                                               rdfs:label "Roadmap" .


###  urn:productium:specification-profile:RoadmapEntry
<urn:productium:specification-profile:RoadmapEntry> rdf:type owl:Class ;
                                                    rdfs:comment "A scoped entry in one roadmap referencing intended initiatives, features or delivery targets." ;
                                                    rdfs:label "RoadmapEntry" .


###  urn:productium:specification-profile:ScenarioSpecification
<urn:productium:specification-profile:ScenarioSpecification> rdf:type owl:Class ;
                                                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <urn:productium:specification-profile:specifiesExpectedCondition> ;
                                                                               owl:someValuesFrom <urn:productium:specification-profile:ConditionSpecification>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <urn:productium:specification-profile:scenarioContext> ;
                                                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <urn:productium:specification-profile:specificationProvenance> ;
                                                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <urn:productium:specification-profile:scenarioActions> ;
                                                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <urn:productium:specification-profile:scenarioPrecondition> ;
                                                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                             ] ;
                                                             rdfs:comment "An authored structured situation description fixing context, preconditions, ordered stimulus/action description and expected condition units; distinct from each actual occurrence." ;
                                                             rdfs:label "ScenarioSpecification" .


###  urn:productium:specification-profile:ScopeSpecification
<urn:productium:specification-profile:ScopeSpecification> rdf:type owl:Class ;
                                                          rdfs:comment "An authored specification of included, excluded and deferred product scope." ;
                                                          rdfs:label "ScopeSpecification" .


###  urn:productium:specification-profile:ScreenSpecification
<urn:productium:specification-profile:ScreenSpecification> rdf:type owl:Class ;
                                                           rdfs:comment "An authored view specification with layout, interaction and state commitments." ;
                                                           rdfs:label "ScreenSpecification" .


###  urn:productium:specification-profile:SolutionHypothesisSpecification
<urn:productium:specification-profile:SolutionHypothesisSpecification> rdf:type owl:Class ;
                                                                       rdfs:subClassOf <urn:productium:specification-profile:HypothesisSpecification> ;
                                                                       rdfs:comment "A hypothesis specification whose constitutive claim concerns a proposed solution addressing a problem." ;
                                                                       rdfs:label "SolutionHypothesisSpecification" .


###  urn:productium:specification-profile:SolutionSpecification
<urn:productium:specification-profile:SolutionSpecification> rdf:type owl:Class ;
                                                             rdfs:comment "An authored product-level solution proposal describing how problems or opportunities are intended to be addressed." ;
                                                             rdfs:label "SolutionSpecification" .


###  urn:productium:specification-profile:TargetMarketReference
<urn:productium:specification-profile:TargetMarketReference> rdf:type owl:Class ;
                                                             rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                             rdfs:comment "A local reference artifact to an externally governed target market. Its target-market purpose is constitutive to the authored reference record, not a temporary role of the target." ;
                                                             rdfs:label "TargetMarketReference" .


###  urn:productium:specification-profile:TargetSegmentReference
<urn:productium:specification-profile:TargetSegmentReference> rdf:type owl:Class ;
                                                              rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                              rdfs:comment "A local reference artifact to an externally governed segment in an identified segmentation context. Its target-segment purpose is constitutive to the authored reference record, not a temporary role of the target." ;
                                                              rdfs:label "TargetSegmentReference" .


###  urn:productium:specification-profile:TargetWindowAssignment
<urn:productium:specification-profile:TargetWindowAssignment> rdf:type owl:Class ;
                                                              rdfs:comment "A planning record assigning a bounded target interval to one roadmap entry." ;
                                                              rdfs:label "TargetWindowAssignment" .


###  urn:productium:specification-profile:TaskReference
<urn:productium:specification-profile:TaskReference> rdf:type owl:Class ;
                                                     rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                     rdfs:comment "A local reference artifact identifying an externally governed implementation task. Its implementation-task purpose is constitutive to the authored reference record, not a temporary role of the target." ;
                                                     rdfs:label "TaskReference" .


###  urn:productium:specification-profile:TestCase
<urn:productium:specification-profile:TestCase> rdf:type owl:Class ;
                                                rdfs:subClassOf <urn:productium:specification-profile:ScenarioSpecification> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:executes>
                                                                                 ] ;
                                                                  owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                ] ;
                                                rdfs:comment "A ScenarioSpecification that includes an operational test procedure and expected conditions. Repeated executions reuse the specification and remain distinct events." ;
                                                rdfs:label "TestCase" .


###  urn:productium:specification-profile:TestDataReference
<urn:productium:specification-profile:TestDataReference> rdf:type owl:Class ;
                                                         rdfs:subClassOf <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                         rdfs:comment "A local reference artifact identifying a versioned dataset used in test design or execution. Its test-data purpose is constitutive to the authored reference record, not a temporary role of the target." ;
                                                         rdfs:label "TestDataReference" .


###  urn:productium:specification-profile:TestExecution
<urn:productium:specification-profile:TestExecution> rdf:type owl:Class ;
                                                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <urn:product-ontology:delivery-profile:0.5:executionCriterion> ;
                                                                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <urn:productium:specification-profile:assessesSpecification> ;
                                                                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <urn:product-ontology:delivery-profile:0.5:executionContext> ;
                                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <urn:productium:specification-profile:executes> ;
                                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <urn:productium:specification-profile:testsRealization> ;
                                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty [ owl:inverseOf <urn:productium:specification-profile:recordsExecution>
                                                                                      ] ;
                                                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                     ] ;
                                                     rdfs:comment "A concluded attempt concerning one declared TestCase and ProductRealization. A setup-only abort does not establish actual target participation. One consolidated result documents the attempt." ;
                                                     rdfs:label "TestExecution" .


###  urn:productium:specification-profile:TestResult
<urn:productium:specification-profile:TestResult> rdf:type owl:Class ;
