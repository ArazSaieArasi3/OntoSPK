#    Classes
#################################################################

###  urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification
<urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> rdf:type owl:Class ;
                                                                             owl:disjointWith <urn:productium:specification-profile:AssessmentClaim> ,
                                                                                              <urn:productium:specification-profile:ConditionSpecification> ,
                                                                                              <urn:productium:specification-profile:EvidenceArtifact> ,
                                                                                              <urn:productium:specification-profile:EvidenceAttributionRecord> ,
                                                                                              <urn:productium:specification-profile:ProductCapability> ,
                                                                                              <urn:productium:specification-profile:ProductRealization> ,
                                                                                              <urn:productium:specification-profile:ProductVersion> ,
                                                                                              <urn:productium:specification-profile:ScenarioSpecification> ,
                                                                                              <urn:productium:specification-profile:ScopeSpecification> ;
                                                                             rdfs:comment "An authored specification fixing the applicability boundary of an assessment, including its stated population, environment and temporal conditions, with optional version and scenario bindings." ;
                                                                             rdfs:label "Assessment Context Specification" .


###  urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord
<urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> rdf:type owl:Class ;
                                                                         rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty [ owl:inverseOf <urn:product-ontology:delivery-profile:0.5:itemStatus>
                                                                                                          ] ;
                                                                                           owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                                         ] ;
                                                                         owl:disjointWith <urn:productium:specification-profile:DeliveryStatusRecord> ,
                                                                                          <urn:productium:specification-profile:DeliveryWorkItem> ,
                                                                                          <urn:productium:specification-profile:ProductCapability> ,
                                                                                          <urn:productium:specification-profile:ProductRealization> ,
                                                                                          <urn:productium:specification-profile:ProductVersion> ,
                                                                                          <urn:productium:specification-profile:ReleaseSpecification> ,
                                                                                          <urn:productium:specification-profile:TestExecution> ,
                                                                                          <urn:productium:specification-profile:TestResult> ;
                                                                         rdfs:comment "An immutable dated information record assigning a status code under a stated scheme to one delivery work item, optionally qualified by one product version." ;
                                                                         rdfs:label "Delivery Work Item Status Record" .


