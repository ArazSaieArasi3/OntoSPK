#################################################################
#    Data properties
#################################################################

###  urn:product-ontology:assessment-profile:0.4:attributionAgent
<urn:product-ontology:assessment-profile:0.4:attributionAgent> rdf:type owl:DatatypeProperty ,
                                                                        owl:FunctionalProperty ;
                                                               rdfs:domain <urn:productium:specification-profile:EvidenceAttributionRecord> ;
                                                               rdfs:range xsd:anyURI ;
                                                               rdfs:comment "Recorded assessor identifier. An identifier is operational metadata, not a new Agent concept or a verified identity." .


###  urn:product-ontology:assessment-profile:0.4:attributionSource
<urn:product-ontology:assessment-profile:0.4:attributionSource> rdf:type owl:DatatypeProperty ;
                                                                rdfs:domain <urn:productium:specification-profile:EvidenceAttributionRecord> ;
                                                                rdfs:range xsd:anyURI ;
                                                                rdfs:comment "Recorded source URI; kept separate from the assessor identifier and from evidence ownership." .


###  urn:product-ontology:assessment-profile:0.4:attributionStance
<urn:product-ontology:assessment-profile:0.4:attributionStance> rdf:type owl:DatatypeProperty ,
                                                                         owl:FunctionalProperty ;
                                                                rdfs:domain <urn:productium:specification-profile:EvidenceAttributionRecord> ;
                                                                rdfs:range xsd:string ;
                                                                rdfs:comment "One of supports, challenges, limits, unassessed. Stance belongs to the record, never globally to its carrier." .


###  urn:product-ontology:assessment-profile:0.4:attributionTimestamp
<urn:product-ontology:assessment-profile:0.4:attributionTimestamp> rdf:type owl:DatatypeProperty ,
                                                                            owl:FunctionalProperty ;
                                                                   rdfs:domain <urn:productium:specification-profile:EvidenceAttributionRecord> ;
                                                                   rdfs:range xsd:dateTime ;
                                                                   rdfs:comment "Time of the recorded attribution. Does not establish when the evidence carrier was generated." .


###  urn:product-ontology:assessment-profile:0.4:claimStatement
<urn:product-ontology:assessment-profile:0.4:claimStatement> rdf:type owl:DatatypeProperty ,
                                                                      owl:FunctionalProperty ;
                                                             rdfs:domain <urn:productium:specification-profile:AssessmentClaim> ;
                                                             rdfs:range xsd:string ;
                                                             rdfs:comment "The proposition asserted by this authored claim; no truth assertion is inferred." .


###  urn:product-ontology:assessment-profile:0.4:contextDescription
<urn:product-ontology:assessment-profile:0.4:contextDescription> rdf:type owl:DatatypeProperty ,
                                                                          owl:FunctionalProperty ;
                                                                 rdfs:domain <urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> ;
                                                                 rdfs:range xsd:string ;
                                                                 rdfs:comment "Explicit bounded applicability description; not a full structured context ontology." .


###  urn:product-ontology:assessment-profile:0.4:contextSource
<urn:product-ontology:assessment-profile:0.4:contextSource> rdf:type owl:DatatypeProperty ;
                                                            rdfs:domain <urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification> ;
                                                            rdfs:range xsd:anyURI ;
                                                            rdfs:comment "URI identifying recorded authoring/source provenance, not proof of authority." .


###  urn:product-ontology:assessment-profile:0.4:deferredStatement
<urn:product-ontology:assessment-profile:0.4:deferredStatement> rdf:type owl:DatatypeProperty ;
                                                                rdfs:domain <urn:productium:specification-profile:ScopeSpecification> ;
                                                                rdfs:range xsd:string ;
                                                                rdfs:comment "Authored deferred content; distinct from exclusion." .


###  urn:product-ontology:assessment-profile:0.4:excludedStatement
<urn:product-ontology:assessment-profile:0.4:excludedStatement> rdf:type owl:DatatypeProperty ;
                                                                rdfs:domain <urn:productium:specification-profile:ScopeSpecification> ;
                                                                rdfs:range xsd:string ;
                                                                rdfs:comment "Authored excluded content; not a closed-world complement of the included content." .


###  urn:product-ontology:assessment-profile:0.4:findingSource
<urn:product-ontology:assessment-profile:0.4:findingSource> rdf:type owl:DatatypeProperty ;
                                                            rdfs:domain <urn:productium:specification-profile:FindingRecord> ;
                                                            rdfs:range xsd:anyURI ;
                                                            rdfs:comment "Recorded observation provenance URI." .


###  urn:product-ontology:assessment-profile:0.4:findingStatement
<urn:product-ontology:assessment-profile:0.4:findingStatement> rdf:type owl:DatatypeProperty ,
                                                                        owl:FunctionalProperty ;
                                                               rdfs:domain <urn:productium:specification-profile:FindingRecord> ;
                                                               rdfs:range xsd:string ;
                                                               rdfs:comment "Observation or issue content, distinct from its contextual evidential stance." .


###  urn:product-ontology:assessment-profile:0.4:includedStatement
<urn:product-ontology:assessment-profile:0.4:includedStatement> rdf:type owl:DatatypeProperty ;
                                                                rdfs:domain <urn:productium:specification-profile:ScopeSpecification> ;
                                                                rdfs:range xsd:string ;
                                                                rdfs:comment "Authored included content. Absence is not an assertion that the included set is empty." .


###  urn:product-ontology:assessment-profile:0.4:scopeSource
<urn:product-ontology:assessment-profile:0.4:scopeSource> rdf:type owl:DatatypeProperty ;
                                                          rdfs:domain <urn:productium:specification-profile:ScopeSpecification> ;
                                                          rdfs:range xsd:anyURI ;
                                                          rdfs:comment "Recorded source of the authored scope baseline." .


###  urn:product-ontology:delivery-profile:0.5:executionEndedAt
<urn:product-ontology:delivery-profile:0.5:executionEndedAt> rdf:type owl:DatatypeProperty ,
                                                                      owl:FunctionalProperty ;
                                                             rdfs:domain <urn:productium:specification-profile:TestExecution> ;
                                                             rdfs:range xsd:dateTime ;
                                                             rdfs:comment "End of a concluded run, including an aborted run. Ongoing runs are outside this completed-event profile." .


###  urn:product-ontology:delivery-profile:0.5:itemStatusCode
<urn:product-ontology:delivery-profile:0.5:itemStatusCode> rdf:type owl:DatatypeProperty ,
                                                                    owl:FunctionalProperty ;
                                                           rdfs:domain <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
                                                           rdfs:range xsd:string ;
                                                           rdfs:comment "Recorded code under the named workflow scheme; it is not proof of delivery." .


###  urn:product-ontology:delivery-profile:0.5:itemStatusReportedAt
<urn:product-ontology:delivery-profile:0.5:itemStatusReportedAt> rdf:type owl:DatatypeProperty ,
                                                                          owl:FunctionalProperty ;
                                                                 rdfs:domain <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
                                                                 rdfs:range xsd:dateTime ;
                                                                 rdfs:comment "Time of this immutable report, not automatically the time of delivery." .


###  urn:product-ontology:delivery-profile:0.5:itemStatusScheme
<urn:product-ontology:delivery-profile:0.5:itemStatusScheme> rdf:type owl:DatatypeProperty ,
                                                                      owl:FunctionalProperty ;
                                                             rdfs:domain <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
                                                             rdfs:range xsd:anyURI ;
                                                             rdfs:comment "Identifier of the interpretation scheme; this ontology does not impose a universal delivery lifecycle." .


###  urn:product-ontology:delivery-profile:0.5:itemStatusSource
<urn:product-ontology:delivery-profile:0.5:itemStatusSource> rdf:type owl:DatatypeProperty ;
                                                             rdfs:domain <urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord> ;
                                                             rdfs:range xsd:anyURI ;
                                                             rdfs:comment "Recorded report provenance, distinct from a workflow code." .


###  urn:product-ontology:delivery-profile:0.5:observedAuthority
<urn:product-ontology:delivery-profile:0.5:observedAuthority> rdf:type owl:DatatypeProperty ,
                                                                       owl:FunctionalProperty ;
                                                              rdfs:domain <urn:productium:specification-profile:FindingRecord> ;
                                                              rdfs:range xsd:anyURI ;
                                                              rdfs:comment "Observed authority identifier; required and different from the old authority for authority_changed findings." .


###  urn:product-ontology:delivery-profile:0.5:observedTarget
<urn:product-ontology:delivery-profile:0.5:observedTarget> rdf:type owl:DatatypeProperty ,
                                                                    owl:FunctionalProperty ;
                                                           rdfs:domain <urn:productium:specification-profile:FindingRecord> ;
                                                           rdfs:range xsd:anyURI ;
                                                           rdfs:comment "Observed target identifier; required and different from the old target for target_changed findings." .


###  urn:product-ontology:delivery-profile:0.5:referenceRecordedAt
<urn:product-ontology:delivery-profile:0.5:referenceRecordedAt> rdf:type owl:DatatypeProperty ,
                                                                         owl:FunctionalProperty ;
                                                                rdfs:domain <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                                rdfs:range xsd:dateTime ;
                                                                rdfs:comment "Recorded creation time of this fixed reference binding." .


###  urn:product-ontology:delivery-profile:0.5:referenceRevisionLabel
<urn:product-ontology:delivery-profile:0.5:referenceRevisionLabel> rdf:type owl:DatatypeProperty ,
                                                                            owl:FunctionalProperty ;
                                                                   rdfs:domain <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                                   rdfs:range xsd:string ;
                                                                   rdfs:comment "Optional authored revision label. A label alone does not establish freshness or a successor." .


###  urn:product-ontology:delivery-profile:0.5:releaseStatusCode
<urn:product-ontology:delivery-profile:0.5:releaseStatusCode> rdf:type owl:DatatypeProperty ,
                                                                       owl:FunctionalProperty ;
                                                              rdfs:domain <urn:productium:specification-profile:DeliveryStatusRecord> ;
                                                              rdfs:range xsd:string ;
                                                              rdfs:comment "Recorded code under the named workflow scheme; it is not proof of delivery." .


###  urn:product-ontology:delivery-profile:0.5:releaseStatusReportedAt
<urn:product-ontology:delivery-profile:0.5:releaseStatusReportedAt> rdf:type owl:DatatypeProperty ,
                                                                             owl:FunctionalProperty ;
                                                                    rdfs:domain <urn:productium:specification-profile:DeliveryStatusRecord> ;
                                                                    rdfs:range xsd:dateTime ;
                                                                    rdfs:comment "Time of this immutable report, not automatically the time of delivery." .


###  urn:product-ontology:delivery-profile:0.5:releaseStatusScheme
<urn:product-ontology:delivery-profile:0.5:releaseStatusScheme> rdf:type owl:DatatypeProperty ,
                                                                         owl:FunctionalProperty ;
                                                                rdfs:domain <urn:productium:specification-profile:DeliveryStatusRecord> ;
                                                                rdfs:range xsd:anyURI ;
                                                                rdfs:comment "Identifier of the interpretation scheme; this ontology does not impose a universal delivery lifecycle." .


###  urn:product-ontology:delivery-profile:0.5:releaseStatusSource
<urn:product-ontology:delivery-profile:0.5:releaseStatusSource> rdf:type owl:DatatypeProperty ;
                                                                rdfs:domain <urn:productium:specification-profile:DeliveryStatusRecord> ;
                                                                rdfs:range xsd:anyURI ;
                                                                rdfs:comment "Recorded report provenance, distinct from a workflow code." .


###  urn:product-ontology:delivery-profile:0.5:resultOutcome
<urn:product-ontology:delivery-profile:0.5:resultOutcome> rdf:type owl:DatatypeProperty ,
                                                                   owl:FunctionalProperty ;
                                                          rdfs:domain <urn:productium:specification-profile:TestResult> ;
                                                          rdfs:range xsd:string ;
                                                          rdfs:comment "Local reporting code: passed, failed, aborted, inconclusive or unknown. A recorded pass does not entail claim truth or acceptance." .


###  urn:product-ontology:delivery-profile:0.5:resultRecordedAt
<urn:product-ontology:delivery-profile:0.5:resultRecordedAt> rdf:type owl:DatatypeProperty ,
                                                                      owl:FunctionalProperty ;
                                                             rdfs:domain <urn:productium:specification-profile:TestResult> ;
                                                             rdfs:range xsd:dateTime ;
                                                             rdfs:comment "Report time at or after the recorded execution end." .


###  urn:product-ontology:delivery-profile:0.5:resultSource
<urn:product-ontology:delivery-profile:0.5:resultSource> rdf:type owl:DatatypeProperty ;
                                                         rdfs:domain <urn:productium:specification-profile:TestResult> ;
                                                         rdfs:range xsd:anyURI ;
                                                         rdfs:comment "Source identifier of the recorded execution result." .


###  urn:product-ontology:delivery-profile:0.5:reviewReason
<urn:product-ontology:delivery-profile:0.5:reviewReason> rdf:type owl:DatatypeProperty ,
                                                                  owl:FunctionalProperty ;
                                                         rdfs:domain <urn:productium:specification-profile:FindingRecord> ;
                                                         rdfs:range xsd:string ;
                                                         rdfs:comment "For reference-review findings only: target_changed, authority_changed, target_unreachable or scheduled_review." .


###  urn:product-ontology:delivery-profile:0.5:reviewRecordedAt
<urn:product-ontology:delivery-profile:0.5:reviewRecordedAt> rdf:type owl:DatatypeProperty ,
                                                                      owl:FunctionalProperty ;
                                                             rdfs:domain <urn:productium:specification-profile:FindingRecord> ;
                                                             rdfs:range xsd:dateTime ;
                                                             rdfs:comment "Required for a reference-review finding; observations must not predate the referenced binding." .


###  urn:product-ontology:trace-profile:0.6:changeOccurrenceReference
<urn:product-ontology:trace-profile:0.6:changeOccurrenceReference> rdf:type owl:DatatypeProperty ,
                                                                            owl:FunctionalProperty ;
                                                                   rdfs:domain <urn:productium:specification-profile:ChangeRecord> ;
                                                                   rdfs:range xsd:anyURI ;
                                                                   rdfs:comment "Recorded identifier for the asserted modification occurrence; not a fabricated event individual." .


###  urn:product-ontology:trace-profile:0.6:changeRecordedAt
<urn:product-ontology:trace-profile:0.6:changeRecordedAt> rdf:type owl:DatatypeProperty ,
                                                                   owl:FunctionalProperty ;
                                                          rdfs:domain <urn:productium:specification-profile:ChangeRecord> ;
                                                          rdfs:range xsd:dateTime ;
                                                          rdfs:comment "Time of the immutable change report." .


###  urn:product-ontology:trace-profile:0.6:changeSource
<urn:product-ontology:trace-profile:0.6:changeSource> rdf:type owl:DatatypeProperty ;
                                                      rdfs:domain <urn:productium:specification-profile:ChangeRecord> ;
                                                      rdfs:range xsd:anyURI ;
                                                      rdfs:comment "Source provenance of the change assertion." .


###  urn:product-ontology:trace-profile:0.6:changeStatement
<urn:product-ontology:trace-profile:0.6:changeStatement> rdf:type owl:DatatypeProperty ,
                                                                  owl:FunctionalProperty ;
                                                         rdfs:domain <urn:productium:specification-profile:ChangeRecord> ;
                                                         rdfs:range xsd:string ;
                                                         rdfs:comment "Content of the asserted modification; not proof of application." .


###  urn:product-ontology:trace-profile:0.6:decisionRationale
<urn:product-ontology:trace-profile:0.6:decisionRationale> rdf:type owl:DatatypeProperty ,
                                                                    owl:FunctionalProperty ;
                                                           rdfs:domain <urn:productium:specification-profile:DecisionRecord> ;
                                                           rdfs:range xsd:string ;
                                                           rdfs:comment "Recorded rationale explaining selection, nonselection or handling. The string is not machine-verified reasoning." .


###  urn:product-ontology:trace-profile:0.6:decisionSource
<urn:product-ontology:trace-profile:0.6:decisionSource> rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain <urn:productium:specification-profile:DecisionRecord> ;
                                                        rdfs:range xsd:anyURI ;
                                                        rdfs:comment "Recorded provenance of this decision record." .


###  urn:product-ontology:trace-profile:0.6:dependencySource
<urn:product-ontology:trace-profile:0.6:dependencySource> rdf:type owl:DatatypeProperty ;
                                                          rdfs:domain <urn:productium:specification-profile:DependencySpecification> ;
                                                          rdfs:range xsd:anyURI ;
                                                          rdfs:comment "Recorded source of the authored dependency assertion." .


###  urn:product-ontology:trace-profile:0.6:proposalSource
<urn:product-ontology:trace-profile:0.6:proposalSource> rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain <urn:productium:specification-profile:ChangeProposalSpecification> ;
                                                        rdfs:range xsd:anyURI ;
                                                        rdfs:comment "Provenance of the authored proposal." .


###  urn:product-ontology:trace-profile:0.6:proposalStatement
<urn:product-ontology:trace-profile:0.6:proposalStatement> rdf:type owl:DatatypeProperty ,
                                                                    owl:FunctionalProperty ;
                                                           rdfs:domain <urn:productium:specification-profile:ChangeProposalSpecification> ;
                                                           rdfs:range xsd:string ;
                                                           rdfs:comment "Authored desired delta, distinct from an assertion that it occurred." .


###  urn:product-ontology:trace-profile:0.6:usabilityRecommendation
<urn:product-ontology:trace-profile:0.6:usabilityRecommendation> rdf:type owl:DatatypeProperty ;
                                                                 rdfs:domain <urn:productium:specification-profile:UsabilityFindingRecord> ;
                                                                 rdfs:range xsd:string ;
                                                                 rdfs:comment "Advice authored within this finding and sharing its provenance. Absence is unknown; no separate recommendation identity or implemented fix is asserted." .


###  urn:productium:specification-profile:conditionStatement
<urn:productium:specification-profile:conditionStatement> rdf:type owl:DatatypeProperty ;
                                                          rdfs:domain <urn:productium:specification-profile:ConditionSpecification> ;
                                                          rdfs:range xsd:string .


###  urn:productium:specification-profile:personaDescription
<urn:productium:specification-profile:personaDescription> rdf:type owl:DatatypeProperty ;
                                                          rdfs:domain <urn:productium:specification-profile:PersonaSpecification> ;
                                                          rdfs:range xsd:string .


###  urn:productium:specification-profile:referencePurpose
<urn:productium:specification-profile:referencePurpose> rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain <urn:productium:specification-profile:ExternalReferenceRecord> ;
                                                        rdfs:range xsd:string .


###  urn:productium:specification-profile:scenarioActions
<urn:productium:specification-profile:scenarioActions> rdf:type owl:DatatypeProperty ;
                                                       rdfs:domain <urn:productium:specification-profile:ScenarioSpecification> ;
                                                       rdfs:range xsd:string .


###  urn:productium:specification-profile:scenarioPrecondition
<urn:productium:specification-profile:scenarioPrecondition> rdf:type owl:DatatypeProperty ;
                                                            rdfs:domain <urn:productium:specification-profile:ScenarioSpecification> ;
                                                            rdfs:range xsd:string .


