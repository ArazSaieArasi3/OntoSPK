        <rdfs:range rdf:resource="urn:productium:specification-profile:PersonaSpecification"/>
    </owl:ObjectProperty>
    


    <!-- urn:productium:specification-profile:specifiesSlice -->


    <owl:ObjectProperty rdf:about="urn:productium:specification-profile:specifiesSlice">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:FeatureSpecification"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:VerticalSliceSpecification"/>
    </owl:ObjectProperty>
    


