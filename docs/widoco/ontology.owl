rg/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">The acquisition hypothesis cites external evidence offered in assessing its claim; the relation does not entail confirmation.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AcquisitionHypothesisSpecification"></n1:domain><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">evidencedBy</n1:label><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:external-boundary:0.7:EvidenceLayer%3AEvidence"></n1:range><n1:subPropertyOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:relation-profile:0.7:r160_evidencedBy"></n1:subPropertyOf></n0:Description><n0:Description n0:about="urn:product-ontology:relation-profile:0.7:r225_addressesPain"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">The adoption hypothesis identifies an externally governed pain within its intended explanatory scope.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AdoptionHypothesisSpecification"></n1:domain><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">addressesPain</n1:label><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:external-boundary:0.7:Market%3APain"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:relation-profile:0.7:r226_evidencedBy"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">The adoption hypothesis cites external evidence offered in assessing its claim; the relation does not entail confirmation.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specific