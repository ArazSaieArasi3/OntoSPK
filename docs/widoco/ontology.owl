    <!-- urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification -->


    <owl:Class rdf:about="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification">
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:AssessmentClaim"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:ConditionSpecification"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:EvidenceArtifact"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:EvidenceAttributionRecord"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:ProductCapability"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:ProductRealization"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:ProductVersion"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:ScenarioSpecification"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:ScopeSpecification"/>
        <rdfs:comment>An authored specification fixing the applicability boundary of an assessment, including its stated population, environment and temporal conditions, with optional version and scenario bindings.</rdfs:comment>
        <rdfs:label>Assessment Context Specification</rdfs:label>
    </owl:Class>
    


    <!-- urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord -->


    <owl:Class rdf:about="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="urn:product-ontology:delivery-profile:0.5:itemStatus"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:DeliveryStatusRecord"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:DeliveryWorkItem"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:ProductCapability"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:ProductRealization"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:ProductVersion"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:ReleaseSpecification"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:TestExecution"/>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:TestResult"/>
        <rdfs:comment>An immutable dated information record assigning a status code under a stated scheme to one delivery work item, optionally qualified by one product version.</rdfs:comment>
        <rdfs:label>Delivery Work Item Status Record</rdfs:label>
    </owl:Class>
    


