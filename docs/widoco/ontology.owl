<n0:RDF xmlns:n0="http://www.w3.org/1999/02/22-rdf-syntax-ns#"><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored specification fixing the applicability boundary of an assessment, including its stated population, environment and temporal conditions, with optional version and scenario bindings.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Assessment Context Specification</n1:label><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:AssessmentClaim"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:ConditionSpecification"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:EvidenceArtifact"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:EvidenceAttributionRecord"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:ProductCapability"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:ProductRealization"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:ProductVersion"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:ScenarioSpecification"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:ScopeSpecification"></n2:disjointWith></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:attributionAgent"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded assessor identifier. An identifier is operational metadata, not a new Agent concept or a verified identity.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceAttributionRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:attributionSource"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded source URI; kept separate from the assessor identifier and from evidence ownership.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceAttributionRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:attributionStance"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">One of supports, challenges, limits, unassessed. Stance belongs to the record, never globally to its carrier.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceAttributionRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:attributionTimestamp"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Time of the recorded attribution. Does not establish when the evidence carrier was generated.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceAttributionRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#dateTime"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:claimActualCapability"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">The actual capability under assessment. Paired with claimIntendedCapability; not a satisfaction assertion.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AssessmentClaim"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProductCapability"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:claimContext"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">One fixed applicability context; sharing a context does not imply sharing a claim.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AssessmentClaim"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:claimCriterion"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">One atomic assessment criterion. Compound criteria must have an explicit condition specification.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AssessmentClaim"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ConditionSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:claimIntendedCapability"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">The intended ability compared in this claim. No intended-to-actual entailment is introduced.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AssessmentClaim"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:CapabilitySpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:claimProduct"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A product-lineage subject. Exactly one subject is selected across the four subject relations.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AssessmentClaim"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:Product"></n1:range><n1:subPropertyOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:assessment-profile:0.4:claimSubject"></n1:subPropertyOf></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:claimRealization"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A concrete realization subject; capability assessments use this subject relation.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AssessmentClaim"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProductRealization"></n1:range><n1:subPropertyOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:assessment-profile:0.4:claimSubject"></n1:subPropertyOf></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:claimRequirement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored requirement subject, not the stakeholder intention.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AssessmentClaim"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:RequirementSpecification"></n1:range><n1:subPropertyOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:assessment-profile:0.4:claimSubject"></n1:subPropertyOf></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:claimStatement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">The proposition asserted by this authored claim; no truth assertion is inferred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AssessmentClaim"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:claimSubject"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AssessmentClaim"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb1b553a2e19547208877f648f95dd9bbe050a6ddaa7f01adf57f7cceb3738a80d7"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:claimVersion"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A specification-baseline subject; not an implemented system.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AssessmentClaim"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProductVersion"></n1:range><n1:subPropertyOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:assessment-profile:0.4:claimSubject"></n1:subPropertyOf></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:contextDescription"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Explicit bounded applicability description; not a full structured context ontology.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:contextScenario"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Optional reuse of authored scenario details without equating context and scenario identity.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScenarioSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:contextSource"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">URI identifying recorded authoring/source provenance, not proof of authority.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:contextVersion"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Optional baseline qualifier of the context, mandatory for a capability assessment in the reporting profile.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProductVersion"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:deferredStatement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Authored deferred content; distinct from exclusion.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScopeSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:excludedStatement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Authored excluded content; not a closed-world complement of the included content.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScopeSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:findingSource"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded observation provenance URI.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:FindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:findingStatement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Observation or issue content, distinct from its contextual evidential stance.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:FindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:includedStatement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Authored included content. Absence is not an assertion that the included set is empty.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScopeSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:scopeChangeRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A recorded change description for this scope baseline. It does not establish an applied implementation change.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScopeSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeRecord"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:scopeSource"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded source of the authored scope baseline.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScopeSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:scopeSupersedes"><n0:type n0:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded directed scope-baseline revision; branching and merging permitted, cycles forbidden.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScopeSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScopeSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:assessment-profile:0.4:versionScope"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">At most one consolidated authored scope baseline per product version. Unrecorded scope is allowed; partial documents must be consolidated or this contract revised.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProductVersion"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScopeSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An immutable dated information record assigning a status code under a stated scheme to one delivery work item, optionally qualified by one product version.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Delivery Work Item Status Record</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2b52ff560d0f05e68fc527699be9f9598838d311275d714df79b57b3cc98d301b"></n1:subClassOf><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:DeliveryStatusRecord"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:DeliveryWorkItem"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:ProductCapability"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:ProductRealization"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:ProductVersion"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:ReleaseSpecification"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:TestExecution"></n2:disjointWith><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:TestResult"></n2:disjointWith></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:executionContext"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">One fixed assessment applicability context for a concluded test occurrence. Repeated or differently contextualized runs are separate events.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:TestExecution"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:executionCriterion"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Explicit assessment criteria evaluated during the run. Case membership and shared labels do not establish criterion coverage.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:TestExecution"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ConditionSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:executionEndedAt"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">End of a concluded run, including an aborted run. Ongoing runs are outside this completed-event profile.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:TestExecution"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#dateTime"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:itemStatus"><n0:type n0:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">One item owns each status assertion; an item may have no record or many historical records. Release membership never propagates status.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DeliveryWorkItem"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:itemStatusChange"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Explicit change records cited by this work-item assertion; no applied-change entailment.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeRecord"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:itemStatusCode"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded code under the named workflow scheme; it is not proof of delivery.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:itemStatusReportedAt"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Time of this immutable report, not automatically the time of delivery.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#dateTime"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:itemStatusScheme"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Identifier of the interpretation scheme; this ontology does not impose a universal delivery lifecycle.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:itemStatusSource"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded report provenance, distinct from a workflow code.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:itemStatusVersion"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Optional exact baseline qualifier of this work-item assertion; changing a qualifier creates another record.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProductVersion"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:observedAuthority"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Observed authority identifier; required and different from the old authority for authority_changed findings.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:FindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:observedTarget"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Observed target identifier; required and different from the old target for target_changed findings.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:FindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:referenceRecordedAt"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded creation time of this fixed reference binding.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#dateTime"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:referenceReviewFinding"><n0:type n0:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A recorded review finding concerns at most one reference under this reporting profile. Several findings can concern one reference; ordinary findings need not concern any reference.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:FindingRecord"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:referenceRevisionLabel"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Optional authored revision label. A label alone does not establish freshness or a successor.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:referenceSupersedes"><n0:type n0:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An explicit successor reference record replaces an earlier recorded binding for its stated purpose. Branching is permitted; cycles are forbidden. No mutation or automatic identity merge.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:releaseStatusChange"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Explicit change records cited by this release-status assertion. This link does not mean an implementation change occurred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DeliveryStatusRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeRecord"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:releaseStatusCode"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded code under the named workflow scheme; it is not proof of delivery.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DeliveryStatusRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:releaseStatusReportedAt"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Time of this immutable report, not automatically the time of delivery.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DeliveryStatusRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#dateTime"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:releaseStatusScheme"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Identifier of the interpretation scheme; this ontology does not impose a universal delivery lifecycle.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DeliveryStatusRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:releaseStatusSource"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded report provenance, distinct from a workflow code.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DeliveryStatusRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:releaseStatusVersion"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Optional exact baseline qualifier of this immutable release-status assertion. Unqualified records are not copied to versions.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DeliveryStatusRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProductVersion"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:resultOutcome"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Local reporting code: passed, failed, aborted, inconclusive or unknown. A recorded pass does not entail claim truth or acceptance.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:TestResult"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:resultRecordedAt"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Report time at or after the recorded execution end.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:TestResult"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#dateTime"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:delivery-profile:0.5:resultSource"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Source identifier of the recorded execution result.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:TestResult"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf