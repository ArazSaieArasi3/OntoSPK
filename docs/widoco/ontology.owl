<?xml version="1.0"?>
<rdf:RDF xmlns="urn:productium:specification-profile:#"
     xml:base="urn:productium:specification-profile:"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="urn:productium:specification-profile:">
        <owl:versionInfo>IC-0.7 authored specification identity candidate</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- urn:product-ontology:assessment-profile:0.4:claimActualCapability -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:claimActualCapability">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:AssessmentClaim"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ProductCapability"/>
        <rdfs:comment>The actual capability under assessment. Paired with claimIntendedCapability; not a satisfaction assertion.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:claimContext -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:claimContext">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:AssessmentClaim"/>
        <rdfs:range rdf:resource="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"/>
        <rdfs:comment>One fixed applicability context; sharing a context does not imply sharing a claim.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:claimCriterion -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:claimCriterion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:AssessmentClaim"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ConditionSpecification"/>
        <rdfs:comment>One atomic assessment criterion. Compound criteria must have an explicit condition specification.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:claimIntendedCapability -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:claimIntendedCapability">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:AssessmentClaim"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:CapabilitySpecification"/>
        <rdfs:comment>The intended ability compared in this claim. No intended-to-actual entailment is introduced.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:claimProduct -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:claimProduct">
        <rdfs:subPropertyOf rdf:resource="urn:product-ontology:assessment-profile:0.4:claimSubject"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:AssessmentClaim"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:Product"/>
        <rdfs:comment>A product-lineage subject. Exactly one subject is selected across the four subject relations.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:claimRealization -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:claimRealization">
        <rdfs:subPropertyOf rdf:resource="urn:product-ontology:assessment-profile:0.4:claimSubject"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:AssessmentClaim"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ProductRealization"/>
        <rdfs:comment>A concrete realization subject; capability assessments use this subject relation.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:claimRequirement -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:claimRequirement">
        <rdfs:subPropertyOf rdf:resource="urn:product-ontology:assessment-profile:0.4:claimSubject"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:AssessmentClaim"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:RequirementSpecification"/>
        <rdfs:comment>An authored requirement subject, not the stakeholder intention.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:claimSubject -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:claimSubject">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:AssessmentClaim"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="urn:productium:specification-profile:Product"/>
                    <rdf:Description rdf:about="urn:productium:specification-profile:ProductRealization"/>
                    <rdf:Description rdf:about="urn:productium:specification-profile:ProductVersion"/>
                    <rdf:Description rdf:about="urn:productium:specification-profile:RequirementSpecification"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:claimVersion -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:claimVersion">
        <rdfs:subPropertyOf rdf:resource="urn:product-ontology:assessment-profile:0.4:claimSubject"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:AssessmentClaim"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ProductVersion"/>
        <rdfs:comment>A specification-baseline subject; not an implemented system.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:contextScenario -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:contextScenario">
        <rdfs:domain rdf:resource="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ScenarioSpecification"/>
        <rdfs:comment>Optional reuse of authored scenario details without equating context and scenario identity.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:contextVersion -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:contextVersion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ProductVersion"/>
        <rdfs:comment>Optional baseline qualifier of the context, mandatory for a capability assessment in the reporting profile.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:scopeChangeRecord -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:scopeChangeRecord">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ScopeSpecification"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ChangeRecord"/>
        <rdfs:comment>A recorded change description for this scope baseline. It does not establish an applied implementation change.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:scopeSupersedes -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:scopeSupersedes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ScopeSpecification"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ScopeSpecification"/>
        <rdfs:comment>Recorded directed scope-baseline revision; branching and merging permitted, cycles forbidden.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:versionScope -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:assessment-profile:0.4:versionScope">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ProductVersion"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ScopeSpecification"/>
        <rdfs:comment>At most one consolidated authored scope baseline per product version. Unrecorded scope is allowed; partial documents must be consolidated or this contract revised.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:executionContext -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:delivery-profile:0.5:executionContext">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:TestExecution"/>
        <rdfs:range rdf:resource="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"/>
        <rdfs:comment>One fixed assessment applicability context for a concluded test occurrence. Repeated or differently contextualized runs are separate events.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:executionCriterion -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:delivery-profile:0.5:executionCriterion">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:TestExecution"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ConditionSpecification"/>
        <rdfs:comment>Explicit assessment criteria evaluated during the run. Case membership and shared labels do not establish criterion coverage.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:itemStatus -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:delivery-profile:0.5:itemStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:DeliveryWorkItem"/>
        <rdfs:range rdf:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"/>
        <rdfs:comment>One item owns each status assertion; an item may have no record or many historical records. Release membership never propagates status.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:itemStatusChange -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:delivery-profile:0.5:itemStatusChange">
        <rdfs:domain rdf:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ChangeRecord"/>
        <rdfs:comment>Explicit change records cited by this work-item assertion; no applied-change entailment.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:itemStatusVersion -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:delivery-profile:0.5:itemStatusVersion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ProductVersion"/>
        <rdfs:comment>Optional exact baseline qualifier of this work-item assertion; changing a qualifier creates another record.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:referenceReviewFinding -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:delivery-profile:0.5:referenceReviewFinding">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ExternalReferenceRecord"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:FindingRecord"/>
        <rdfs:comment>A recorded review finding concerns at most one reference under this reporting profile. Several findings can concern one reference; ordinary findings need not concern any reference.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:referenceSupersedes -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:delivery-profile:0.5:referenceSupersedes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ExternalReferenceRecord"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ExternalReferenceRecord"/>
        <rdfs:comment>An explicit successor reference record replaces an earlier recorded binding for its stated purpose. Branching is permitted; cycles are forbidden. No mutation or automatic identity merge.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:releaseStatusChange -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:delivery-profile:0.5:releaseStatusChange">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:DeliveryStatusRecord"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ChangeRecord"/>
        <rdfs:comment>Explicit change records cited by this release-status assertion. This link does not mean an implementation change occurred.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:releaseStatusVersion -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:delivery-profile:0.5:releaseStatusVersion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:DeliveryStatusRecord"/>
        <rdfs:range rdf:resource="urn:productium:specification-profile:ProductVersion"/>
        <rdfs:comment>Optional exact baseline qualifier of this immutable release-status assertion. Unqualified records are not copied to versions.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:architecture_intendedRealizedByComponent -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:architecture_intendedRealizedByComponent">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:FeatureSpecification"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Architecture%3AComponent"/>
        <rdfs:comment>The feature specification explicitly names an external component as a proposed realization target.</rdfs:comment>
        <rdfs:label>intendedRealizedByComponent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:architecture_intendedRealizedByService -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:architecture_intendedRealizedByService">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:FeatureSpecification"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Architecture%3AService"/>
        <rdfs:comment>The feature specification names an external service as a proposed realization target.</rdfs:comment>
        <rdfs:label>intendedRealizedByService</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:architecture_intendedSatisfiedByArchitectureElement -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:architecture_intendedSatisfiedByArchitectureElement">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:RequirementSpecification"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Architecture%3AArchitectureElement"/>
        <rdfs:comment>The requirement specification records an intended architectural satisfaction allocation.</rdfs:comment>
        <rdfs:label>intendedSatisfiedByArchitectureElement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:architecture_intendedSatisfiedByInterface -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:architecture_intendedSatisfiedByInterface">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:RequirementSpecification"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Architecture%3AInterface"/>
        <rdfs:comment>The requirement specification records an intended satisfaction allocation to an external interface.</rdfs:comment>
        <rdfs:label>intendedSatisfiedByInterface</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:architecture_intendedSupportedByArchitectureElement -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:architecture_intendedSupportedByArchitectureElement">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:CapabilitySpecification"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Architecture%3AArchitectureElement"/>
        <rdfs:comment>The intended capability specification identifies an architectural element proposed to support it.</rdfs:comment>
        <rdfs:label>intendedSupportedByArchitectureElement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r107_intendedToSupport -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r107_intendedToSupport">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:CapabilitySpecification"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Business%3ABusinessCapability"/>
        <rdfs:comment>The capability specification records an intention to support an externally governed business capability.</rdfs:comment>
        <rdfs:label>intendedToSupport</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r116_references -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r116_references">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:PositioningStatement"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Business%3AValueProposition"/>
        <rdfs:comment>The positioning statement explicitly cites an externally governed value proposition.</rdfs:comment>
        <rdfs:label>references</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r157_evidencedBy -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r157_evidencedBy">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ProblemStatement"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:EvidenceLayer%3AEvidence"/>
        <rdfs:comment>The problem statement explicitly cites external evidence offered for its formulation, without asserting that its claim is true.</rdfs:comment>
        <rdfs:label>evidencedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r160_evidencedBy -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r160_evidencedBy">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:HypothesisSpecification"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:EvidenceLayer%3AEvidence"/>
        <rdfs:comment>The hypothesis specification explicitly cites external evidence offered in assessing its proposition.</rdfs:comment>
        <rdfs:label>evidencedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r162_evidencedBy -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r162_evidencedBy">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ProductMarketFitAssessment"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:EvidenceLayer%3AEvidence"/>
        <rdfs:comment>The product-market-fit assessment cites external evidence informing its recorded assessment.</rdfs:comment>
        <rdfs:label>evidencedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r167_supports -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r167_supports">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:QualityRequirementSpecification"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Business%3ABusinessGoal"/>
        <rdfs:comment>The quality requirement records an intended contribution to an external business goal.</rdfs:comment>
        <rdfs:label>supports</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r185_referencesValueProposition -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r185_referencesValueProposition">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:Product"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Business%3AValueProposition"/>
        <rdfs:comment>The product has an explicit knowledge link to an externally governed value proposition.</rdfs:comment>
        <rdfs:label>referencesValueProposition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r186_targets -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r186_targets">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:OfferingSpecification"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Market%3ACustomerSegment"/>
        <rdfs:comment>The offering specification identifies an external segment in its intended audience.</rdfs:comment>
        <rdfs:label>targets</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r187_includesService -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r187_includesService">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:OfferingSpecification"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Business%3AService"/>
        <rdfs:comment>The offering specification describes an external service as included in the intended offer; it does not assert an executed service event.</rdfs:comment>
        <rdfs:label>includesService</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r188_referencesVariantConfiguration -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r188_referencesVariantConfiguration">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ProductVariantReference"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:ProductLine%3AProductConfiguration"/>
        <rdfs:comment>The local variant reference records an external configuration relevant to its fixed variant referent; the reference record itself is not configured by that target.</rdfs:comment>
        <rdfs:label>referencesVariantConfiguration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r189_targets -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r189_targets">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:VisionStatement"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Market%3ACustomerSegment"/>
        <rdfs:comment>The vision statement identifies an external segment within its intended audience.</rdfs:comment>
        <rdfs:label>targets</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r190_referencesValueProposition -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r190_referencesValueProposition">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:VisionStatement"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:Business%3AValueProposition"/>
        <rdfs:comment>The vision statement explicitly cites an external value proposition.</rdfs:comment>
        <rdfs:label>referencesValueProposition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r192_references -->


    <owl:ObjectProperty rdf:about="urn:product-ontology:relation-profile:0.7:r192_references">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ProblemSolutionFitAssessment"/>
        <rdfs:range rdf:resource="urn:product-ontology:external-boundary:0.7:ExternalUnresolved%3AEvidence"/>
        <rdfs:comment>The problem-solution-fit assessment cites external evidence considered in its recorded appraisal.</rdfs:comment>
        <rdfs:label>references</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- urn:product-ontology:relation-profile:0.7:r194_referencesMentalModel -->


