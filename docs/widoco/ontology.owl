    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- urn:product-ontology:assessment-profile:0.4:attributionAgent -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:attributionAgent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:EvidenceAttributionRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Recorded assessor identifier. An identifier is operational metadata, not a new Agent concept or a verified identity.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:attributionSource -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:attributionSource">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:EvidenceAttributionRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Recorded source URI; kept separate from the assessor identifier and from evidence ownership.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:attributionStance -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:attributionStance">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:EvidenceAttributionRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>One of supports, challenges, limits, unassessed. Stance belongs to the record, never globally to its carrier.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:attributionTimestamp -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:attributionTimestamp">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:EvidenceAttributionRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Time of the recorded attribution. Does not establish when the evidence carrier was generated.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:claimStatement -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:claimStatement">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:AssessmentClaim"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The proposition asserted by this authored claim; no truth assertion is inferred.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:contextDescription -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:contextDescription">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Explicit bounded applicability description; not a full structured context ontology.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:contextSource -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:contextSource">
        <rdfs:domain rdf:resource="urn:product-ontology:assessment-profile:0.4:AssessmentContextSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>URI identifying recorded authoring/source provenance, not proof of authority.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:deferredStatement -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:deferredStatement">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ScopeSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Authored deferred content; distinct from exclusion.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:excludedStatement -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:excludedStatement">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ScopeSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Authored excluded content; not a closed-world complement of the included content.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:findingSource -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:findingSource">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:FindingRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Recorded observation provenance URI.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:findingStatement -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:findingStatement">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:FindingRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Observation or issue content, distinct from its contextual evidential stance.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:includedStatement -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:includedStatement">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ScopeSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Authored included content. Absence is not an assertion that the included set is empty.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:assessment-profile:0.4:scopeSource -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:assessment-profile:0.4:scopeSource">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ScopeSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Recorded source of the authored scope baseline.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:executionEndedAt -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:executionEndedAt">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:TestExecution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>End of a concluded run, including an aborted run. Ongoing runs are outside this completed-event profile.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:itemStatusCode -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:itemStatusCode">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Recorded code under the named workflow scheme; it is not proof of delivery.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:itemStatusReportedAt -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:itemStatusReportedAt">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Time of this immutable report, not automatically the time of delivery.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:itemStatusScheme -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:itemStatusScheme">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Identifier of the interpretation scheme; this ontology does not impose a universal delivery lifecycle.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:itemStatusSource -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:itemStatusSource">
        <rdfs:domain rdf:resource="urn:product-ontology:delivery-profile:0.5:DeliveryWorkItemStatusRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Recorded report provenance, distinct from a workflow code.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:observedAuthority -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:observedAuthority">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:FindingRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Observed authority identifier; required and different from the old authority for authority_changed findings.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:observedTarget -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:observedTarget">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:FindingRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Observed target identifier; required and different from the old target for target_changed findings.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:referenceRecordedAt -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:referenceRecordedAt">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ExternalReferenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Recorded creation time of this fixed reference binding.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:referenceRevisionLabel -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:referenceRevisionLabel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ExternalReferenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Optional authored revision label. A label alone does not establish freshness or a successor.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:releaseStatusCode -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:releaseStatusCode">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:DeliveryStatusRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Recorded code under the named workflow scheme; it is not proof of delivery.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:releaseStatusReportedAt -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:releaseStatusReportedAt">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:DeliveryStatusRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Time of this immutable report, not automatically the time of delivery.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:releaseStatusScheme -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:releaseStatusScheme">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:DeliveryStatusRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Identifier of the interpretation scheme; this ontology does not impose a universal delivery lifecycle.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:releaseStatusSource -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:releaseStatusSource">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:DeliveryStatusRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Recorded report provenance, distinct from a workflow code.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:resultOutcome -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:resultOutcome">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:TestResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Local reporting code: passed, failed, aborted, inconclusive or unknown. A recorded pass does not entail claim truth or acceptance.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:resultRecordedAt -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:resultRecordedAt">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:TestResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Report time at or after the recorded execution end.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:resultSource -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:resultSource">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:TestResult"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Source identifier of the recorded execution result.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:reviewReason -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:reviewReason">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:FindingRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>For reference-review findings only: target_changed, authority_changed, target_unreachable or scheduled_review.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:delivery-profile:0.5:reviewRecordedAt -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:delivery-profile:0.5:reviewRecordedAt">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:FindingRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Required for a reference-review finding; observations must not predate the referenced binding.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:trace-profile:0.6:changeOccurrenceReference -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:trace-profile:0.6:changeOccurrenceReference">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ChangeRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Recorded identifier for the asserted modification occurrence; not a fabricated event individual.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:trace-profile:0.6:changeRecordedAt -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:trace-profile:0.6:changeRecordedAt">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ChangeRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Time of the immutable change report.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:trace-profile:0.6:changeSource -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:trace-profile:0.6:changeSource">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ChangeRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Source provenance of the change assertion.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:trace-profile:0.6:changeStatement -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:trace-profile:0.6:changeStatement">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ChangeRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Content of the asserted modification; not proof of application.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:trace-profile:0.6:decisionRationale -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:trace-profile:0.6:decisionRationale">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:DecisionRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Recorded rationale explaining selection, nonselection or handling. The string is not machine-verified reasoning.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:trace-profile:0.6:decisionSource -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:trace-profile:0.6:decisionSource">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:DecisionRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Recorded provenance of this decision record.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:trace-profile:0.6:dependencySource -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:trace-profile:0.6:dependencySource">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:DependencySpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Recorded source of the authored dependency assertion.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:trace-profile:0.6:proposalSource -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:trace-profile:0.6:proposalSource">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ChangeProposalSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Provenance of the authored proposal.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:trace-profile:0.6:proposalStatement -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:trace-profile:0.6:proposalStatement">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ChangeProposalSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Authored desired delta, distinct from an assertion that it occurred.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:product-ontology:trace-profile:0.6:usabilityRecommendation -->


    <owl:DatatypeProperty rdf:about="urn:product-ontology:trace-profile:0.6:usabilityRecommendation">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:UsabilityFindingRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Advice authored within this finding and sharing its provenance. Absence is unknown; no separate recommendation identity or implemented fix is asserted.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- urn:productium:specification-profile:conditionStatement -->


    <owl:DatatypeProperty rdf:about="urn:productium:specification-profile:conditionStatement">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ConditionSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- urn:productium:specification-profile:personaDescription -->


    <owl:DatatypeProperty rdf:about="urn:productium:specification-profile:personaDescription">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:PersonaSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- urn:productium:specification-profile:referencePurpose -->


    <owl:DatatypeProperty rdf:about="urn:productium:specification-profile:referencePurpose">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ExternalReferenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- urn:productium:specification-profile:scenarioActions -->


    <owl:DatatypeProperty rdf:about="urn:productium:specification-profile:scenarioActions">
        <rdfs:domain rdf:resource="urn:productium:specification-profile:ScenarioSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


