operty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Explicit citation of an evidence-attribution record, including its claim and stance. Citation is not verification of the marketing statement.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AdoptionHypothesisSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceAttributionRecord"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:adoptionCitesInsight"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Explicit citation of a local reference to a separately governed marketing insight; sharing a plan is insufficient.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:AdoptionHypothesisSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:MarketingInsightReference"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:changeDecision"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Explicit decision records cited as handling the recorded modification. Release membership is not handling.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DecisionRecord"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:changeFeature"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded feature subject of an asserted modification; exclusive with changeScope. No actual implementation change is inferred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:FeatureSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:changeOccurrenceReference"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded identifier for the asserted modification occurrence; not a fabricated event individual.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:changeRecordedAt"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Time of the immutable change report.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#dateTime"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:changeScope"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded scope subject of an asserted modification; exclusive with changeFeature in this bounded reporting profile.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScopeSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:changeSource"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Source provenance of the change assertion.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:changeStatement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Content of the asserted modification; not proof of application.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:changeTask"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Local external task references cited as handling; no task completion or ownership transfer is inferred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:TaskReference"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:decisionConsidersSolution"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Explicit alternatives considered in this decision; consideration is not selection.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DecisionRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:SolutionSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:decisionEvidence"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Cited attributed evidence used in the recorded rationale; citation does not establish decision correctness or claim truth.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DecisionRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceAttributionRecord"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:decisionRationale"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded rationale explaining selection, nonselection or handling. The string is not machine-verified reasoning.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DecisionRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:decisionSelectsSolution"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Explicitly selected alternatives; multiple selections or no selection are permitted. Every selected solution is considered.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DecisionRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:SolutionSpecification"></n1:range><n1:subPropertyOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:product-ontology:trace-profile:0.6:decisionConsidersSolution"></n1:subPropertyOf></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:decisionSource"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded provenance of this decision record.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DecisionRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:dependencyActualCapabilityTarget"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Actual capability target, not an intended ability. The bearer must be recorded separately.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DependencySpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProductCapability"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:dependencyCapabilitySpecificationTarget"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Intended capability specification target; does not entail an actual capability.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DependencySpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:CapabilitySpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:dependencyCondition"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">One authored condition baseline for an atomic dependency specification. Compound conditions can be represented by one authored condition specification.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DependencySpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ConditionSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:dependencyExternalTarget"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Local reference to a separately governed target, including resources; the referenced target is not re-owned.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DependencySpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:dependencyProductTarget"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Optional local product target; exactly one of the four typed target alternatives in the complete dependency profile.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DependencySpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:Product"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:dependencySource"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Recorded source of the authored dependency assertion.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DependencySpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:narrativeCitesEvidence"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Explicit citation of an evidence-attribution record, including its claim and stance. Citation is not verification of the marketing statement.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:CompetitiveNarrative"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceAttributionRecord"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:narrativeCitesInsight"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Explicit citation of a local reference to a separately governed marketing insight; sharing a plan is insufficient.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:CompetitiveNarrative"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:MarketingInsightReference"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:proposalFeature"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Intended feature subject. Supports a proposal even when no ChangeRecord exists.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeProposalSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:FeatureSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:proposalScope"><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Intended scope subject; exclusive with proposalFeature. A proposal does not create a change occurrence.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeProposalSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScopeSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:proposalSource"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Provenance of the authored proposal.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeProposalSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#anyURI"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:proposalStatement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Authored desired delta, distinct from an assertion that it occurred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ChangeProposalSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:stepPrecedes"><n0:type n0:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"></n0:type><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An explicit precedence constraint between steps in the same owning flow. Branches and partial order are permitted. This is not an execution transition or an immediate-next relation.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:InteractionStepSpecification"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:InteractionStepSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:usabilityInformationArchitecture"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An additional explicitly recorded experience subject. The finding retains its constitutive flow or screen subject; no implemented improvement is inferred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:UsabilityFindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:InformationArchitectureSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:usabilityJourney"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An additional explicitly recorded experience subject. The finding retains its constitutive flow or screen subject; no implemented improvement is inferred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:UsabilityFindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:JourneySpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:usabilityJourneyStage"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An additional explicitly recorded experience subject. The finding retains its constitutive flow or screen subject; no implemented improvement is inferred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:UsabilityFindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:JourneyStageSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:usabilityPersona"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An additional explicitly recorded experience subject. The finding retains its constitutive flow or screen subject; no implemented improvement is inferred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:UsabilityFindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:PersonaSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:usabilityRecommendation"><n0:type n0:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Advice authored within this finding and sharing its provenance. Absence is unknown; no separate recommendation identity or implemented fix is asserted.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:UsabilityFindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="http://www.w3.org/2001/XMLSchema#string"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:usabilityStep"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An additional explicitly recorded experience subject. The finding retains its constitutive flow or screen subject; no implemented improvement is inferred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:UsabilityFindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:InteractionStepSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:usabilityTouchpoint"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An additional explicitly recorded experience subject. The finding retains its constitutive flow or screen subject; no implemented improvement is inferred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:UsabilityFindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:TouchpointSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:usabilityUIState"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An additional explicitly recorded experience subject. The finding retains its constitutive flow or screen subject; no implemented improvement is inferred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:UsabilityFindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:UIStateSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:product-ontology:trace-profile:0.6:usabilityUserRole"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An additional explicitly recorded experience subject. The finding retains its constitutive flow or screen subject; no implemented improvement is inferred.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:UsabilityFindingRecord"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:UserRoleSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:productium:specification-profile:"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Ontology"></n0:type><n2:versionInfo xmlns:n2="http://www.w3.org/2002/07/owl#">IC-0.7 authored specification identity candidate</n2:versionInfo></n0:Description><n0:Description n0:about="urn:productium:specification-profile:AcceptanceCriterionSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored ConditionSpecification whose constitutive content includes condition used in the authored acceptance contract. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">AcceptanceCriterionSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ConditionSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:AcquisitionHypothesisSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A hypothesis specification whose constitutive claim concerns acquiring intended users or customers.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">AcquisitionHypothesisSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:HypothesisSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:AdoptionHypothesisSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A hypothesis specification whose constitutive claim concerns adoption barriers or adoption behavior.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">AdoptionHypothesisSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:HypothesisSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:AssessmentClaim"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored assessment-claim artifact fixing subject, criterion, scope and the proposition under consideration.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">AssessmentClaim</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb315ee93ad5de75bf4605d7fc3a69c371da9085564099d7af7f07601b155d6ce48"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb3634800231aee8de0dc6d6949a1751951bd2258f96b364b92c45d053066cc7b03"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb36765583aabf9259caa2c90a6192fe095ce1fec5c74be61a8f893d389ca5f2acd"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:BundleSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed composition specification referencing offerings intended to be presented together.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">BundleSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:BusinessRuleReference"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A local reference artifact to an externally governed business rule. Its business-rule purpose is constitutive to the authored reference record, not a temporary role of the target.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">BusinessRuleReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:CapabilitySpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A version-scoped specification of an intended ability, irrespective of its implementation.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">CapabilitySpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb1d012e590065e8f8f2d1bd698060b310e83760064479c93207b960a85089c4c5e"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb24c15538b81f9fcca3f6a314131d9723d431593c240e830872abfa537157c4b62"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2c352358ed237d28d7dcafcbae0ed264162d27d70f799c39f7dd395ddb4f64a74"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ChangeProposalSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored proposal specifying a desired change and its intended target.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ChangeProposalSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ChangeRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A dated record describing an asserted modification to an identified product artifact or state.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ChangeRecord</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceArtifact"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:CommitmentLevelDefinition"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed term definition for a planning-commitment label within a named scheme.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">CommitmentLevelDefinition</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:CompetitiveNarrative"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored narrative presenting scoped differentiation claims and their evidential references.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">CompetitiveNarrative</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ConditionSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored semantic condition unit with a fixed proposition, applicability context and authoring provenance; distinct from a stakeholder intention, observed result or containing scenario.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ConditionSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2e166ac1fb512f375a11645ef1ea7bbdf076dde9a7c4cbbe4f458ca81c6ae9dbd"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2fa99e2d5d0441abdcd2c6dd078436d073060691dc0c59cb306b9dcedde8288b1"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb360b9a318bcdca354a427c07b7e6a0d4cd451786e47658260861631a9f7bcdaaf"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ConfidenceAssessment"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A dated assessment of planning confidence with explicit subject, assessor, evidence context and scale.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ConfidenceAssessment</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ConstraintSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored ConditionSpecification whose constitutive content includes restriction constitutive to the authored specification. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ConstraintSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ConditionSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:DecisionCriterionSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored rule or criterion specification used to appraise product alternatives.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">DecisionCriterionSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:DecisionRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An immutable record of a product decision, its considered alternatives, rationale and provenance.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">DecisionRecord</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:DeliveryStatusRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An immutable dated report assigning a delivery-status value to one Release.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">DeliveryStatusRecord</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:DeliveryWorkItem"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed work-item artifact about intended delivery scope and its referenced functional specifications.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">DeliveryWorkItem</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:DependencySpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored claim that one product depends on an identified product, capability or resource under a stated dependency condition.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">DependencySpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb30d61566dd8142260d2c17373acec40c9d9ba3e1894aaa732c0589f3e1a31034f"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:EnablerSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored supporting-work specification intended to enable a feature or capability specification.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">EnablerSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:EvidenceArtifact"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An abstract category of information artifacts eligible to carry evidence in this bounded profile.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">EvidenceArtifact</n1:label><n2:disjointWith xmlns:n2="http://www.w3.org/2002/07/owl#" n0:resource="urn:productium:specification-profile:AssessmentClaim"></n2:disjointWith></n0:Description><n0:Description n0:about="urn:productium:specification-profile:EvidenceAttributionRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An information record documenting an assessor's attribution of one carrier to one assessment claim.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">EvidenceAttributionRecord</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2bf7deae558aed0187bfb2e8c86b0f7142fe0858989047492ae42fd2de4a413b5"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2cde1789120f180e70970853cfe5bdea2acb6af4dbb1fb3e7f3a52200578365dd"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ExternalReferenceRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A local information record of a fixed binding to a separately governed referent, with recorded authority, provenance and constitutive purpose set.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ExternalReferenceRecord</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb310859c0a662d8f1befe8016c340cba8c936c47c33b1b9de1aef54fa9f547ca12"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb322d7585360bd8c9a9d8f62615ca659db682e305e998c3796b27280595ef2cba6"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb38e748518011621f271d718072944805ba29200f79aeb3a2cddbffbf51a216d23"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:FeatureFlagSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A specification of a named feature-activation control and its intended scoping policy.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">FeatureFlagSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:FeatureSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored functional-unit specification linking intended behavior, user value and acceptance criteria.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">FeatureSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:FindingRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored observation or issue record with a fixed finding statement, subject bindings and provenance.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">FindingRecord</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceArtifact"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:FunctionalRequirementSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A requirement specification with an essential normative commitment about intended behavior or functionality.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">FunctionalRequirementSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:RequirementSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:GoToMarketSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed strategy specification linking positioning, audiences and intended market-entry activity.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">GoToMarketSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:GoalSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored ConditionSpecification whose constitutive content includes desired product condition. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">GoalSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ConditionSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:HypothesisSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored testable-claim artifact fixing its claim, intended scope and refutation or support conditions.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">HypothesisSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:InformationArchitectureSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored model of information organization, hierarchy and navigation.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">InformationArchitectureSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:InitiativeSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored plan coordinating goals, scope and expected product outcomes.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">InitiativeSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:InteractionStepSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A scoped action or decision-step specification in one user-flow design.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">InteractionStepSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:JourneySpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored structured experience model containing scoped stage specifications.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">JourneySpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:JourneyStageSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored constituent stage specification owned by exactly one JourneySpecification.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">JourneyStageSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:LaunchSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A plan specification for introducing a product or change to an intended audience.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">LaunchSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:LifecycleSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored scheme describing lifecycle-stage meanings applicable to products.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">LifecycleSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:LifecycleStageSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A scoped definition of a lifecycle stage within one lifecycle specification.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">LifecycleStageSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:MarketingGoalSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A goal specification whose constitutive desired result concerns product marketing or market introduction.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">MarketingGoalSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:GoalSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:MarketingInsightReference"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed local reference artifact with one canonical target and an explicitly supplied owner identifier. Its marketing-insight purpose is constitutive to the authored reference record, not a temporary role of the target.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">MarketingInsightReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:MessagingSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored specification of audience-directed messages and supporting claims.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">MessagingSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:MilestoneSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored target-condition specification marking intended planning progress.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">MilestoneSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:OfferingSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A catalog specification of how one product is intended to be offered to an audience under stated terms.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">OfferingSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:OpportunityStatement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed statement artifact identifying a possible value improvement in context.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">OpportunityStatement</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:OutcomeSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored ConditionSpecification whose constitutive content includes expected measurable product condition. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">OutcomeSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ConditionSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:PersonaSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored model of a user archetype, fixing a behavioral profile, population/use context and research provenance; not a person, group of actual users or their temporary role.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">PersonaSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb24a2426f91999d60835d69615f56cb451d3b0a83c909a0feb4471790d7a5d03fe"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb296cef9dca7cd54d7d73de120286b9b53bbdc28e927353b295f4466977acf8c77"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2a50d52a037405cf2492f7498a9360efa3c65d3c26fb8fb6d1ee78b3453fd2e04"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:PlanningHorizonDefinition"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed term definition specifying the meaning of a planning-horizon label in a named scheme.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">PlanningHorizonDefinition</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:PortfolioEntry"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed entry in one portfolio, optionally referencing a product while a broader target binding is being specified.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">PortfolioEntry</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:PositioningStatement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored statement specifying intended product perception for a target audience relative to alternatives.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">PositioningStatement</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:PrioritizationCriterionSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A decision-criterion specification whose constitutive purpose is to justify or compute a planning rank.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">PrioritizationCriterionSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:DecisionCriterionSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:PriorityAssessment"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A dated contextual ranking assessment recording a rank for a roadmap entry within a named comparison set and scale.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">PriorityAssessment</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ProblemSolutionFitAssessment"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A dated assessment record about the proposed fit of a problem statement and a solution specification.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ProblemSolutionFitAssessment</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ProblemStatement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed statement artifact describing a candidate or evidenced problem.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ProblemStatement</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:Product"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed intentional product artifact with continuing constitutive purpose and stewardship lineage; not a deployment or a database row.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Product</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2016b3c8724b9f55bfbd757006fabfa83342b8fac7504d8eed6a0429dcea9cee6"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ProductCapability"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An actual intrinsic disposition of one concrete ProductRealization as a configured functional whole. Intended behavior, successful execution, a specification and a machine label are not the disposition.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ProductCapability</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb17b58d492d8c274d8f1173770fa593003193676d2c3faebab6d9204859d317d21"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb21c933c6675b3f6f52bb62cc56fd164ab8bb70d07387fb64a93caa90de388d7c9"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ProductFamilyReference"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A local reference artifact identifying a product-family target governed by an external owner. Its product-family purpose is constitutive to the authored reference record, not a temporary role of the target.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ProductFamilyReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ProductLineReference"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A local reference artifact identifying an externally governed product line. Its product-line purpose is constitutive to the authored reference record, not a temporary role of the target.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ProductLineReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ProductMarketFitAssessment"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A dated assessment record about a product in an explicitly identified market context.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ProductMarketFitAssessment</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ProductMetricReference"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A local reference artifact binding a product measurement context to an externally governed metric. Its product-metric purpose is constitutive to the authored reference record, not a temporary role of the target.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ProductMetricReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ProductPortfolio"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed strategic arrangement organizing products, entries and planning references under a continuing portfolio mandate.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ProductPortfolio</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ProductRealization"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A concrete, causally integrated computing-system artifact configured to enact one fixed product-version baseline. It is the deployed functional whole, not its record, hosting machine, execution event or deployment interval.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ProductRealization</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb1a35d6c7f45b7e0e533a0ad42e257a7ffcf627064df08d1c40be1df38f92744fa"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb292b5055f33256a14b27d9b8ed92a27cbce81033473f7b70d8b13673e397286d5"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb3346f7d7bfd6162c5685f28f1d8570358dfb5c3da45ade8fe4ad391acfac7149a"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ProductStatusRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A dated contextual assertion assigning a status value to one product.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ProductStatusRecord</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ProductVariantReference"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A local reference artifact identifying an externally governed product variant. Its product-variant purpose is constitutive to the authored reference record, not a temporary role of the target.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ProductVariantReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ProductVersion"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An immutable approved specification baseline for one Product.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ProductVersion</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb1770c299b5b614928d0e4e8c9de5e49b6cd0422246ff6a86868835387443a3cdb"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb1980d5ec7e037f8c77cebbaee28bddb64c9f0d235c0c520714b6542b3120173fc"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb26a4b799a273a8c2721940eecb9403ee9ac609f311ff3d8e76ac0dedff0943af1"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:QualityRequirementSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A requirement specification with an essential normative commitment about a measurable quality under defined conditions.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">QualityRequirementSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:RequirementSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ReleaseEvidenceRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An evidence-attribution record whose constitutive assessment purpose is release.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ReleaseEvidenceRecord</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceAttributionRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ReleaseSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed specification of a planned delivery increment and its intended contents.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ReleaseSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:RequirementRationaleStatement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored justification statement explaining why a requirement specification is needed.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">RequirementRationaleStatement</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:RequirementScenarioSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored ScenarioSpecification whose constitutive content includes requirement/acceptance illustration. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">RequirementScenarioSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScenarioSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:RequirementSourceReference"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A local provenance reference artifact identifying an origin used in deriving a requirement specification. Its requirement-source purpose is constitutive to the authored reference record, not a temporary role of the target.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">RequirementSourceReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:RequirementSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored ConditionSpecification whose constitutive content includes required product condition. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">RequirementSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ConditionSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:Roadmap"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed planning-projection artifact referencing canonical product knowledge.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Roadmap</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:RoadmapEntry"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A scoped entry in one roadmap referencing intended initiatives, features or delivery targets.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">RoadmapEntry</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ScenarioSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored structured situation description fixing context, preconditions, ordered stimulus/action description and expected condition units; distinct from each actual occurrence.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ScenarioSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2d2398826ad20652f586f6261b017549a90a71df4c863bf16da64fec810c1a685"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2e89cdb516b3f9c77ee798e4bcca047dfff1d3bc8fde59d8db9dfce82d95cf786"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb345b57e968b1d4868d36bd42a8f293f55fda1e1b13c049dcb82a0e56d2a08b1da"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb349c9234ab64789dc829e0ac3f8804a2ad7681d1b2af2203f1f312b3e00f1c435"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb370f97e9e1a8802bf43aea4d59ea64f5c6bf98caa3d14fa13945603592255bdd8"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ScopeSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored specification of included, excluded and deferred product scope.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ScopeSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ScreenSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored view specification with layout, interaction and state commitments.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ScreenSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:SolutionHypothesisSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A hypothesis specification whose constitutive claim concerns a proposed solution addressing a problem.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">SolutionHypothesisSpecification</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:HypothesisSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:SolutionSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored product-level solution proposal describing how problems or opportunities are intended to be addressed.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">SolutionSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:TargetMarketReference"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A local reference artifact to an externally governed target market. Its target-market purpose is constitutive to the authored reference record, not a temporary role of the target.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">TargetMarketReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:TargetSegmentReference"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A local reference artifact to an externally governed segment in an identified segmentation context. Its target-segment purpose is constitutive to the authored reference record, not a temporary role of the target.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">TargetSegmentReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:TargetWindowAssignment"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A planning record assigning a bounded target interval to one roadmap entry.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">TargetWindowAssignment</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:TaskReference"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A local reference artifact identifying an externally governed implementation task. Its implementation-task purpose is constitutive to the authored reference record, not a temporary role of the target.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">TaskReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:TestCase"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A ScenarioSpecification that includes an operational test procedure and expected conditions. Repeated executions reuse the specification and remain distinct events.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">TestCase</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScenarioSpecification"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb1807dfa5f6d63d826de1c7a86c36bc09dbe8e86aebb24212d51b17d68d09a5799"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:TestDataReference"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A local reference artifact identifying a versioned dataset used in test design or execution. Its test-data purpose is constitutive to the authored reference record, not a temporary role of the target.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">TestDataReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:TestExecution"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A concluded attempt concerning one declared TestCase and ProductRealization. A setup-only abort does not establish actual target participation. One consolidated result documents the attempt.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">TestExecution</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2282c2ce25d7729f8ff8f9487a56f9be357c9dc3b0c5834e3f5ecf27fbec1720d"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb23b22f320c1807ff1ee17da5124a00868c77ec57a419d94d54ba4b88b8299d3ee"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2925650d134d5b58695ccdf57b5642d3c61e16b74b15dace5b935c2d163123110"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2e0669912b0ca1bbcbf881f783048e97f7bc5e2655eebe97623bd615c667175ae"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb350f8bdb6dabab681978a3051a0eddf36260dbdde35cef17be635022db05c0d37"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb3748dcf8d7305c9b13d751e7485eb42a11c41ad8510f032d1ad5cdbc683ecd05d"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:TestResult"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">The consolidated evidence record documenting one completed TestExecution.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">TestResult</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceArtifact"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb30ae8f103d4f1d2a5094df1248d72463b724851da663b681c7c1a913c1bae599b"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:TestScenario"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A ScenarioSpecification describing a situation to verify specified behavior or conditions. It can be detailed enough to also be a TestCase; its described situation is not a completed TestExecution.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">TestScenario</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ScenarioSpecification"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:TestSuiteSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A governed test-organization specification containing references to test cases.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">TestSuiteSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:TouchpointSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A design artifact specifying a point of contact, its channel, purpose and interaction context.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">TouchpointSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:UIStateSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A scoped specification of a screen condition and its expected presentation or interaction.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">UIStateSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:UsabilityFindingRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A FindingRecord whose constitutive subject matter includes a user-flow or screen specification.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">UsabilityFindingRecord</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:FindingRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:UserFlowSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored sequence model of user actions, decisions and transitions.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">UserFlowSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:UserRoleSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A designed specification of a user participation context, responsibilities and permissions.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">UserRoleSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:UserStorySpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored user-centered narrative specifying a desired interaction goal and expected value.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">UserStorySpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ValidationEvidenceRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An evidence-attribution record whose constitutive assessment purpose is validation.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ValidationEvidenceRecord</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceAttributionRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:ValidationFindingRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A FindingRecord whose constitutive subject matter includes a requirement specification.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ValidationFindingRecord</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:FindingRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:VerificationEvidenceRecord"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An evidence-attribution record whose constitutive assessment purpose is verification.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">VerificationEvidenceRecord</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:EvidenceAttributionRecord"></n1:subClassOf></n0:Description><n0:Description n0:about="urn:productium:specification-profile:VerticalSliceSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored end-to-end increment specification connecting intended value to coherent behavior and acceptance conditions.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">VerticalSliceSpecification</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:VisionStatement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An authored statement articulating intended product direction, experience and value.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">VisionStatement</n1:label></n0:Description><n0:Description n0:about="urn:productium:specification-profile:assessesProblem"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProblemSolutionFitAssessment"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProblemStatement"></n1:range></n0:Description><n0:Description n0:about="urn:productium:specification-profile:assessesProduct"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProductMarketFitAssessment"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:Product"></n1:range></n0:Description><n0:Description n0:about="urn:productium:specification-profile:assessesSolution"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProblemSolutionFitAssessment"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:SolutionSpecification"></n1:range></n0:Description><n0:Description n0:about="urn:productium:specification-profile:assessesSpecification"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">At least one intended ability contract for the same tested version.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:TestExecution"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:CapabilitySpecification"></n1:range></n0:Description><n0:Description n0:about="urn:productium:specification-profile:bearsCapability"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Each actual disposition has exactly one realization bearer throughout its existence. The 1..* capability bound is a local profile restriction to capability-bearing configured systems, not a universal claim about every broken installation.</n1:comment><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProductRealization"></n1:domain><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ProductCapability"></n1:range></n0:Description><n0:Description n0:about="urn:productium:specification-profile:canonicalOwner"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="urn:productium:specification-profile:ExternalReferenceRecord"></n1:domain></n0:Description><n0:Description n0:about="urn:productium:specification-profile:concernsRequirement"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:domain xmlns