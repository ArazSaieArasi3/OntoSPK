    <owl:Class rdf:about="urn:productium:specification-profile:AdoptionHypothesisSpecification">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:HypothesisSpecification"/>
        <rdfs:comment>A hypothesis specification whose constitutive claim concerns adoption barriers or adoption behavior.</rdfs:comment>
        <rdfs:label>AdoptionHypothesisSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:AssessmentClaim -->


    <owl:Class rdf:about="urn:productium:specification-profile:AssessmentClaim">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:product-ontology:assessment-profile:0.4:claimContext"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:product-ontology:assessment-profile:0.4:claimCriterion"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:product-ontology:assessment-profile:0.4:claimSubject"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="urn:productium:specification-profile:EvidenceArtifact"/>
        <rdfs:comment>An authored assessment-claim artifact fixing subject, criterion, scope and the proposition under consideration.</rdfs:comment>
        <rdfs:label>AssessmentClaim</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:BundleSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:BundleSpecification">
        <rdfs:comment>A governed composition specification referencing offerings intended to be presented together.</rdfs:comment>
        <rdfs:label>BundleSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:BusinessRuleReference -->


    <owl:Class rdf:about="urn:productium:specification-profile:BusinessRuleReference">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:ExternalReferenceRecord"/>
        <rdfs:comment>A local reference artifact to an externally governed business rule. Its business-rule purpose is constitutive to the authored reference record, not a temporary role of the target.</rdfs:comment>
        <rdfs:label>BusinessRuleReference</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:CapabilitySpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:CapabilitySpecification">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="urn:productium:specification-profile:assessesSpecification"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="urn:productium:specification-profile:evaluatedAgainst"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="urn:productium:specification-profile:specifiesCapability"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A version-scoped specification of an intended ability, irrespective of its implementation.</rdfs:comment>
        <rdfs:label>CapabilitySpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ChangeProposalSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:ChangeProposalSpecification">
        <rdfs:comment>An authored proposal specifying a desired change and its intended target.</rdfs:comment>
        <rdfs:label>ChangeProposalSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ChangeRecord -->


    <owl:Class rdf:about="urn:productium:specification-profile:ChangeRecord">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:EvidenceArtifact"/>
        <rdfs:comment>A dated record describing an asserted modification to an identified product artifact or state.</rdfs:comment>
        <rdfs:label>ChangeRecord</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:CommitmentLevelDefinition -->


    <owl:Class rdf:about="urn:productium:specification-profile:CommitmentLevelDefinition">
        <rdfs:comment>A governed term definition for a planning-commitment label within a named scheme.</rdfs:comment>
        <rdfs:label>CommitmentLevelDefinition</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:CompetitiveNarrative -->


    <owl:Class rdf:about="urn:productium:specification-profile:CompetitiveNarrative">
        <rdfs:comment>An authored narrative presenting scoped differentiation claims and their evidential references.</rdfs:comment>
        <rdfs:label>CompetitiveNarrative</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ConditionSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:ConditionSpecification">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:conditionContext"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:specificationProvenance"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:conditionStatement"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An authored semantic condition unit with a fixed proposition, applicability context and authoring provenance; distinct from a stakeholder intention, observed result or containing scenario.</rdfs:comment>
        <rdfs:label>ConditionSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ConfidenceAssessment -->


    <owl:Class rdf:about="urn:productium:specification-profile:ConfidenceAssessment">
        <rdfs:comment>A dated assessment of planning confidence with explicit subject, assessor, evidence context and scale.</rdfs:comment>
        <rdfs:label>ConfidenceAssessment</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ConstraintSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:ConstraintSpecification">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:ConditionSpecification"/>
        <rdfs:comment>An authored ConditionSpecification whose constitutive content includes restriction constitutive to the authored specification. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence.</rdfs:comment>
        <rdfs:label>ConstraintSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:DecisionCriterionSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:DecisionCriterionSpecification">
        <rdfs:comment>An authored rule or criterion specification used to appraise product alternatives.</rdfs:comment>
        <rdfs:label>DecisionCriterionSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:DecisionRecord -->


    <owl:Class rdf:about="urn:productium:specification-profile:DecisionRecord">
        <rdfs:comment>An immutable record of a product decision, its considered alternatives, rationale and provenance.</rdfs:comment>
        <rdfs:label>DecisionRecord</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:DeliveryStatusRecord -->


    <owl:Class rdf:about="urn:productium:specification-profile:DeliveryStatusRecord">
        <rdfs:comment>An immutable dated report assigning a delivery-status value to one Release.</rdfs:comment>
        <rdfs:label>DeliveryStatusRecord</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:DeliveryWorkItem -->


    <owl:Class rdf:about="urn:productium:specification-profile:DeliveryWorkItem">
        <rdfs:comment>A governed work-item artifact about intended delivery scope and its referenced functional specifications.</rdfs:comment>
        <rdfs:label>DeliveryWorkItem</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:DependencySpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:DependencySpecification">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:product-ontology:trace-profile:0.6:dependencyCondition"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An authored claim that one product depends on an identified product, capability or resource under a stated dependency condition.</rdfs:comment>
        <rdfs:label>DependencySpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:EnablerSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:EnablerSpecification">
        <rdfs:comment>An authored supporting-work specification intended to enable a feature or capability specification.</rdfs:comment>
        <rdfs:label>EnablerSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:EvidenceArtifact -->


    <owl:Class rdf:about="urn:productium:specification-profile:EvidenceArtifact">
        <rdfs:comment>An abstract category of information artifacts eligible to carry evidence in this bounded profile.</rdfs:comment>
        <rdfs:label>EvidenceArtifact</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:EvidenceAttributionRecord -->


    <owl:Class rdf:about="urn:productium:specification-profile:EvidenceAttributionRecord">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:recordsCarrier"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="urn:productium:specification-profile:EvidenceArtifact"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:recordsClaim"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="urn:productium:specification-profile:AssessmentClaim"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An information record documenting an assessor&apos;s attribution of one carrier to one assessment claim.</rdfs:comment>
        <rdfs:label>EvidenceAttributionRecord</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ExternalReferenceRecord -->


    <owl:Class rdf:about="urn:productium:specification-profile:ExternalReferenceRecord">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:canonicalOwner"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:referenceProvenance"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:referenceTarget"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A local information record of a fixed binding to a separately governed referent, with recorded authority, provenance and constitutive purpose set.</rdfs:comment>
        <rdfs:label>ExternalReferenceRecord</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:FeatureFlagSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:FeatureFlagSpecification">
        <rdfs:comment>A specification of a named feature-activation control and its intended scoping policy.</rdfs:comment>
        <rdfs:label>FeatureFlagSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:FeatureSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:FeatureSpecification">
        <rdfs:comment>An authored functional-unit specification linking intended behavior, user value and acceptance criteria.</rdfs:comment>
        <rdfs:label>FeatureSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:FindingRecord -->


    <owl:Class rdf:about="urn:productium:specification-profile:FindingRecord">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:EvidenceArtifact"/>
        <rdfs:comment>An authored observation or issue record with a fixed finding statement, subject bindings and provenance.</rdfs:comment>
        <rdfs:label>FindingRecord</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:FunctionalRequirementSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:FunctionalRequirementSpecification">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:RequirementSpecification"/>
        <rdfs:comment>A requirement specification with an essential normative commitment about intended behavior or functionality.</rdfs:comment>
        <rdfs:label>FunctionalRequirementSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:GoToMarketSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:GoToMarketSpecification">
        <rdfs:comment>A governed strategy specification linking positioning, audiences and intended market-entry activity.</rdfs:comment>
        <rdfs:label>GoToMarketSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:GoalSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:GoalSpecification">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:ConditionSpecification"/>
        <rdfs:comment>An authored ConditionSpecification whose constitutive content includes desired product condition. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence.</rdfs:comment>
        <rdfs:label>GoalSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:HypothesisSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:HypothesisSpecification">
        <rdfs:comment>An authored testable-claim artifact fixing its claim, intended scope and refutation or support conditions.</rdfs:comment>
        <rdfs:label>HypothesisSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:InformationArchitectureSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:InformationArchitectureSpecification">
        <rdfs:comment>An authored model of information organization, hierarchy and navigation.</rdfs:comment>
        <rdfs:label>InformationArchitectureSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:InitiativeSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:InitiativeSpecification">
        <rdfs:comment>An authored plan coordinating goals, scope and expected product outcomes.</rdfs:comment>
        <rdfs:label>InitiativeSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:InteractionStepSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:InteractionStepSpecification">
        <rdfs:comment>A scoped action or decision-step specification in one user-flow design.</rdfs:comment>
        <rdfs:label>InteractionStepSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:JourneySpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:JourneySpecification">
        <rdfs:comment>An authored structured experience model containing scoped stage specifications.</rdfs:comment>
        <rdfs:label>JourneySpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:JourneyStageSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:JourneyStageSpecification">
        <rdfs:comment>An authored constituent stage specification owned by exactly one JourneySpecification.</rdfs:comment>
        <rdfs:label>JourneyStageSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:LaunchSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:LaunchSpecification">
        <rdfs:comment>A plan specification for introducing a product or change to an intended audience.</rdfs:comment>
        <rdfs:label>LaunchSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:LifecycleSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:LifecycleSpecification">
        <rdfs:comment>An authored scheme describing lifecycle-stage meanings applicable to products.</rdfs:comment>
        <rdfs:label>LifecycleSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:LifecycleStageSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:LifecycleStageSpecification">
        <rdfs:comment>A scoped definition of a lifecycle stage within one lifecycle specification.</rdfs:comment>
        <rdfs:label>LifecycleStageSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:MarketingGoalSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:MarketingGoalSpecification">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:GoalSpecification"/>
        <rdfs:comment>A goal specification whose constitutive desired result concerns product marketing or market introduction.</rdfs:comment>
        <rdfs:label>MarketingGoalSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:MarketingInsightReference -->


    <owl:Class rdf:about="urn:productium:specification-profile:MarketingInsightReference">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:ExternalReferenceRecord"/>
        <rdfs:comment>A governed local reference artifact with one canonical target and an explicitly supplied owner identifier. Its marketing-insight purpose is constitutive to the authored reference record, not a temporary role of the target.</rdfs:comment>
        <rdfs:label>MarketingInsightReference</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:MessagingSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:MessagingSpecification">
        <rdfs:comment>An authored specification of audience-directed messages and supporting claims.</rdfs:comment>
        <rdfs:label>MessagingSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:MilestoneSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:MilestoneSpecification">
        <rdfs:comment>An authored target-condition specification marking intended planning progress.</rdfs:comment>
        <rdfs:label>MilestoneSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:OfferingSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:OfferingSpecification">
        <rdfs:comment>A catalog specification of how one product is intended to be offered to an audience under stated terms.</rdfs:comment>
        <rdfs:label>OfferingSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:OpportunityStatement -->


    <owl:Class rdf:about="urn:productium:specification-profile:OpportunityStatement">
        <rdfs:comment>A governed statement artifact identifying a possible value improvement in context.</rdfs:comment>
        <rdfs:label>OpportunityStatement</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:OutcomeSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:OutcomeSpecification">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:ConditionSpecification"/>
        <rdfs:comment>An authored ConditionSpecification whose constitutive content includes expected measurable product condition. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence.</rdfs:comment>
        <rdfs:label>OutcomeSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:PersonaSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:PersonaSpecification">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:personaContext"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:specificationProvenance"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:personaDescription"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An authored model of a user archetype, fixing a behavioral profile, population/use context and research provenance; not a person, group of actual users or their temporary role.</rdfs:comment>
        <rdfs:label>PersonaSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:PlanningHorizonDefinition -->


    <owl:Class rdf:about="urn:productium:specification-profile:PlanningHorizonDefinition">
        <rdfs:comment>A governed term definition specifying the meaning of a planning-horizon label in a named scheme.</rdfs:comment>
        <rdfs:label>PlanningHorizonDefinition</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:PortfolioEntry -->


    <owl:Class rdf:about="urn:productium:specification-profile:PortfolioEntry">
        <rdfs:comment>A governed entry in one portfolio, optionally referencing a product while a broader target binding is being specified.</rdfs:comment>
        <rdfs:label>PortfolioEntry</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:PositioningStatement -->


    <owl:Class rdf:about="urn:productium:specification-profile:PositioningStatement">
        <rdfs:comment>An authored statement specifying intended product perception for a target audience relative to alternatives.</rdfs:comment>
        <rdfs:label>PositioningStatement</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:PrioritizationCriterionSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:PrioritizationCriterionSpecification">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:DecisionCriterionSpecification"/>
        <rdfs:comment>A decision-criterion specification whose constitutive purpose is to justify or compute a planning rank.</rdfs:comment>
        <rdfs:label>PrioritizationCriterionSpecification</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:PriorityAssessment -->


    <owl:Class rdf:about="urn:productium:specification-profile:PriorityAssessment">
        <rdfs:comment>A dated contextual ranking assessment recording a rank for a roadmap entry within a named comparison set and scale.</rdfs:comment>
        <rdfs:label>PriorityAssessment</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ProblemSolutionFitAssessment -->


    <owl:Class rdf:about="urn:productium:specification-profile:ProblemSolutionFitAssessment">
        <rdfs:comment>A dated assessment record about the proposed fit of a problem statement and a solution specification.</rdfs:comment>
        <rdfs:label>ProblemSolutionFitAssessment</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ProblemStatement -->


    <owl:Class rdf:about="urn:productium:specification-profile:ProblemStatement">
        <rdfs:comment>A governed statement artifact describing a candidate or evidenced problem.</rdfs:comment>
        <rdfs:label>ProblemStatement</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:Product -->


    <owl:Class rdf:about="urn:productium:specification-profile:Product">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:hasVersion"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A governed intentional product artifact with continuing constitutive purpose and stewardship lineage; not a deployment or a database row.</rdfs:comment>
        <rdfs:label>Product</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ProductCapability -->


    <owl:Class rdf:about="urn:productium:specification-profile:ProductCapability">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:evaluatedAgainst"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="urn:productium:specification-profile:bearsCapability"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An actual intrinsic disposition of one concrete ProductRealization as a configured functional whole. Intended behavior, successful execution, a specification and a machine label are not the disposition.</rdfs:comment>
        <rdfs:label>ProductCapability</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ProductFamilyReference -->


    <owl:Class rdf:about="urn:productium:specification-profile:ProductFamilyReference">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:ExternalReferenceRecord"/>
        <rdfs:comment>A local reference artifact identifying a product-family target governed by an external owner. Its product-family purpose is constitutive to the authored reference record, not a temporary role of the target.</rdfs:comment>
        <rdfs:label>ProductFamilyReference</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ProductLineReference -->


    <owl:Class rdf:about="urn:productium:specification-profile:ProductLineReference">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:ExternalReferenceRecord"/>
        <rdfs:comment>A local reference artifact identifying an externally governed product line. Its product-line purpose is constitutive to the authored reference record, not a temporary role of the target.</rdfs:comment>
        <rdfs:label>ProductLineReference</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ProductMarketFitAssessment -->


    <owl:Class rdf:about="urn:productium:specification-profile:ProductMarketFitAssessment">
        <rdfs:comment>A dated assessment record about a product in an explicitly identified market context.</rdfs:comment>
        <rdfs:label>ProductMarketFitAssessment</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ProductMetricReference -->


    <owl:Class rdf:about="urn:productium:specification-profile:ProductMetricReference">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:ExternalReferenceRecord"/>
        <rdfs:comment>A local reference artifact binding a product measurement context to an externally governed metric. Its product-metric purpose is constitutive to the authored reference record, not a temporary role of the target.</rdfs:comment>
        <rdfs:label>ProductMetricReference</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ProductPortfolio -->


    <owl:Class rdf:about="urn:productium:specification-profile:ProductPortfolio">
        <rdfs:comment>A governed strategic arrangement organizing products, entries and planning references under a continuing portfolio mandate.</rdfs:comment>
        <rdfs:label>ProductPortfolio</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ProductRealization -->


    <owl:Class rdf:about="urn:productium:specification-profile:ProductRealization">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:bearsCapability"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="urn:productium:specification-profile:testsRealization"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:realizesVersion"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A concrete, causally integrated computing-system artifact configured to enact one fixed product-version baseline. It is the deployed functional whole, not its record, hosting machine, execution event or deployment interval.</rdfs:comment>
        <rdfs:label>ProductRealization</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ProductStatusRecord -->


    <owl:Class rdf:about="urn:productium:specification-profile:ProductStatusRecord">
        <rdfs:comment>A dated contextual assertion assigning a status value to one product.</rdfs:comment>
        <rdfs:label>ProductStatusRecord</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ProductVariantReference -->


    <owl:Class rdf:about="urn:productium:specification-profile:ProductVariantReference">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:ExternalReferenceRecord"/>
        <rdfs:comment>A local reference artifact identifying an externally governed product variant. Its product-variant purpose is constitutive to the authored reference record, not a temporary role of the target.</rdfs:comment>
        <rdfs:label>ProductVariantReference</rdfs:label>
    </owl:Class>
    


    <!-- urn:productium:specification-profile:ProductVersion -->


    <owl:Class rdf:about="urn:productium:specification-profile:ProductVersion">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="urn:productium:specification-profile:specifiesCapability"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
