        <rdfs:range rdf:resource="urn:productium:specification-profile:OutcomeSpecification"/>
    </owl:ObjectProperty>
    


    <!-- urn:productium:specification-profile:targetsOutcomeSpecification -->


    <owl:ObjectProperty rdf:about="urn:productium:specification-profile:targetsOutcomeSpecification">
