    <!-- urn:productium:specification-profile:AcceptanceCriterionSpecification -->


    <owl:Class rdf:about="urn:productium:specification-profile:AcceptanceCriterionSpecification">
        <rdfs:subClassOf rdf:resource="urn:productium:specification-profile:ConditionSpecification"/>
        <rdfs:comment>An authored ConditionSpecification whose constitutive content includes condition used in the authored acceptance contract. The facet belongs to this specification baseline, not to a temporary use of its file or an actual occurrence.</rdfs:comment>
        <rdfs:label>AcceptanceCriterionSpecification</rdfs:label>
    </owl:Class>
    


